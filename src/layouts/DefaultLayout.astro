---
import '@fontsource-variable/bricolage-grotesque'
import '@fontsource/dm-mono/400.css'
import '@fontsource/dm-mono/500.css'
import '../styles/tailwind.css'
import '../assets/scss/index.scss'
import SiteMeta from '@components/SiteMeta.astro'
import Header from '@components/Header.astro'
import Footer from '@components/Footer.astro'
import LoadingScreen from '@components/LoadingScreen.astro'
import Atmosphere from '@components/Atmosphere.astro'
import { ClientRouter } from 'astro:transitions'

const {
  title = 'Bishal Upadhyaya — AI Systems Architect',
  description = 'AI systems, end-to-end: peer-reviewed research on one side, shipped products on the other. Cofounder of Vibeset — AI music tooling with live demos right on this page.',
  url = Astro.site,
  image = 'social-preview-image.png',
  author = 'Bishal Upadhyaya',
  /**
   * Full-viewport app pages (/naam). Three things only this can do, which is why
   * it is a prop and not a `body:has()` selector in page CSS:
   *
   *   1. `interactive-widget=resizes-content` in the viewport meta. Android
   *      Chrome then shrinks the LAYOUT viewport for the soft keyboard, so a
   *      100svh pane fits above it with no JS. iOS ignores the key, so it costs
   *      nothing there — but a selector cannot reach <meta> at all.
   *   2. Skip LoadingScreen. It is fixed at z-index 9999 for ~1.4s on a cold
   *      session, which on an app page delays interaction and makes the overlay
   *      the LCP element.
   *   3. Mark the body so the page's own CSS can put the header in flow.
   *
   * Everything else stays identical — same header, same footer, same meta.
   */
  appShell = false,
} = Astro.props
---

<html lang="en" dir="ltr" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content={appShell
        ? 'width=device-width, initial-scale=1.0, interactive-widget=resizes-content'
        : 'width=device-width, initial-scale=1.0'}
    />
    <meta http-equiv="X-UA-Compatible" content="ie=edge" />

    <!--
      Theme, resolved before first paint.

      Inline and synchronous on purpose: anything deferred paints the default
      ground first and then repaints, which is the flash this exists to
      prevent. It is three lines because it only ever writes one value —
      `:root` is dark, so "dark" is the absence of the attribute rather than a
      second state to store. A reader who has never touched the toggle, or who
      has JavaScript off entirely, gets dark.

      The OS preference is deliberately not consulted. Dark is this site's
      design, not its fallback, and a light-mode OS should not silently
      reinterpret it — the toggle is how a reader says otherwise.
    -->
    <script is:inline>
      try {
        if (localStorage.getItem('theme') === 'light') document.documentElement.dataset.theme = 'light'
      } catch (e) {
        /* private mode — dark, which is the default anyway */
      }
    </script>

    <!-- favicon — raster set rather than an SVG. The mark is flat vector art
         but its counter is not a circle any primitive reproduces, so hand-
         tracing it would have drifted from the artwork. Browsers pick the
         nearest size; 512 covers PWA installs and 180 covers iOS, which masks
         its own corners. -->
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <SiteMeta title={title} description={description.substring(0, 160)} url={url} image={image} author={author} />

    <script>
      import '../scripts/reveal.ts'
    </script>

    <!-- Apollo.io website visitor tracker — identifies visiting companies
         (global) and people (U.S. only). is:inline keeps Astro from bundling
         the third-party snippet, so it runs verbatim as Apollo ships it.

         Production only: on localhost and deploy previews the pixel 400s on
         every page load, which buries real errors in the console check. -->
    <script is:inline>
      function initApollo() {
        var n = Math.random().toString(36).substring(7),
          o = document.createElement('script')
        ;((o.src = 'https://assets.apollo.io/micro/website-tracker/tracker.iife.js?nocache=' + n),
          (o.async = !0),
          (o.defer = !0),
          (o.onload = function () {
            window.trackingFunctions.onLoad({ appId: '69bca29b8b1c61001d8bd4c8' })
          }),
          document.head.appendChild(o))
      }
      if (location.hostname === 'bishal.ai') initApollo()
    </script>

    <!-- Pages that need one extra tag in <head> — a font preload, a page-
         specific link — put it here. Nothing else in the layout changes. -->
    <slot name="head" />

    <!-- Enable Astro View Transitions for all browsers -->
    <ClientRouter />
  </head>
  <body data-app={appShell ? '' : undefined}>
    <!-- Synchronous and first, so the app-shell CSS (all scoped under
         html:not(.no-js)) applies on the very first frame. reveal.ts also drops
         this class, but Astro emits it as a deferred module — late enough that
         an app page would paint as a long document and then snap, which is CLS.
         The removal there becomes a harmless no-op. -->
    <script is:inline>
      document.documentElement.classList.remove('no-js')
    </script>
    {!appShell && <LoadingScreen />}
    <Atmosphere />
    <Header />
    <main id="main-content" transition:animate="fade">
      <slot />
    </main>
    <Footer />
    <style lang="scss" is:global>
      @use '../assets/scss/base/mixins' as *;

      // sticky footer on low content pages
      html,
      body {
        height: 100%;
        scroll-behavior: smooth;
      }

      body {
        display: flex;
        flex-direction: column;
        overflow-x: clip;
        overflow-y: auto;

        main {
          flex: 1 0 auto;
        }

        footer {
          flex-shrink: 0;
        }
      }

      pre {
        border: 2px solid var(--link-color);
        border-radius: 0.35rem;
        padding: 1rem;
      }

      .card {
        a {
          @include text-decoration(transparent, var(--foreground-color), 4px, 2px);
        }
      }
    </style>
  </body>
</html>
