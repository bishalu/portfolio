  /* "Six taps. Runs in your browser, sends nothing." — two sentences. They were
     .label-mono, so they read as SIX TAPS. RUNS IN YOUR BROWSER, SENDS NOTHING.
     §3 gives mono to labels and metadata; a helper is neither. */
  .nm-door-help {
    color: var(--paper-soft);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .nm-quiet-link {
    color: var(--crimson-text);
    font-size: 0.92rem;
  }

  /* ── Sections ───────────────────────────────────────────────────────── */
  .nm-section {
    margin-top: var(--space-3xl);
  }

  /* The ask and the first question are one unit, not two sections. --space-3xl
     is the site's between-sections rhythm (DESIGN.md §2, and it must not
     shrink) — but this gap is not between sections, it is between a question
     and its own controls. At 3xl it read as 120px of nothing directly under
     the only call to action on the page. */
  .nm-head + .nm-section {
    margin-top: var(--space-xl);
  }

  .nm-h2 {
    margin: 0 0 var(--space-m);
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    line-height: 1.02;
    letter-spacing: -0.015em;
  }

  .nm-note {
    margin: var(--space-s) 0 0;
    color: var(--paper-soft);
    font-size: 0.98rem;
