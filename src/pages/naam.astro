---
/**
 * /naam — a family asking for help naming their son, as an app.
 * Spec: docs/design/DESIGN.md (Alpenglow) · docs/design/MOTION.md.
 *
 * WHY THIS PAGE IS A SHELL AND NOT A DOCUMENT. It used to be a long editorial
 * page: hero, wizard, shortlist, a 2,098-row browser, a form, a wall. It
 * worked and it passed every gate, but it was a document *about* naming rather
 * than an instrument *for* naming. This is one screen — rail, stream, three
 * slots, composer — and the page's only job now is to hand the viewport to
 * NaamApp.tsx and get out of the way.
 *
 * WHY IT IS LIGHT. DESIGN.md P1 reads "one world, three depths, zero themes".
 * This page breaks it deliberately and the exception is scoped so tightly it
 * cannot leak: every light token is declared on #naam-app, never on :root, so
 * no other route can inherit one and the site keeps `color-scheme: dark`. The
 * ACCENTS DO NOT CHANGE — crimson and marigold carry over from the dark site
 * untouched, only the ground flips. Same family, different room. Contrast was
 * recomputed from scratch against the light ground rather than inherited; see
 * the token block below, which records the ratio for every pairing that
 * carries text.
 *
 * WHY THE SHELL RULES ARE ALL UNDER html:not(.no-js). With JavaScript off the
 * app is display:none and this is an ordinary scrolling document again — the
 * .nm-fallback below, which is server-rendered into the NORMAL DOM rather than
 * into a <noscript>. Two reasons that matters: axe and Lighthouse both run
 * with JavaScript enabled and would never see a <noscript>, so it would ship
 * behind a gate that structurally cannot check it; and the app-shell CSS still
 * applies with JS off, which would lay the fallback out inside a clipped
 * 100svh box and leave it unreachable.
 *
 * WHY prerender STAYS TRUE: the readFileSync below only works at build time.
 * Under SSR it throws on Netlify.
 *
 * WHY THE STYLES ARE HERE AND is:global: island CSS cannot live in
 * _widgets.scss, which is inside the global bundle every route pays for; a
 * page style block is chunked per page in Astro 5. is:global is required
 * because Astro's scoping never reaches React-rendered DOM. Every class is
 * .nm-* so it cannot collide with anything.
 *
 * The PDF is untracked and this repo is public, so page numbers are cited as
 * text and the document itself is not served.
 */
import { readFileSync } from 'node:fs'
import { resolve } from 'node:path'
import DefaultLayout from '@layouts/DefaultLayout.astro'
import NaamApp from '@components/NaamApp.tsx'
import NaamCard from '@components/NaamCard.tsx'
import { NAAM_COPY, NAAM_RELATIONS } from '@/lib/naam/copy'
import { NAAM_SEED_DOCUMENTED } from '@/lib/naam/seeds'
import { NAAM_FEATURED, NAAM_PROVENANCE } from '@/generated/naam-facts'
import { isNaamGold, type NaamLetter, type NaamRow } from '@/types/naam'

export const prerender = true

const C = NAAM_COPY

/**
 * Read at build time, not imported: a 1.1 MB JSON import would hand tsc a
 * 2,097-element literal to infer and drag the whole dataset into the server
 * bundle. This runs at prerender time only, off the project root — resolving
 * against import.meta.url would land in the adapter's build directory. The
 * browser fetches the same file on mount (src/lib/naam/tray.ts).
 */
const rows = JSON.parse(readFileSync(resolve(process.cwd(), 'public/naam/names-core.json'), 'utf8')) as NaamRow[]
const byId = new Map(rows.map((row) => [row.id, row]))

/**
 * The no-JS shortlist. FOUR per letter, not twelve: this is the fallback, not
 * the page, and the app's TBT budget is 200ms — every card here is DOM that
 * the app's own visitors download, parse and then never see.
 */
const PER_LETTER = 4
const LETTERS: NaamLetter[] = ['B', 'S', 'V']

const fallbackRows = LETTERS.flatMap((letter) => {
  const featured = NAAM_FEATURED.map((id) => byId.get(id)).filter(
    (row): row is NaamRow => row !== undefined && row.letter === letter,
  )
  const taken = new Set(featured.map((row) => row.id))
  const gold = rows.filter(
    (row) => row.letter === letter && isNaamGold(row) && !row.badges.hardCluster && !taken.has(row.id),
  )
  return [...featured, ...gold].slice(0, PER_LETTER)
})

/**
 * Byan is a real row — Vyan / Byan, p.120 — so the family strip can render it
 * with its own Devanagari and its working व/ब spelling. It is also the seed
 * that silently vanished once: the document files it under "More", this page
 * reads only names-core.json, and `byId.get('vyan')` returned undefined with
 * no error and no gap in the layout. scripts/naam/build-dataset.mjs now forces
 * it into core (CORE_EXTRA_IDS); this throws rather than shrugging if that
 * ever stops being true.
 */
const seedRow = byId.get(NAAM_SEED_DOCUMENTED.id)
if (!seedRow) {
  throw new Error(
    `/naam: the documented seed '${NAAM_SEED_DOCUMENTED.id}' is not in public/naam/names-core.json. ` +
      'Add it to CORE_EXTRA_IDS in scripts/naam/build-dataset.mjs and re-run `npm run naam:build`.',
  )
}
---

<DefaultLayout title={C.meta.title} description={C.meta.description} appShell>
  <!-- noindex: this page exists for people who are sent the link. Search
       discovery adds nothing to that job, and the page carries a child's
       candidate names plus a public wall of what visitors typed. `follow` stays
       on so the links back into the site still count. Remove this line and the
       /naam clause in astro.config.mjs's sitemap filter to list it again. -->
  <meta slot="head" name="robots" content="noindex, follow" />
  <link slot="head" rel="preload" href="/fonts/Mukta-Devanagari-400.woff2" as="font" type="font/woff2" crossorigin />
  <!-- No preload for names-core.json, deliberately. `as="fetch"` preloads in
       CORS mode, but tray.ts fetches same-origin with default credentials, so
       the two never match: Chrome downloaded the file twice and logged
       "preload ... not used because the request credentials mode does not
       match" plus an unused-preload warning — two console problems against a
       zero-console gate, in exchange for a slower load. Matching them would
       mean crossorigin here AND credentials:'omit' there, which is a lot of
       coupling for one hop. The interactivity fix that actually mattered was
       moving the fetch off onIdle() and into the mount effect; that stands. -->

  <div id="naam-app" class="nm nm-app">
    <NaamApp seed={seedRow} client:load />
  </div>

  <!-- The no-JS half, in the normal DOM. Field names match
       public/__forms.html byte-for-byte or Netlify discards the submission
       silently, and every label wraps its control rather than pairing by id —
       so nothing here can collide with the app's own nma-* ids. -->
  <div class="nm nm-fallback">
    <div class="nm-fallback-inner">
      <h1 class="nm-fallback-title">{C.hero.headline}</h1>
      <p class="nm-fallback-standfirst">{C.hero.standfirst}</p>
      <p class="nm-fallback-standfirst">{C.noscript}</p>
      <p class="nm-fallback-letters">{C.hero.letters}</p>

      <h2 class="nm-fallback-h2">{C.shortlist.heading}</h2>
      <div class="nm-grid">
        {fallbackRows.map((row) => <NaamCard row={row} preferB={true} />)}
      </div>

      <h2 class="nm-fallback-h2">{C.form.heading}</h2>
      <p class="nm-fallback-standfirst">{C.form.standfirst}</p>

      <form
        class="nm-form"
        name="naam-suggestion"
        method="POST"
        action="/thank-you"
        data-netlify="true"
        netlify-honeypot="bot-field"
      >
        <input type="hidden" name="form-name" value="naam-suggestion" />
        <p hidden>
          <label>bot-field<input name="bot-field" tabindex="-1" autocomplete="off" /></label>
        </p>

        <label class="nm-field">
          <span class="label-mono">{C.form.name.label}</span>
          <input type="text" name="from" required maxlength={C.limits.name} autocomplete="name" />
        </label>

        <label class="nm-field">
          <span class="label-mono">{C.form.relation.label}</span>
          <select name="relation" required>
            <option value="">{C.form.relation.placeholder}</option>
            {NAAM_RELATIONS.map((relation) => <option value={relation}>{relation}</option>)}
          </select>
        </label>

        <label class="nm-field">
          <span class="label-mono">{C.form.names.label}</span>
          <input
            type="text"
            name="names"
            maxlength={C.limits.names}
            autocomplete="off"
            placeholder={C.form.names.placeholder}
          />
        </label>
        <p class="nm-fallback-help">{C.form.names.helper}</p>

        <label class="nm-field">
          <span class="label-mono">{C.form.reason.label}</span>
          <textarea name="reason" rows="3" maxlength={C.limits.reason}></textarea>
        </label>

        <!-- The tray is a JavaScript thing, so with JS off this is empty and
             the free-text field above is what carries a name. It is registered
             in public/__forms.html and must be posted either way. -->
        <input type="hidden" name="picks" value="[]" />

        <button type="submit" class="btn-pill nm-fallback-send">{C.form.submit}</button>
      </form>

      <p class="nm-fallback-provenance">{NAAM_PROVENANCE}</p>
      <p class="label-mono label-mono--sm nm-fallback-provenance">{C.card.devanagariNote}</p>
      <p class="nm-fallback-provenance">{C.hero.nwaran}</p>
    </div>
  </div>
</DefaultLayout>

<style lang="scss" is:global>
  /* ═══════════════════════════════════════════════════════════════════════
     /naam — page-scoped, is:global because Astro's scoping does not reach
     React-rendered DOM. Every class is .nm-* .
     Tokens: docs/design/DESIGN.md §1 (P1, P3), src/styles/tokens.css.
     ═══════════════════════════════════════════════════════════════════════ */

  /* One new script, not one new role (DESIGN.md P5). Mukta covers Devanagari
     and nothing else, so Bricolage and Atkinson keep every Latin role they
     already have. font-display: optional, never swap — swap is a CLS
     generator and the CLS floor is 0. U+200C-200D must stay in the range or
     conjuncts and half-forms stop rendering. */
  @font-face {
    font-style: normal;
    font-weight: 400;
    src: url('/fonts/Mukta-Devanagari-400.woff2') format('woff2');
    font-family: 'Mukta';
    font-display: optional;
    unicode-range: U+0900-097F, U+200C-200D, U+20A8, U+25CC, U+A830-A839;
  }

  /* The system fallback, restricted to the same range by the same mechanism.
     A bare 'Noto Sans Devanagari' in the stack would also serve Latin, and
     would beat Atkinson to it — this way both Devanagari faces can only ever
     answer for Devanagari. */
  @font-face {
    font-style: normal;
    font-weight: 400;
    src: local('Noto Sans Devanagari'), local('Nirmala UI'), local('Mangal'), local('Kohinoor Devanagari');
    font-family: 'Naam Deva Fallback';
    font-display: optional;
    unicode-range: U+0900-097F, U+200C-200D;
  }

  /* ── The shell, and the one blocker it exists to defeat ───────────────
     tailwind.css sets `body { min-height: 100vh }`. 100vh is the LARGE
     viewport, so on iOS Safari with the URL bar showing the body is 60–110px
     taller than what is visible and the document scrolls by exactly the
     chrome height — even with every child at 100svh and the footer gone.
     `min-height: 0` is what kills it.

     100svh, never dvh: dvh tracks a viewport that on this page never changes,
     so it can only ever introduce jumps. --kb-inset is written by NaamApp
     from visualViewport, because iOS does not resize the layout viewport for
     the soft keyboard (Android does, via interactive-widget=resizes-content
     in the layout's viewport meta).

     Every rule is scoped under html:not(.no-js): with JavaScript off this is
     an ordinary document again. ─────────────────────────────────────────── */
  html:not(.no-js) body[data-app] {
    height: calc(100svh - var(--kb-inset, 0px));
    min-height: 0;
    overflow: clip;
    overscroll-behavior: none;
  }

  /* min-height: 0 is the one everyone forgets: a column flex item's
     min-height is `auto`, which floors it at content height and makes
     flex-shrink silently do nothing. */
  html:not(.no-js) body[data-app] > main {
    flex: 1 1 0;
    min-height: 0;
    overflow: clip;
  }

  html:not(.no-js) body[data-app] > footer {
    display: none;
  }

  /* Do not subtract the header — put it in flow. No token, no calc(), no
     ResizeObserver, and the mobile-nav-open case then solves itself: the menu
     grows the header, main shrinks, the app reflows instead of being
     overlapped. */
  html:not(.no-js) body[data-app] #site-header {
    position: sticky;
    flex: 0 0 auto;
  }

  /* #naam-app, not .nm-app. The light tokens and the flex column are declared
     on the ID (1,0,0), so `html.no-js .nm-app` (0,2,1) lost the cascade and a
     visitor with JavaScript off got the dead app stacked on top of the working
     fallback. Matching the ID here makes it (1,1,1) and it wins. */
  html.no-js #naam-app {
    display: none;
  }

  html:not(.no-js) .nm-fallback {
    display: none;
  }

  /* ── Roles, and the ground under them ─────────────────────────────────
     .nm is both surfaces' root because --font-deva is declared here and
     consumed in a dozen places; rename it and every Devanagari glyph silently
     becomes tofu. The --nm-* roles resolve to the site's dark tokens by
     default, which is what the no-JS fallback is rendered on, and are
     REDECLARED on #naam-app for the light app. One card component, one set of
     rules, two grounds. ──────────────────────────────────────────────────── */
  .nm {
    /* Both members are unicode-range-restricted, so this prefix can be put in
       front of any role stack without touching a single Latin glyph. */
    --font-deva: 'Mukta', 'Naam Deva Fallback';
    --nm-canvas: var(--void);
    --nm-surface: var(--ink);
    --nm-surface-2: var(--ink-2);
    --nm-text: var(--paper);
    --nm-text-soft: var(--paper-soft);
    --nm-hair: var(--hairline-on-ink);
    --nm-hair-strong: var(--hairline-strong);
    --nm-accent-text: var(--crimson-text);
    --nm-keep: var(--marigold);
    /* Mixed from the token rather than restated as a literal: the fill and the
       mark have to be the same hue, and they stopped being so the moment
       --marigold was re-chosen for a light ground. 14% of the old marigold on
       bone was also invisible. */
    --nm-keep-fill: color-mix(in srgb, var(--marigold) 18%, transparent);
    --nm-live: var(--glacier);
    /* THE BASE OF THE FLAME, declared here beside the wall's paper and for the
       same reason: fire is not a different colour in a different room, so
       #naam-app does not override it. Mixed rather than picked — the page owns
       exactly two warm tokens and an ember is where they meet.

       It replaces `var(--nm-accent)`, which NaamDiyo's gradient read and which
       is declared nowhere on this site; only --nm-accent-text exists. An
       unresolvable var() in stop-color is invalid at computed-value time, so it
       fell back to that property's initial value — BLACK — and the flame burned
       from a black base. At 62px that reads as shadow around the wick, which is
       precisely why it survived a review that was looking at the lamp. */
    --nm-ember: color-mix(in srgb, var(--crimson) 55%, var(--marigold) 45%);

    /* THE CONVERSATION'S OWN SURFACE. The page is one room with a lamp at the
       right-hand end of it, so the left is the side of the room the light has
       not reached: a shade cooler and a shade lighter than the canvas, enough
       to read as a different place to stand without a line drawn to say so.
       It is a mix rather than a literal so it stays correct on both grounds —
       the dark one resolves cool-dark, the light one resolves cool-pale, and
       neither needs a second declaration. */
    --nm-talk: color-mix(in srgb, var(--nm-surface) 62%, var(--nm-canvas));

    /* THE LEAF, and it is declared on .nm rather than on #naam-app on purpose:
       a palm leaf is a physical thing and it does not change colour because the
       room it is in is dark. These three are the only colours on this page that
       do not resolve differently between the two grounds.

       Palm ochre, not post-it yellow. #e3d3a8 is aged palm; the ink is #33291c,
       an iron-gall brown, never black; the margin rule is the red ochre that
       actually runs down a pothi page. Contrast, measured on the leaf itself:
         #33291c on #e3d3a8   9.4:1   the Devanagari and the Latin
         at 60% opacity       4.9:1   the least-supported name, still AA
       So even a name nobody has chosen yet stays properly readable — which
       matters more here than anywhere, because ink weight is how this shelf
       shows support and the lightest leaf is the one asking to be noticed. */
    --nm-leaf: #e3d3a8;
    --nm-leaf-ink: #33291c;
    --nm-leaf-rule: #a8442e;

    /* Mukta is FIRST in every stack on this page and that is safe: its
       @font-face carries a unicode-range, so it can only ever supply
       Devanagari and every Latin glyph falls straight through to Bricolage,
       Atkinson or DM Mono. Without this, any Devanagari outside .nm-deva —
       a starter chip, the व/ब control, a name inside a reason — renders as
       tofu, and shipping boxes is worse than shipping no Devanagari at all. */
    font-family: var(--font-deva), var(--font-body);
  }

  .nm h1,
  .nm h2,
  .nm h3 {
    font-family: var(--font-deva), var(--font-display);
  }

  .nm .label-mono,
  .nm .pulse-caption {
    font-family: var(--font-deva), var(--font-mono);
  }

  /* ── THE ONE SANCTIONED LIGHT SURFACE ─────────────────────────────────
     Declared here and nowhere else. Cool stone with hot marigold and crimson
     on top is how Nepali festival colour actually reads — bright warm objects
     against grey sky and stone — and it is deliberately NOT warm cream with
     terracotta, which is the most common machine-generated light palette in
     circulation and would make this page look like every other AI-designed
     page rather than like Nepal.

     CONTRAST, recomputed from scratch against the light ground. The dark-mode
     ratios carry no information here:
       ink   #1A1D2E on rice  16.0:1   body text
       ink/65%        on rice  5.1:1   secondary text (4.6:1 on sky)
       crimson-deep   on rice  5.7:1   the accent that carries text
       crimson        on rice  4.2:1   focus ring and borders only — NOT text
       marigold       on rice  ~2:1    FILL AND BORDER ONLY, never type
       glacier        on rice  2.7:1   the live dot and its border, never type
     ────────────────────────────────────────────────────────────────────── */
  #naam-app {
    --naam-sky: #edeff2;
    --naam-rice: #fafaf8;
    --naam-ink: #1a1d2e;
    --nm-canvas: var(--naam-sky);
    --nm-surface: var(--naam-rice);
    --nm-surface-2: #f1f3f6;
    --nm-text: var(--naam-ink);
    --nm-text-soft: rgb(26 29 46 / 65%);
    --nm-hair: rgb(26 29 46 / 13%);
    --nm-hair-strong: rgb(26 29 46 / 26%);
    --nm-accent-text: var(--crimson-deep);
    --nm-keep-fill: color-mix(in srgb, var(--marigold) 20%, transparent);
    --nm-shadow: 0 1px 2px rgb(26 29 46 / 5%), 0 10px 24px -16px rgb(26 29 46 / 30%);

    display: flex;
    flex-direction: column;
    background: var(--nm-canvas);
    height: 100%;
    color: var(--nm-text);
  }

  .nm-shell {
    display: flex;
    position: relative;
    flex: 1 1 0;
    flex-direction: column;
    min-height: 0;
  }

  /* ── THE THREAD AND THE PLATE ─────────────────────────────────────────
     Two columns from 1100px, and the split is not a way to use up width — it
     is the only arrangement in which the agent can lead.

     Stacked, an arriving hand of cards is ~370px of a 439px stream, so the
     model's sentence was pushed above the fold the instant it was answered
     (measured: top:-180 at 1280×800, -581 at 390). Reply + line + cards is
     506px of content and no scroll offset fits that into 439.

     The two columns are also two different KINDS of thing, which is why this
     reads as a room rather than as a sidebar. The left is a thread — a mala,
     turns strung in the order they happened, and you pass along it. The right
     is a plate — a thali, where what is being weighed is laid out and three of
     it is chosen. Words go on the thread; names go on the plate. The lamp
     stands at the foot of the plate and lights it, so the two halves sit at
     different temperatures: the conversation stays cool paper, the offering is
     warm. That is the whole of the separation — there is no rule between them,
     because a hairline would say "two panels" where the light already says
     "one room, lit from over here".

     Below 1100 it stacks back and the hand becomes a band you swipe. */
  @media (min-width: 1100px) {
    .nm-shell {
      display: grid;
      /* Two rows since the topbar went: the columns, then the composer. */
      grid-template-rows: minmax(0, 1fr) auto;
      /* The plate is sized from the CARD, not from the leftovers. Three cards
         plus the gaps and the tray's padding need ~700px before a gloss stops
         breaking mid-phrase — at 46vw the cards came out 180px and "to shine,
         be bright" wrapped to two lines while "from the document" broke across
         two more. 56vw gives ~218px each at 1280 and the thread still keeps
         ~560px, which is a comfortable measure for prose and more than the
         invitation was getting when it had the whole width. */
      grid-template-columns: minmax(0, 1fr) clamp(31rem, 56vw, 46rem);
      /* The composer belongs to the CONVERSATION, not to the page. Spanning
         the full width it read as a page-level toolbar sitting under two
         unrelated columns; under the left column it is plainly the bottom of
         the thing you are talking into, and the plate on the right becomes one
         uninterrupted object from the hand down to the slots. */
      grid-template-areas:
        'stream tray'
        'composer tray';
    }

    .nm-streamwrap {
      grid-area: stream;
      min-height: 0;
    }

    .nm-tray {
      grid-area: tray;
      justify-content: center;
      min-height: 0;
      overflow: clip;
    }

    /* THE SLOTS ARE PINNED; THE HAND SCROLLS. `overflow: clip` on the tray was
       silently eating whichever end of the column ran out of room, and opening
       "from the document" is enough to do it: the disclosure adds a verbatim
       block to a card, the hand grows by a couple of hundred pixels, and the
       three slots — the thing the page is asking the visitor to fill — were
       pushed off the bottom of their own column with no way to reach them.

       The hand is the part that varies, so the hand is the part that gives.
       Same arrangement as the stacked layout, for the same reason. */
    .nm-hand {
      flex: 1 1 auto;
      min-height: 0;
    }

    .nm-hand > .nm-deal {
      max-height: 100%;
      overflow-y: auto;
    }

    .nm-tray-head,
    .nm-slots {
      flex: 0 0 auto;
    }

    .nm-composer {
      grid-area: composer;
      /* No border between the columns. The conversation side is a surface and
         the plate is the lit ground; two materials at two temperatures say
         "different place" without a rule drawn to announce it. */
      border-top: 0;
    }

    .nm-streamwrap,
    .nm-composer {
      background: var(--nm-talk);
    }

    /* The lamp moved into the right column, so its light moves with it.
       Leaving the pool at 50% would light the room from a point the lamp
       visibly is not — the same lie this page already fixed once vertically. */
    .nm-room {
      background:
        radial-gradient(58% 52% at 78% 84%, color-mix(in srgb, var(--nm-keep) 17%, transparent) 0%, transparent 70%),
        radial-gradient(105% 64% at 78% 100%, color-mix(in srgb, var(--nm-keep) 8%, transparent) 0%, transparent 62%);
    }
  }

  /* ── The lamp, and the room it lights ─────────────────────────────────
     The page used to be inert between clicks, which is the whole reason it
     read as a document rather than as something you were inside. One element
     is now always alive, and it is a light source rather than a decoration —
     so the ground is LIT instead of painted, which is what games do and what
     a flat hex fill can never do.

     The flicker must not look like a loop. Two animations run at deliberately
     incommensurate periods (2.3s and 3.7s); a single sine reads as CSS, two
     out of phase read as fire. The ground rides the same clock at a fifth of
     the amplitude, so the paper breathes without anyone noticing why. */

  /* The pool is centred ON the lamp — which sits low, with the tray — and
     throws its light UPWARD across the conversation. It was at 50% 34% while
     the lamp was at 3% 6%, and a room lit from somewhere the light source
     visibly is not is a thing the eye catches even when it cannot say why. */
  /* ── THE ROOM ANSWERS ──────────────────────────────────────────────────
     The empty half of this screen was a painted rectangle with a slow breath
     on it. A game's negative space is not decoration — it is the clearest
     channel the thing has for telling you what state you are in, and it costs
     nothing to read because you are not reading it.

     So the light is driven by two numbers, both published on .nm-shell by
     NaamApp, and everything here is one compositable property away from them:

       --lit    how far the pool opens and how bright it is
       --warm   how much of the marigold is in it

     THINKING: the pool draws IN and cools slightly — the room holding its
     breath while the lamp works. It is the opposite of a spinner: nothing new
     appears, the space you are already looking at changes.

     KEPT: each name warms the ground one step. Three names and the whole room
     is lamp-coloured. That is the reward for finishing, delivered in the part
     of the screen that has no content in it — which is exactly the part a
     document would have left dead.

     The transition is 900ms and eased, so a state change is a swell rather
     than a switch, and the 3.7s breath keeps running underneath it. */
  /* ────────────────────────────────────────────────────────────────────────
     THE VALLEY — dusk over the Kathmandu valley, drawn in PixiJS.

     Behind everything, taking no input, carrying no information. The page is
     complete without it: the gradient declared here is what shows while the
     ~117 kB chunk loads, if WebGL is blocked, if the context is lost, or if the
     import simply fails. Those are the same outcome and none of them is an
     error — the weather does not arrive, and nothing else changes.

     The gradient is not a placeholder for the scene, it is the scene's own
     first two stops: paper on the left where the room is, dusk on the right
     where the window is. So the swap when Pixi mounts is a deepening rather
     than a replacement, and there is no flash of a different page.
     ──────────────────────────────────────────────────────────────────────── */
  /* z-index 0, NOT -1. The page root paints --nm-canvas opaquely, and a
     negative index puts the canvas behind that fill rather than behind the
     content — the scene rendered perfectly and was never visible. Everything
     above it (.nm-room is 0, the stream and tray are higher) already sits in
     the same stacking context, so 0 with the canvas first in DOM order is what
     puts it underneath them and on top of the page's own background. */
  .nm-valley {
    position: absolute;
    z-index: 0;
    inset: 0;
    /* The scene's own first stops, not a stand-in for them: cool paper where
       the room is, thin cold sky, then the rose band the range stands against.
       So when the chunk lands and Pixi takes over, the picture deepens rather
       than swapping — no flash of a different page. */
    background: linear-gradient(
      104deg,
      var(--nm-canvas) 0%,
      var(--nm-canvas) 36%,
      #dbe1ec 62%,
      #e9d3cb 88%,
      #f1cec2 100%
    );
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .nm-room {
    --lit: 1;
    --warm: 0;

    position: absolute;
    transform: scale(var(--lit));
    opacity: calc(0.72 + var(--warm) * 0.28);
    z-index: 0;
    animation: nm-room-breathe 3.7s ease-in-out infinite;
    transition:
      opacity 900ms cubic-bezier(0.4, 0, 0.2, 1),
      transform 900ms cubic-bezier(0.4, 0, 0.2, 1);
    inset: 0;
    background:
      radial-gradient(
        78% 58% at 50% 88%,
        color-mix(in srgb, var(--nm-keep) calc(15% + var(--warm) * 13%), transparent) 0%,
        transparent 70%
      ),
      radial-gradient(
        140% 70% at 50% 100%,
        color-mix(in srgb, var(--nm-keep) calc(7% + var(--warm) * 7%), transparent) 0%,
        transparent 62%
      );
    pointer-events: none;
  }

  /* One step of warmth per name kept. Written as sibling selectors rather than
     as an inline style so the numbers stay in the stylesheet with the gradient
     they feed. */
  .nm-shell[data-kept='1'] .nm-room {
    --warm: 0.34;
  }

  .nm-shell[data-kept='2'] .nm-room {
    --warm: 0.67;
  }

  .nm-shell[data-kept='3'] .nm-room {
    --warm: 1;
  }

  /* The room holds its breath while the model is out. */
  .nm-shell[data-thinking] .nm-room {
    --lit: 0.94;

    opacity: 0.6;
  }

  /* ── THE FIRST MOVE ────────────────────────────────────────────────────
     Before anything has been asked, the plate is an empty table: three sockets
     and an unlit label for names that do not exist yet. It is drawn from the
     first frame on purpose (endowed progress — a counter that starts visible is
     finished far more often than one that appears when you earn it), but drawn
     is not the same as COMPETING, and on first load it was pulling the eye away
     from the only thing there is to do.

     So until the first ask it stands down: two thirds opacity, slightly
     desaturated, and NOT interactive — it has nothing to receive yet, so
     inert is honest rather than a trick. Everything that IS actionable keeps
     full strength: the invitation, the chips, the composer.

     Dimmed, never hidden. The shape of the ask has to stay legible — you are
     being told "three names, that way", and a plate that appeared out of
     nowhere on your first Keep would be a surprise instead of a promise. */
  .nm-slots,
  .nm-quiet-label {
    transition:
      opacity 700ms cubic-bezier(0.4, 0, 0.2, 1),
      filter 700ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* THE SLOTS STAND DOWN, NOT THE WHOLE TRAY — and the difference is a bug I
     shipped for one build. Dimming .nm-tray dimmed the LAMP inside it, and the
     exemption written for it, `opacity: 2.9` on the child, cannot work at all:
     opacity is clamped to 0–1 and a child's value MULTIPLIES its parent's, so
     the light source sat at 0.34 × 1 on the one frame whose entire job is to
     look worth staying for. There is no way to opt a descendant out of an
     ancestor's opacity. The only fix is to never put it inside one, so the
     dimming now names the two things that are genuinely not usable yet and the
     lamp is simply not in the set. */
  .nm-shell[data-first] .nm-slots,
  .nm-shell[data-first] .nm-quiet-label {
    opacity: 0.52;
    filter: saturate(0.6);
  }

  /* NOT pointer-events: none, and that used to be here. It was correct while a
     slot could only RECEIVE a name kept from the deck — nothing had been dealt,
     so there was nothing it could take. It stopped being correct the moment an
     empty slot became the way to put in a name of your own: the one visitor it
     locked out is the relative who arrived already knowing what they wanted to
     say, which is the best visitor this page gets. Dimmed is a statement about
     emphasis; inert is a statement about what works, and only the first one was
     ever true here. */
  .nm-shell[data-first] .nm-slot-empty:hover,
  .nm-shell[data-first] .nm-slot-empty:focus-visible {
    opacity: 1;
    filter: none;
  }

  /* The composer is the one control that matters on the first frame, so it is
     the one thing that gains rather than merely keeping its ground: a warmer
     ring, and the lamplight pooled under it. It settles the moment there is a
     conversation to carry. */
  .nm-shell[data-first] .nm-composer-in {
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--nm-keep) 34%, transparent),
      0 6px 22px -12px color-mix(in srgb, var(--nm-keep) 60%, transparent);
  }

  /* Under an optional field, explaining the one thing a label cannot: that any
     spelling is fine and it need not come from the document. */
  .nm-field-help {
    display: block;
    margin-top: 0.2rem;
    color: var(--nm-text-soft);
  }

  /* What the topbar used to hold, at the weight it deserved all along. */
  .nm-utility {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    margin: 0.3rem auto 0;
    width: 100%;
    max-width: 720px;
    min-height: 1rem;
  }

  .nm-utility .nm-rail-a11y {
    margin-left: auto;
  }

  /* The one number on the page that is a fact rather than a feeling, so it is
     set as data: small, mono, and quieter than the invitation it sits under. */
  .nm-said--quiet {
    color: var(--nm-text-soft);
    font-size: 0.8rem;
    line-height: 1.7;
    letter-spacing: 0.01em;
  }

  /* Dust in the lamplight — the ambient-particle technique without confetti,
     and what a real butter lamp actually looks like. Suspended while typing
     ([data-calm]) because it is the part that can pull the eye; the flame is
     not, because a lamp that goes out when you start writing is worse than one
     that flickers beside you. */
  .nm-motes {
    position: absolute;
    opacity: 0.5;
    z-index: 0;
    inset: 0;
    pointer-events: none;
  }

  .nm-mote {
    position: absolute;
    animation: nm-mote-drift linear infinite;
    border-radius: 50%;
    background: color-mix(in srgb, var(--nm-keep) 55%, transparent);
    width: 2px;
    height: 2px;
  }

  .nm[data-calm='true'] .nm-motes {
    opacity: 0;
    transition: opacity 600ms ease;
  }

  @keyframes nm-room-breathe {
    0%,
    100% {
      opacity: 0.86;
    }
    50% {
      opacity: 1;
    }
  }

  @keyframes nm-mote-drift {
    0% {
      transform: translate3d(0, 0, 0);
      opacity: 0;
    }
    18% {
      opacity: 0.7;
    }
    82% {
      opacity: 0.5;
    }
    100% {
      transform: translate3d(14px, -190px, 0);
      opacity: 0;
    }
  }

  .nm-diyo {
    position: relative;
    flex-shrink: 0;
    z-index: 1;
    line-height: 0;
  }

  /* transform STRING, not individual properties: individual transforms animate
     CSS variables and are not composited. */
  .nm-diyo-sway {
    transform-origin: 22px 30px;
    animation: nm-flame-sway 3.7s ease-in-out infinite;
  }

  .nm-diyo-inner {
    transform-origin: 22px 24px;
    animation: nm-flame-gutter 2.3s ease-in-out infinite;
  }

  .nm-diyo-glow {
    animation: nm-flame-glow 2.3s ease-in-out infinite;
  }

  /* Three stops, not two, and roughly double the amplitude of the first
     attempt. Two stops make a pendulum — the eye predicts it instantly and it
     reads as a CSS animation. A third stop off-centre breaks the symmetry, and
     because the gutter beneath runs at 2.3s against this 3.7s, the pair never
     lands in the same relative phase twice inside a sitting. */
  @keyframes nm-flame-sway {
    0%,
    100% {
      transform: rotate(-3deg) scaleY(0.97);
    }
    38% {
      transform: rotate(2.2deg) scaleY(1.06);
    }
    64% {
      transform: rotate(-0.8deg) scaleY(1.01);
    }
  }

  @keyframes nm-flame-gutter {
    0%,
    100% {
      transform: scale(1) translateY(0);
    }
    40% {
      transform: scale(0.9) translateY(1px);
    }
    70% {
      transform: scale(1.06) translateY(-1px);
    }
  }

  @keyframes nm-flame-glow {
    0%,
    100% {
      opacity: 0.8;
    }
    45% {
      opacity: 1;
    }
  }

  /* Thinking: the flame narrows and leans. This IS the loading state — there
     is no separate spinner and no pulse-line while the lamp can say it. */
  .nm-diyo[data-state='thinking'] .nm-diyo-sway {
    transform-origin: 22px 32px;
    animation-duration: 1.15s;
  }

  .nm-diyo[data-state='thinking'] .nm-diyo-inner {
    animation-duration: 0.7s;
  }

  /* A name lands: the flame flares once and settles. */
  .nm-diyo[data-state='flare'] .nm-diyo-glow {
    animation: nm-flame-flare 180ms ease-out;
  }

  .nm-diyo[data-state='flare'] .nm-diyo-outer {
    animation: nm-flame-flare 180ms ease-out;
  }

  @keyframes nm-flame-flare {
    0% {
      transform: scale(1);
    }
    45% {
      transform: scale(1.22);
    }
    100% {
      transform: scale(1);
    }
  }

  /* Flying names. position: fixed, so this layer carries no geometry — it is
     here only so the tokens inherit the light tokens and React never diffs
     them. */
  .nm-fx {
    position: absolute;
    z-index: 40;
    inset: 0;
    pointer-events: none;
  }

  /* A spark off the lamp when the third name lands — the page's one particle
     moment, and it is deliberately NOT confetti. Confetti is paper falling at a
     party; this is a flame throwing embers, which is the only thing on this
     screen that could throw anything. Warm-only, and small enough that twelve
     of them read as a lift rather than as a burst. Positioned and animated from
     NaamApp; this is only what one looks like. */
  /* 6px with a glow, not 4px with a soft edge. The first version measured 3px
     wide at 0.47 opacity once the gradient's falloff and the animation's scale
     were applied — a spark that existed in the DOM, animated correctly, and was
     invisible on screen. A warm dot on a warm lit ground needs a hot core and
     something to bloom into, or the lamplight it is rising through simply eats
     it. */
  .nm-ember {
    position: absolute;
    box-shadow: 0 0 7px 1px color-mix(in srgb, var(--nm-keep) 45%, transparent);
    border-radius: 50%;
    background: radial-gradient(circle, #fff6de 0%, var(--nm-keep) 58%, transparent 76%);
    width: 6px;
    height: 6px;
    pointer-events: none;
  }

  /* The rail that used to sit across the top is gone — .nm-topbar, .nm-brand
     and .nm-swap-rail with it. See the comment in NaamApp.tsx for where each
     of its five pieces went and why none of them were simply dropped. */

  /* DESIGN.md §4 — two of the three words, and never a fourth. */
  .nm-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border: 1px solid var(--nm-hair-strong);
    border-radius: 999px;
    padding: 0.15rem 0.55rem;
    color: var(--nm-text-soft);

    /* Glacier is 2.7:1 on rice, so it is the dot and the border. The word is
       set in --nm-text-soft, which is 5.1:1. */
    &[data-source='live'] {
      border-color: var(--nm-live);
    }

    &[data-source='live']::before {
      display: block;
      border-radius: 999px;
      background: var(--nm-live);
      width: 6px;
      height: 6px;
      content: '';
    }
  }

  /* ── The stream ───────────────────────────────────────────────────────── */
  .nm-streamwrap {
    display: flex;
    /* The doodle hangs off this. */
    position: relative;
    flex: 1 1 0;
    min-height: 0;
  }

  .nm-stream {
    flex: 1 1 auto;
    margin: 0;
    padding: var(--space-m) clamp(0.75rem, 2.4vw, 1.4rem) var(--space-s);
    min-height: 0;
    /* overflow-anchor would fight the scroll-to-bottom on every insertion. */
    overflow-anchor: none;
    overflow-y: auto;
    /* Without `contain` an overscroll chains to the document and fires
       pull-to-refresh on a page that must never move. */
    overscroll-behavior: contain;
    list-style: none;
  }

  /* ── The thread, and the beads strung on it ───────────────────────────
     A log is a column of blocks all shouting at the same volume, and it gets
     louder the longer you use it — which is exactly why this screen felt
     overwhelming three turns in. This is a counting object instead: a thread
     down the left, one bead per turn, and the beads you have passed worn
     smaller, fainter and compressed to a single line.

     THE GAP BELONGS TO THE TURN BELOW IT, as padding-top rather than as the
     margin-bottom this used to be, and that is not a style preference. The
     thread has to bridge the space between two beads, and a pseudo-element can
     only read its OWN element's custom properties — so with the gap as a bottom
     margin the connector would have had to know the PREVIOUS turn's spacing,
     which CSS cannot express. As padding-top, --nm-gap is right there.

     That also makes the compression free: a passed turn simply declares a
     smaller --nm-gap, so the mala tightens where you have already been and
     keeps its air around the exchange you are on.

     No timeline library. Every one of them (react-chrono,
     react-vertical-timeline-component, shadcn's blocks) renders a vertical rule
     with cards hanging off it, which is precisely the log being escaped. This
     is a two-column grid, two pseudo-elements and one keyframe. ────────────── */
  .nm-turn {
    --nm-gap: var(--space-m);
    /* The rail's width and the bead's, in one place: the narrow breakpoint
       re-declares these three and every offset below follows.

       IT WAS TOO SMALL TO BE AN OBJECT. At a 22px rail with 12px beads on a
       563px column, every bit of craft below — the turned highlight, the
       inset shade, the counting beads strung along the cord — landed under
       the threshold where any of it is legible, and the whole thing collapsed
       into what it most resembles at that size: a dotted left border with
       three dots on it. The shapes were right and the scale was wrong, which
       is why making the beads MORE correct did not make the mala more
       obvious. A mala is a held object. It has to be big enough to read as
       one. */
    --nm-rail: 30px;
    --nm-rail-gap: 0.8rem;
    --nm-bead: 17px;
    /* Where the bead's top sits, so it lands on the optical centre of the
       first line of text beside it (1rem at 1.7 line-height is a 27px box). */
    --nm-bead-top: 5px;

    display: grid;
    grid-template-columns: var(--nm-rail) minmax(0, 1fr);
    column-gap: var(--nm-rail-gap);
    margin: 0 auto;
    padding-top: var(--nm-gap);
    max-width: 720px;
  }

  /* Nothing is strung above the first bead, and the stream's own top padding
     is already the air above it. 0px, not 0: it is read inside calc(). */
  .nm-turn:first-child {
    --nm-gap: 0px;
  }

  .nm-turn[data-past] {
    --nm-gap: var(--space-2xs);
  }

  /* The .sr-only speaker label is position:absolute, so it is out of flow and
     never takes a grid cell — the rail and the body auto-place into the two
     columns without anything having to be placed by hand. */
  .nm-turn-rail {
    position: relative;
  }

  /* The cord: a continuous faint line with diagonal ticks laid over it. Two
     layers, because either one alone is wrong — the ticks by themselves render
     as a dashed border, which is worse than a plain rule, and a plain 1px
     vertical rule IS the timeline-library look. Together the line carries the
     continuity a strung object needs and the ticks give it a twist, and at
     13% under 26% neither is individually legible. */
  /* THE CORD IS STRUNG WITH BEADS, and that is what was missing. It used to be
     a 2px line with a diagonal twist laid over it — honest about being a cord,
     and it read as a hairline rule, because the thing that makes a mala legible
     is not the thread. It is that the thread is COVERED in beads.

     So the cord carries its own: a repeating radial-gradient of 4px beads every
     7px down its length, each one lit from the top-left like the big ones. The
     line between the turns stops being empty. At a glance you see a strung
     object; at reading distance you see the beads that matter sitting among the
     ones that are only counting. */
  .nm-turn-rail::before,
  .nm-turn-rail::after {
    position: absolute;
    /* Half the cord's own width, so it stays centred in the rail when either
       number changes. It was hard-coded to 3px for a 6px cord and would have
       drifted a pixel and a half off-centre the moment the cord widened. */
    left: calc(var(--nm-rail) / 2 - 4.5px);
    background-image:
      /* THE COUNTING BEADS ARE THE SAME WOOD AS THE BIG ONES. They were mixed
         from --nm-text, which is this page's INK — so they came out blue-grey,
         and the cord read as a dashed rule with wooden beads parked on it.
         That is two objects, not one strung thing. Cut from the same browns
         now, lit from the same top-left, on a warm thread rather than a
         hairline. */
      /* YOU HAVE TO SEE THE THREAD BETWEEN THEM. The counting beads were 5.6px
         across on a 6.8px pitch — 1.2px of cord showing — so they fused into a
         single dashed stroke and the rail read as a dotted border. What makes a
         strung object legible is not that the thread is covered; it is that you
         can see each bead END and the cord carry on to the next. At 8px on a
         12px pitch there are 4px of visible thread between beads and they
         separate into countable things. */
      repeating-radial-gradient(
        circle at 50% 4px,
        #c39c6c 0 1.6px,
        #a3804f 1.6px 2.8px,
        #7a5931 2.8px 3.6px,
        #543c20 3.6px 4px,
        transparent 4.1px 6px
      ),
      linear-gradient(#8a7048 0 100%);
    background-position:
      center top,
      center top;
    background-size:
      9px 12px,
      2px 100%;
    background-repeat: repeat-y, repeat-y;
    width: 9px;
    content: '';
  }

  /* THE CONNECTOR, and it draws. The line REACHING the new bead is the progress
     signal; a node simply appearing is not, and instant appearance is what
     makes a sequence read as a log. scaleY off a top origin rather than an SVG
     stroke-dashoffset: on a straight 2px vertical the two are pixel-identical,
     and this one composites and costs no element. */
  .nm-turn-rail::before {
    top: calc(-1 * var(--nm-gap));
    transform-origin: top;
    animation: nm-thread 500ms cubic-bezier(0.05, 0.7, 0.1, 1) backwards;
    height: calc(var(--nm-gap) + var(--nm-bead-top));
  }

  .nm-turn-rail::after {
    top: calc(var(--nm-bead-top) + var(--nm-bead));
    bottom: 0;
  }

  .nm-turn:first-child .nm-turn-rail::before {
    display: none;
  }

  /* The thread ends at the bead you are on. There is nothing strung after it
     yet, and a cord running past the last bead into empty space is the log's
     "and it continues" — the opposite of what a counting object says. */
  .nm-turn:last-child .nm-turn-rail::after {
    display: none;
  }

  @keyframes nm-thread {
    from {
      transform: scaleY(0);
    }

    to {
      transform: scaleY(1);
    }
  }

  /* FIVE SILHOUETTES, NEVER ONE REPEATED DOT — the repeated bullet is the
     single thing that makes a vertical sequence read as a log, and a mala is
     not one shape repeated either. All of it is one empty <span>: no SVG, no
     icon font, no per-turn element beyond this one.

     `rotate` and `scale` are used as INDIVIDUAL transform properties rather
     than as a transform string, and that is the point of them here: the facet
     beads are permanently turned 45° and the worn state permanently scales, so
     writing both into one `transform` would mean every worn facet has to
     restate the rotation. They are static, so the note about individual
     transforms not compositing does not apply — nothing animates them. */
  /* ROUND, ALWAYS, AND TURNED. The previous cut gave each kind of turn its own
     silhouette — a facet at 45°, a strip, a ring — on the reasoning that one
     repeated dot is what makes a vertical sequence read as a log. That reasoning
     is sound and it produced the wrong object, because A MALA IS ONE SHAPE
     REPEATED. That is the entire thing that makes it recognisable. Five
     silhouettes on a cord is a chart legend.

     So every bead is the same round bead now, lit from the top-left and shaded
     to the bottom-right the way a turned wooden one is, and the TYPE is carried
     in colour and in a little size — which is also true of a real mala, where
     the marker beads and the guru differ in material and scale, never in shape. */
  .nm-bead {
    display: block;
    position: absolute;
    top: var(--nm-bead-top);
    left: calc((var(--nm-rail) - var(--nm-bead)) / 2);
    transition:
      opacity var(--dur-base) ease,
      scale var(--dur-base) ease,
      filter var(--dur-base) ease;
    /* Scaled with the bead. A 1px inset shade reads as turned wood at 12px and
       as a flat disc at 17px — the shading has to keep its proportion to the
       sphere or the bead stops being round. Three layers, and each is doing one
       job: the dark inset is the far side curving away, the white inset is the
       specular where the light lands, and the outer drop is the bead sitting
       ON the cord rather than being printed on it. */
    box-shadow:
      inset -1.5px -2px 3px color-mix(in srgb, #2a1c0c 34%, transparent),
      inset 1.5px 1.5px 2.5px rgb(255 255 255 / 52%),
      0 1.5px 2.5px color-mix(in srgb, #2a1c0c 28%, transparent);
    border-radius: 50%;
    width: var(--nm-bead);
    height: var(--nm-bead);
  }

  /* The agent spoke. The ordinary counting bead, and the one there are most
     of, so it is the quietest. */
  .nm-bead[data-bead='said'] {
    background: radial-gradient(circle at 34% 30%, #b08a5e, #7d5a34 62%, #5d4023);
  }

  /* You asked. Open, because a question is. */
  /* You asked. The paler bead a mala uses as a counting marker. */
  .nm-bead[data-bead='asked'] {
    background: radial-gradient(circle at 34% 30%, #f4ece0, #d9c7ad 62%, #b39c7d);
  }

  /* Names came. The facet — the bead that catches the light. */
  /* Names came. The amber bead — same bead, different stone. */
  .nm-bead[data-bead='dealt'] {
    background: radial-gradient(circle at 34% 30%, #e8b970, #c8862c 60%, #8f5d18);
  }

  /* The shelf: the shape of the leaf it summarises — a narrow strip, not a
     square of paper. */
  /* The shelf. Bone, against all the wood. */
  .nm-bead[data-bead='note'] {
    background: radial-gradient(circle at 34% 30%, #f0e6cf, #d8c9a5 62%, #ad9c76);
  }

  /* Nothing came back. A facet that did not fill. */
  /* Nothing came back. The dark bead. */
  .nm-bead[data-bead='stuck'] {
    background: radial-gradient(circle at 34% 30%, #a9736b, #7d443c 62%, #582b25);
  }

  /* The send: the large bead a mala is counted from and finished at. The ring
     is box-shadow rather than a bigger box, so the bead keeps the same
     geometry as every other one and the worn scale still centres on it. */
  /* THE GURU BEAD. The one every mala is counted from and finished at, and the
     only bead allowed to be a different size — it is larger on a real one, so it
     is larger here, with the tassel's knot below it. */
  .nm-bead[data-bead='guru'] {
    top: calc(var(--nm-bead-top) - 2px);
    left: calc((var(--nm-rail) - var(--nm-bead) - 5px) / 2);
    box-shadow:
      inset -1px -2px 3px color-mix(in srgb, #2a1c0c 34%, transparent),
      inset 1px 1px 2px rgb(255 255 255 / 46%),
      0 1px 2px color-mix(in srgb, #2a1c0c 30%, transparent);
    background: radial-gradient(circle at 34% 30%, #d8a24e, #a8681c 60%, #6d3f0c);
    width: calc(var(--nm-bead) + 5px);
    height: calc(var(--nm-bead) + 5px);
  }

  /* WORN. Smaller, fainter, desaturated — the beads you have already passed
     through your fingers. It is the bead that carries the wear and not the
     text: washing out a summary line would cost contrast for an effect the
     bead gives for free. */
  .nm-turn[data-past] .nm-bead {
    scale: 0.72;
    opacity: 0.55;
    filter: saturate(0.35);
  }

  .nm-turn[data-past]:hover .nm-bead,
  .nm-turn[data-past]:focus-within .nm-bead {
    scale: 0.92;
    opacity: 1;
    filter: none;
  }

  .nm-turn-body {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    min-width: 0;
  }

  /* A passed turn, compressed. It is a real <button> with a real accessible
     name — `bead.reopen` rides along in .sr-only text, because a control
     labelled only "Ways to start" says what it is and not what pressing it
     does — and it is a button rather than a clickable div because axe is the
     gate that decides that (P10). */
  .nm-turn-shut {
    display: block;
    position: relative;
    transition: color var(--dur-base) ease;
    cursor: pointer;
    border: none;
    border-radius: 4px;
    background: none;
    padding: 0;
    min-width: 0;
    min-height: 24px;
    color: var(--nm-text-soft);
    text-align: left;

    &:hover {
      color: var(--nm-text);
    }

    &:focus-visible {
      outline: 2px solid var(--crimson);
      outline-offset: 3px;
    }
  }

  /* The bead is in the other grid column and is aria-hidden, so it cannot be
     its own control — this stretches the button's hit area left across the
     rail so that tapping the bead is tapping the turn, which is the gesture
     the object suggests. */
  .nm-turn-shut::before {
    position: absolute;
    inset: 0 0 0 calc(-1 * (var(--nm-rail) + var(--nm-rail-gap)));
    content: '';
  }

  .nm-turn-shut-line {
    display: block;
    overflow: hidden;
    font-size: 0.88rem;
    line-height: 1.7;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* A turn is a typographic block. No bubble, no avatar, no right-aligned
     user message — that is the single clearest chat-widget tell and P11
     forbids the grammar. The speaker is stated in .sr-only text instead. */
  /* The conversation is the page's voice and it was set at body size, which is
     what you use for text somebody has to get THROUGH. Nobody is skimming here
     — there are three sentences and then a question — so it is set at the size
     you would use for the one paragraph on a page. 62ch stays: the measure is
     what makes a long line readable, and enlarging the type without holding the
     measure just makes a wider block of the same problem. */
  .nm-said {
    margin: 0;
    max-width: 62ch;
    color: var(--nm-text-soft);
    font-size: 1.12rem;
    line-height: 1.72;
  }

  .nm-said--lead {
    max-width: 24ch;
    color: var(--nm-text);
    font-size: clamp(1.35rem, 3.2vw, 1.7rem);
    line-height: 1.35;
    font-family: var(--font-deva), var(--font-display);
    letter-spacing: -0.02em;
  }

  /* What the visitor said. It used to carry a 2px crimson rule down its left
     edge; the thread now runs down the same side about thirty pixels further
     out and the bead beside this turn is the crimson ring, so the rule became
     the second vertical mark in a row saying the same word. One signal: the
     bead says who spoke, the ink weight says it is not the page talking. */
  .nm-said--you {
    color: var(--nm-text);
  }

  .nm-said--note {
    color: var(--nm-accent-text);
  }

  .nm-quiet-label {
    margin: 0;
    color: var(--nm-text-soft);
  }

  /* ── The wall, inline, as a turn ──────────────────────────────────────
     Not behind an "Everyone" tab: a tab is a filing decision, and it makes the
     family something you go and look up. You are choosing next to people who
     already chose, so it is in the conversation.

     WHY IT IS NO LONGER A ROW OF PILLS. A pill row on a page whose every other
     pill is a control (the starters, the badge, the swap) reads as filters —
     something you are expected to click — and nothing here is clickable. It is
     a record of what other people put up, and the object that says that without
     a word of explanation is a wall of pinned notes. It is also the only place
     on this screen where other people accumulate, which is half the answer to
     "nothing grows".

     PURE CSS, ZERO DEPENDENCIES, and every number below is doing a job. */
  /* ── THE SHELF ─────────────────────────────────────────────────────────
     Not post-it notes. A post-it is an office object, and it was the one thing
     on this page borrowed from nobody's world in particular — the names on it
     come out of a Sanskrit and Pali source that was copied for centuries in
     POTHI form: long narrow leaves, a double red rule down the margin, a
     binding hole where the cord passes through. That is the actual shape a list
     of these names has had for a thousand years, so it is what the shelf is
     made of. It is also not the tourist shorthand — no prayer flags, no
     mandala, no om — which is the rule this whole page is built on.

     WHY IT MOVED TO THIS COLUMN. In the conversation it was something that had
     already happened: two turns later it had scrolled away and was never seen
     again. Here it is the surface being ADDED TO. A kept name lands on the same
     shelf the family's names sit on, agreeing with one they already keep gives
     that leaf another bead instead of writing the name twice, and the order
     re-sorts underneath the visitor as they choose. The right-hand column stops
     being an output and becomes the thing that changes.

     WHY BEADS AND NOT SIZE OR A NUMBER — see the long note in NaamWall.tsx. */
  /* THE SHELF IS BOUNDED, because it is the one region on this page that grows
     without limit — every approved suggestion adds a leaf, forever. Unbounded
     it took 210px of a 669px column on the day it was built and squeezed the
     hand until the cards were clipped at both ends. It gets a share and
     scrolls; the hand keeps the rest. */
  /* ────────────────────────────────────────────────────────────────────────
     LAMPS IN THE VALLEY — what the shelf of pothi leaves became.

     The shelf was a scrolling stack of six names at full contrast, each with a
     tally, sitting in the same column as the scene: two objects competing for
     one space, and the heaviest thing on the right of the page. What the list
     SAYS is that these names are burning somewhere in the family, so now it
     says it in the world.

     The wrapper takes no space and no input. It is a positioning surface
     stretched over the canvas, and only the lamps inside it are hit targets —
     otherwise it would swallow every click meant for the tray beneath it.
     ──────────────────────────────────────────────────────────────────────── */
  .nm-shelfwrap {
    position: absolute;
    z-index: 1;
    inset: 0;
    pointer-events: none;
  }

  /* The heading still exists for screen readers and for anyone who wants to
     know what the lights are, but it no longer prints a label over the sky. */
  .nm-shelfwrap .nm-quiet-label {
    position: absolute;
    clip-path: inset(50%);
    margin: -1px;
    border: 0;
    width: 1px;
    height: 1px;
    overflow: hidden;
    white-space: nowrap;
  }

  .nm-lamps {
    position: absolute;
    margin: 0;
    padding: 0;
    inset: 0;
    list-style: none;
  }

  .nm-lamp {
    position: absolute;
    /* Positioned from the SAME lampSpots() the canvas draws from, so the hit
       target is exactly on the light rather than near it. */
    translate: -50% -50%;
  }

  /* The hit target. Bigger than the light it sits on, because a 6px glow is not
     a 44px touch target and the WCAG minimum is not negotiable on the one
     control that carries other people's choices. */
  .nm-lamp-hit {
    display: grid;
    position: relative;
    place-items: center;
    transition:
      transform var(--dur-base) cubic-bezier(0.34, 1.2, 0.64, 1),
      opacity var(--dur-base) ease;
    cursor: pointer;
    border: 0;
    border-radius: 999px;
    background: transparent;
    padding: 0;
    width: 44px;
    height: 44px;
    pointer-events: auto;
  }

  /* THE NAME IS NOT PRINTED OVER THE VALLEY UNTIL IT IS ASKED FOR. Six names
     floating in the sky is the shelf again, in a worse place. It appears on
     hover and on focus, which is also the only way a keyboard reaches it. */
  .nm-lamp-name {
    display: flex;
    position: absolute;
    bottom: 100%;
    flex-direction: column;
    align-items: center;
    gap: 0.1rem;
    transform: translateY(4px);
    opacity: 0;
    transition:
      opacity 220ms ease,
      transform 220ms cubic-bezier(0.34, 1.2, 0.64, 1);
    box-shadow: var(--nm-shadow);
    border-radius: 6px;
    background: color-mix(in srgb, var(--nm-surface) 94%, transparent);
    padding: 0.28rem 0.5rem;
    pointer-events: none;
    white-space: nowrap;
  }

  .nm-lamp-hit:hover .nm-lamp-name,
  .nm-lamp-hit:focus-visible .nm-lamp-name {
    transform: none;
    opacity: 1;
  }

  .nm-lamp-deva {
    color: var(--nm-text);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .nm-lamp-latin {
    color: var(--nm-text-soft);
    font-size: 0.78rem;
  }

  /* Yours, in the same valley. A ring rather than a different colour: the
     lamps are all the same kind of thing and only one of them is yours. */
  .nm-lamp[data-mine] .nm-lamp-hit::after {
    position: absolute;
    opacity: 0.5;
    border: 1px solid var(--nm-keep);
    border-radius: 999px;
    width: 22px;
    height: 22px;
    content: '';
  }

  .nm-lamp-hit:hover,
  .nm-lamp-hit:focus-visible {
    transform: scale(1.12);
  }

  .nm-shelf {
    display: flex;
    flex-direction: column;
    /* Objects with air around them, not rows in a table. */
    gap: 6px;
    /* A hard cut through the middle of a leaf reads as a rendering fault. The
       mask fades the last few pixels so the edge says "there is more of this"
       — which is true, and is the only honest way to end a list that grows. */
    mask-image: linear-gradient(to bottom, #000 calc(100% - 18px), transparent 100%);
    margin: 0;
    padding: 0;
    max-height: clamp(5.5rem, 21vh, 11rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    list-style: none;
  }

  /* ONE LEAF. The palm ochre, the two red rules and the binding hole are the
     whole of the reference and none of them is decoration: the rules are why
     the name has a left margin to sit against, and the hole is why the leaf has
     a left edge that is not the text. */
  .nm-leaf {
    display: flex;
    position: relative;
    align-items: baseline;
    gap: 0.5rem;
    transition:
      background var(--dur-base) ease,
      box-shadow var(--dur-base) ease;
    box-shadow: inset 0 -1px 0 color-mix(in srgb, var(--nm-leaf-ink) 8%, transparent);
    /* The leaf, and its grain: palm is fibrous along its length. */
    background:
      repeating-linear-gradient(
        to right,
        transparent 0 3px,
        color-mix(in srgb, var(--nm-leaf-ink) 3%, transparent) 3px 4px
      ),
      var(--nm-leaf);
    padding: 0.36rem 0.6rem 0.36rem 1.35rem;
    color: var(--nm-leaf-ink);
  }

  .nm-leaf:first-child {
    border-radius: 3px 3px 0 0;
  }

  .nm-leaf:last-child {
    box-shadow: none;
    border-radius: 0 0 3px 3px;
  }

  /* The double red margin rule, and the binding hole between them. */
  .nm-leaf::before {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0.5rem;
    border-right: 1px solid var(--nm-leaf-rule);
    border-left: 1px solid var(--nm-leaf-rule);
    width: 4px;
    content: '';
  }

  .nm-leaf::after {
    position: absolute;
    top: 50%;
    left: 0.62rem;
    transform: translateY(-50%);
    border-radius: 50%;
    background: color-mix(in srgb, var(--nm-leaf-ink) 26%, transparent);
    width: 3px;
    height: 3px;
    content: '';
  }

  .nm-leaf-name {
    display: flex;
    flex: 1 1 auto;
    align-items: baseline;
    gap: 0.45rem;
    min-width: 0;
  }

  /* SUPPORT IS INK. A name written over and over is a darker line on the page,
     which is the one strength cue this material can carry honestly. It never
     works alone: the beads count it and the .sr-only line says it in words. */
  .nm-leaf-deva {
    opacity: calc(0.66 + var(--support, 1) * 0.068);
    font-size: 0.95rem;
    line-height: 1.5;
    font-family: var(--font-deva), var(--font-body);
  }

  .nm-leaf-latin {
    flex: 0 1 auto;
    opacity: calc(0.6 + var(--support, 1) * 0.08);
    overflow: hidden;
    font-weight: calc(400 + var(--support, 1) * 40);
    font-size: 0.82rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .nm-leaf-tally {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 3px;
  }

  .nm-leaf-bead {
    border-radius: 50%;
    background: color-mix(in srgb, var(--nm-leaf-ink) 62%, transparent);
    width: 5px;
    height: 5px;
  }

  .nm-leaf-many {
    color: color-mix(in srgb, var(--nm-leaf-ink) 72%, transparent);
  }

  .nm-leaf-who {
    flex: 0 1 auto;
    opacity: 0.62;
    max-width: 8rem;
    overflow: hidden;
    font-size: 0.58rem;
    font-family: var(--font-mono);
    letter-spacing: var(--tracking-label);
    text-overflow: ellipsis;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* YOURS. A marigold edge down the binding margin — the same colour the lamp
     throws and the same colour a kept card carries, so "this one is mine" is
     one idea in one colour everywhere it appears. It arrives with a single
     settle, because a leaf being laid on a stack is the moment worth marking. */
  .nm-leaf[data-mine] {
    animation: nm-leaf-settle 420ms cubic-bezier(0.05, 0.7, 0.1, 1);
    background:
      repeating-linear-gradient(
        to right,
        transparent 0 3px,
        color-mix(in srgb, var(--nm-leaf-ink) 3%, transparent) 3px 4px
      ),
      color-mix(in srgb, var(--nm-keep) 12%, var(--nm-leaf));
  }

  .nm-leaf[data-mine]::before {
    border-right-color: var(--nm-keep);
    border-left-color: var(--nm-keep);
  }

  @keyframes nm-leaf-settle {
    from {
      transform: translateY(-6px);
      opacity: 0;
    }

    to {
      transform: none;
      opacity: 1;
    }
  }

  .nm-chips {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs);
  }

  .nm-chip {
    transition:
      border-color var(--dur-base) ease,
      color var(--dur-base) ease;
    cursor: pointer;
    border: 1px solid var(--nm-hair-strong);
    border-radius: 999px;
    background: var(--nm-surface);
    padding: 0.4rem 0.85rem;
    color: var(--nm-text-soft);
    font-size: 0.92rem;
    line-height: 1.7;
    /* Mukta first, chips included: a starter that reads ▯▯▯▯ is what a
       missing Devanagari face looks like, and this row is where it shows. */
    font-family: var(--font-deva), var(--font-body);

    &:hover {
      border-color: var(--crimson);
      color: var(--nm-text);
    }

    &:disabled {
      opacity: 0.5;
      cursor: default;
    }
  }

  .nm-chip-hide {
    cursor: pointer;
    border: none;
    background: none;
    padding: 0.4rem 0.2rem;
    color: var(--nm-text-soft);

    &:hover {
      color: var(--nm-accent-text);
    }
  }

  /* ── Thinking: P8, never a spinner ────────────────────────────────────── */
  .nm-thinking {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    max-width: 320px;
  }

  #naam-app .pulse-line {
    background: var(--nm-hair);
  }

  /* Lowercase: it is a caption, not a label (DESIGN.md §3). */
  .nm-caption {
    margin: 0;
    color: var(--nm-text-soft);
    text-transform: lowercase;
  }

  /* ── The deal ─────────────────────────────────────────────────────────
     Names are not shown, they are DEALT: 100ms apart (under ~50 reads as
     "they all appeared"), 420ms each on Material's emphasized-decelerate,
     out of a seeded ±3° rotation so a card lands at the same angle every
     time. This is the page's signature and its one boldness budget.

     No data-reveal anywhere in here: anything inserted into the stream never
     intersects the observer's root, so it would stay at opacity 0 forever. */
  .nm-deal {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: var(--space-2xs);
  }

  @keyframes nm-deal {
    from {
      transform: translateY(16px) rotate(var(--tilt, 0deg)) scale(0.97);
      opacity: 0;
    }

    to {
      transform: none;
      opacity: 1;
    }
  }

  .nm-dealt {
    display: flex;
    animation: nm-deal 420ms cubic-bezier(0.05, 0.7, 0.1, 1) backwards;
    animation-delay: calc(var(--i, 0) * 100ms);
  }

  .nm-dealt > .nm-card {
    flex: 1 1 auto;
  }

  /* ── The hand, lying on the plate ─────────────────────────────────────── */
  .nm-hand {
    min-width: 0;
  }

  /* Three cards abreast, and the plate is sized so they land at their natural
     width rather than being squeezed to fit it. */
  @media (min-width: 1100px) {
    .nm-hand > .nm-deal {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* Stacked, the hand is a band above the slots and you swipe along it. Three
     full-height cards in one column would leave the conversation about 200px,
     which is the problem this move exists to solve, not a smaller version of
     it. Sideways, one card is legible, the next is visibly there, and the
     agent's words keep the top of the screen. */
  @media (max-width: 1099px) {
    .nm-hand > .nm-deal {
      display: flex;
      gap: var(--space-2xs);
      /* The dealt cards lift and rotate; without the padding the top of that
         motion is clipped by the scroller's own edge. */
      padding-block: 2px 0.3rem;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
    }

    .nm-hand .nm-dealt {
      flex: 0 0 min(72vw, 17rem);
      scroll-snap-align: start;
    }

    /* Long glosses are the other overflow, and they are the document's words —
       so this clamps rather than truncates the source: the full line is always
       one tap away under "from the document". */
    .nm-hand .nm-gloss {
      display: -webkit-box;
      overflow: hidden;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 3;
    }
  }

  /* ── The stacked height budget, and why it is written as a cap ─────────
     The conversation needs a floor, or the tray — which is `flex: 0 0 auto` —
     simply takes what it wants and starves the stream to two lines. But a floor
     ALONE is how I pushed the composer off the bottom of a phone: measured at
     390×780, stream 176 + tray 503 + composer 70 came to 793 in a 739px shell,
     the send button's bottom landed at 834, and because the document is
     `overflow: clip` there was nowhere for it to go. It was not clipped or
     scrolled to — it was unreachable, so a visitor on a phone could ask once
     and never again.

     So the floor is modest and the HAND carries the cap. The tray may shrink,
     the hand may not exceed a share of the viewport, and the composer is
     therefore reachable by construction rather than by arithmetic that happens
     to work on the one handset I measured. svh, not vh: on iOS Safari `vh` is
     the tall viewport with the toolbars retracted, which is exactly the 90px
     lie that puts a control under the browser chrome. */
  @media (max-width: 1099px) {
    .nm-streamwrap {
      flex: 1 1 auto;
      min-height: 5.5rem;
    }

    /* The shelf is the newest thing competing for a column that was already
       tight, so on a phone it takes the smallest workable share — two leaves
       and a scroll. Here it is a record you glance at; the surface you work on
       is the hand and the three slots under it. */
    .nm-shelf {
      max-height: 4.4rem;
    }

    /* A SHARE of the shell, not a fixed cap. Independent floors and ceilings
       can each look reasonable and still sum past the viewport — that is
       exactly how 360×640 kept the send button 77px below the fold after the
       390×780 numbers had been fixed. A percentage cannot: whatever the tray
       takes, the stream and the composer keep the rest. */
    .nm-tray {
      flex: 0 1 auto;
      min-height: 0;
      max-height: 58%;
    }

    .nm-hand {
      flex: 1 1 auto;
      min-height: 0;
    }

    /* Sideways between cards, and up and down inside one when the phone is too
       short to show a whole card at once. Clipping instead would hide Keep,
       which is the only thing on the card that does anything. */
    .nm-hand > .nm-deal {
      max-height: 100%;
      overflow: auto;
    }

    /* The lamp is the page's light source, not its subject, and on a phone it
       was spending 79px of a budget the send button needed. It still reads —
       the flicker is what matters and that survives the scale. */
    .nm-diyo svg {
      width: 44px;
      height: 56px;
    }
  }

  /* Offered rather than yanked: the stream sticks to the bottom only while
     you are within 100px of it. */
  .nm-jump {
    position: absolute;
    bottom: var(--space-2xs);
    left: 50%;
    transform: translateX(-50%);
    z-index: 20;
    cursor: pointer;
    box-shadow: var(--nm-shadow, none);
    border: 1px solid var(--nm-hair-strong);
    border-radius: 999px;
    background: var(--nm-surface);
    padding: 0.35rem 0.85rem;
    color: var(--nm-text);
  }

  /* नमस्ते is a gesture before it is a word, and this is the gesture. Set
     SMALLER than the line it opens — the greeting is the largest type on the
     page and an emoji matched to it reads as a sticker — and given an explicit
     emoji stack, because the body face has no glyph for it and an unresolved
     one renders as a hollow box in exactly the place a visitor first looks. */
  .nm-namaste {
    vertical-align: 0.06em;
    margin-right: 0.4rem;
    font-size: 0.72em;
    line-height: 1;
    font-family: 'Apple Color Emoji', 'Segoe UI Emoji', 'Noto Color Emoji', sans-serif;
  }

  /* ── THE OPENING, AS A SEQUENCE ────────────────────────────────────────
     Three lines arrived at once, at reading size, and then sat there. Nothing
     about that says a person is on the other side — it is a paragraph.

     They are staged now, one beat apart, in the order they are meant to be
     read: who is asking, what the list is, what to do. Each rises a few pixels
     as it fades, which is the difference between text appearing and text being
     SAID. `backwards` holds each one invisible through its own delay, so
     nothing flashes at full opacity before its turn.

     And they are BIGGER. The opening is the only thing on this half of the
     screen and it was set as if it were competing for room it does not have to
     compete for. */
  /* THE IRREGULARITY IS HAND-AUTHORED, and that is the whole point. Identical
     durations with an identical delay step is the single loudest tell that a
     stagger was generated rather than composed — and Math.random() at runtime is
     worse, because noise that re-rolls every load is both untestable and reads
     as jitter rather than as a hand. So these six numbers are picked, fixed, and
     slightly wrong on purpose: 430/500/460ms at 0/120/360ms, lifting 10/8/11px.

     Total run 820ms. Past about 1.2s a visitor is no longer being greeted, they
     are waiting — the first cut ran 1260ms and felt exactly that long. */
  .nm-shell[data-first] .nm-said {
    animation: nm-say 460ms cubic-bezier(0.05, 0.7, 0.1, 1) backwards;
    font-size: 1.2rem;
    line-height: 1.74;
  }

  .nm-shell[data-first] .nm-turn:nth-of-type(1) .nm-said {
    --rise: 10px;
    --tilt-in: 0.35deg;
    animation-duration: 430ms;

    animation-delay: 0ms;
  }

  .nm-shell[data-first] .nm-turn:nth-of-type(2) .nm-said {
    --rise: 8px;
    --tilt-in: -0.2deg;
    animation-duration: 500ms;

    animation-delay: 120ms;
  }

  .nm-shell[data-first] .nm-turn:nth-of-type(3) .nm-said {
    --rise: 11px;
    --tilt-in: 0.3deg;
    animation-duration: 460ms;

    animation-delay: 360ms;
  }

  .nm-shell[data-first] .nm-said--lead {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    line-height: 1.36;
  }

  .nm-shell[data-first] .nm-said--quiet {
    font-size: 0.95rem;
  }

  /* The sub-degree settle is what reads as hand-set type rather than as a
     transform. Above about half a degree it stops being a settle and starts
     being a tilt. */
  @keyframes nm-say {
    from {
      transform: translateY(var(--rise, 9px)) rotate(var(--tilt-in, 0deg)) scale(0.985);
      opacity: 0;
    }

    to {
      transform: none;
      opacity: 1;
    }
  }

  /* AS YOU TYPE, THE OPENING MAKES WAY. It has said its piece the moment
     somebody answers it, so it rises and thins rather than vanishing — a
     paragraph that disappears on a keystroke reads as a bug, and one that
     drifts up out of the way reads as the room turning to listen. It is still
     there, still legible, just no longer the loudest thing. */
  /* ── EVERY TURN ARRIVES ────────────────────────────────────────────────
     Nothing here animated on mount. The opening was staged, and then every
     message after it — yours and the agent's — was simply inserted into the
     list at full opacity, which is the "choppy" the page was accused of. A
     conversation where the last line teleports into place has no sense of
     someone speaking; it has the sense of a log being written to.

     So the arrival lives on .nm-turn and runs for all of them, and the two
     speakers arrive DIFFERENTLY, because they are doing different things:

       YOU  travel further and land with an overshoot — cubic-bezier's
            1.52 control point carries it a few pixels past the mark and
            settles back. That is the physics of something you threw.
       THE AGENT does not overshoot. It rises a little, scales up from 0.985
            and fades in on an emphasized-decelerate curve, so it reads as
            arriving rather than as being launched — a voice, not an object.

     No library. A spring's whole visible signature at this scale is an
     overshoot and a settle, and a back-out bezier is that curve; motion.dev's
     springs would be ~30kB gzipped to reproduce a shape one line of CSS
     already draws, on a page whose entire JS budget is 80kB. */
  .nm-turn {
    animation: nm-say 500ms cubic-bezier(0.05, 0.7, 0.1, 1) backwards;
  }

  .nm-turn:has(.nm-said--you) {
    --rise: 18px;
    animation-duration: 560ms;
    animation-timing-function: cubic-bezier(0.34, 1.52, 0.64, 1);

    animation-name: nm-turn-you;
  }

  .nm-said,
  .nm-turn {
    transition:
      transform 620ms cubic-bezier(0.34, 1.2, 0.64, 1),
      opacity 620ms ease,
      font-size 380ms ease;
  }

  /* The still frame of an arrival: it still arrives, it just does not travel. */
  @keyframes nm-fade-in {
    from {
      opacity: 0;
    }

    to {
      opacity: 1;
    }
  }

  @keyframes nm-turn-you {
    from {
      transform: translateY(var(--rise, 18px));
      opacity: 0;
    }

    to {
      transform: none;
      opacity: 1;
    }
  }

  .nm-shell[data-composing] .nm-turn {
    transform: translateY(-10px);
    opacity: 0.55;
  }

  .nm-shell[data-composing] .nm-said--lead {
    font-size: clamp(1.15rem, 1.9vw, 1.4rem);
  }

  /* ── THE DOODLE ────────────────────────────────────────────────────────
     A drawn hint rather than a written one. "Type here" is an instruction and
     reads as an apology for the interface; a line curving down to the box is
     the gesture a person makes when they point at something across a table.

     It draws itself once — stroke-dashoffset from the full length to zero, so
     the line is made rather than revealed — then sways a degree and a half on a
     slow loop so it stays alive without asking for attention. It leaves the
     instant the visitor types. */
  /* IT SPANS THE GAP IT IS POINTING ACROSS. It used to be an 81px scribble in
     the bottom-left corner of a 255px void — pointing, but from nowhere in
     particular to nowhere in particular. Anchored to the bottom of the stream
     and given real height, it starts under the last line of the invitation and
     ends just above the composer, so the thing it connects is legible as a
     connection.

     Bottom-anchored rather than top-anchored because the invitation's height
     changes with the viewport and the composer's does not: measuring down from
     the fixed end is the one that cannot drift into the text. */
  /* IT SITS UNDER THE TEXT, WHICH IS WHERE IT WAS POINTING FROM.
     Measured at 1280: the invitation's lines run 56→541 with their centre at
     298 and the composer's input centre at 265, while the doodle sat at 46→110,
     centred on 78. It was not under the invitation at all — it hung off the left
     margin, over the mala's rail, and pointed down past the corner of the box.
     A gesture across a table only reads as one when it starts where you were
     looking, so it is centred on the column both ends share.

     `left` and a negative half-width rather than translateX, because the sway
     and the arrival both animate `transform` and a static translate on the same
     element is simply overwritten by them. */
  .nm-doodle {
    --nm-doodle-w: clamp(58px, 6.5vw, 88px);

    position: absolute;
    bottom: 0.4rem;
    left: 50%;
    margin-left: calc(var(--nm-doodle-w) / -2);
    transform-origin: 50% 6%;
    z-index: 3;
    /* IT WAITS BEFORE IT POINTS. A hint that arrives with the page is a hint
       nobody needed yet, and NN/g's work on coach marks is blunt about the cost
       of over-hinting: people dismiss them faster and rate the product as more
       complicated. 3.4s is long enough that it only ever meets somebody who has
       read the invitation and not moved, and it leaves for good on the first
       keystroke. (A considered starting point, not a measured optimum — there
       is no published figure for idle-hint delay on a chat composer.) */
    animation:
      nm-doodle-in 400ms ease 3400ms backwards,
      nm-doodle-sway 4.6s ease-in-out 4.4s infinite;
    /* WIDER AGAIN. It was clamp(72px, 9vw, 108px) and got cut to 62px in the
       same pass that lengthened it, which left a 224px drop through a 62px
       channel — the wander had nowhere to go and the three changes of mind
       flattened into a wavy line. The curve needs room across to read as a hand
       rather than as a squiggle drawn down a corridor. */
    width: var(--nm-doodle-w);
    height: clamp(132px, 30vh, 224px);
    pointer-events: none;
    color: color-mix(in srgb, var(--nm-keep) 74%, var(--nm-text-soft));
  }

  .nm-doodle-line,
  .nm-doodle-barb {
    stroke: currentcolor;
    /* Normalised by pathLength="100" on every path, so this one number is
       correct for all three regardless of their real lengths. */
    stroke-dasharray: 100;
    stroke-width: 2.2;
  }

  /* ONE CONFIDENT STROKE, 480ms. The first cut ran 1100ms on an ease-in-out,
     which is the speed AND the evenness of a progress bar rather than a pen — a
     ~140px line drawn at roughly 0.29px/ms is a hand moving. This curve
     accelerates into the middle of the stroke and decelerates at the tip, which
     is what a wrist does; `linear` is the plotter tell. */
  .nm-doodle-line {
    animation: nm-doodle-draw 480ms cubic-bezier(0.65, 0, 0.35, 1) 3400ms backwards;
  }

  /* The barbs land after the shaft arrives, 40ms apart, because that is the
     order and the rhythm a hand draws them in. */
  .nm-doodle-barb {
    animation: nm-doodle-draw 140ms cubic-bezier(0.65, 0, 0.35, 1) 3820ms backwards;
  }

  .nm-doodle-barb--b {
    animation-delay: 3860ms;
  }

  @keyframes nm-doodle-draw {
    from {
      stroke-dashoffset: 100;
    }

    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes nm-doodle-in {
    from {
      opacity: 0;
    }

    to {
      opacity: 1;
    }
  }

  @keyframes nm-doodle-sway {
    0%,
    100% {
      rotate: -1.5deg;
    }

    50% {
      rotate: 1.5deg;
    }
  }

  .nm-shell[data-composing] .nm-doodle {
    transform: translateY(8px);
    opacity: 0;
    transition:
      opacity 320ms ease,
      transform 320ms ease;
  }

  /* ── THE COMPOSER, ARRIVING AND ANSWERING ──────────────────────────────
     Two moments, and both exist because a text field is the least alive thing
     an interface can put in front of someone.

     THE ARRIVAL is a page-load sequence, not an effect: the invitation is
     already on screen and the composer rises into place a beat later, so the
     order you read it in is the order it happens — here is who is asking, here
     is what we are asking, here is where you answer. It runs once.

     THE ANSWER is the ring. At rest it is a hairline; the moment the field has
     focus or a single character in it, the ring warms to lamp colour and the
     lamplight pools under it. Nothing moves — a field that jumps as you type is
     unusable — the LIGHT changes, which is the same language the rest of this
     page speaks. */
  .nm-composer-in {
    animation: nm-composer-arrive 620ms cubic-bezier(0.05, 0.7, 0.1, 1) 420ms backwards;
  }

  @keyframes nm-composer-arrive {
    from {
      transform: translateY(10px);
      opacity: 0;
    }

    to {
      transform: none;
      opacity: 1;
    }
  }

  .nm-composer-in:focus-within,
  .nm-composer[data-typing] .nm-composer-in {
    box-shadow:
      0 0 0 3px color-mix(in srgb, var(--nm-keep) 16%, transparent),
      0 8px 26px -14px color-mix(in srgb, var(--nm-keep) 72%, transparent);
    border-color: var(--nm-keep);
  }

  /* The send button is dead weight until there is something to send, and then
     it is the only warm thing in the column. */
  .nm-composer-go:not(:disabled) {
    background: var(--nm-keep-fill);
    color: var(--nm-text);
  }

  /* ── THE LEAVES FLOAT ──────────────────────────────────────────────────
     What makes a rendered scene read as a space rather than a picture of one is
     never the texture — it is that things sit at different DEPTHS and betray it
     when anything moves. Three cues, all of them cheap, all composited:

       PARALLAX. NaamWall publishes the pointer's offset from the shelf's centre
       as --px/--py; each leaf multiplies it by its own depth, so they slide
       past each other rather than together. This is the one that does most of
       the work, and it is why the listener is on the window rather than on
       hover — a scene answers where you are, not whether you are touching it.

       AN IDLE BOB, per leaf, on its own clock. Durations are 5.3/6.1/7.3s and
       deliberately incommensurate: a shelf where everything breathes together
       is a shelf that is animating, and one where nothing quite lines up is a
       shelf that is alive. Same trick as the flame.

       A CONTACT SHADOW AND A LIFT SHADOW, and the gap between them IS the
       height. One blurred shadow is a card in a list; a hard shadow directly
       under the object plus a wide soft one further out is an object above a
       surface.

     DEPTH IS SUPPORT. A name several people have chosen floats higher, casts a
     longer shadow and travels further under the pointer. So the thing the eye
     reads as "closest to me" is the thing the family keeps coming back to, and
     the tally stops being an annotation and becomes the arrangement. */
  .nm-shelf {
    /* The leaves need somewhere to float IN. Without a perspective the whole
       thing is 2D sliding and the eye knows. */
    perspective: 700px;
  }

  .nm-leaf {
    /* Support sets the height, and POSITION IN THE STACK breaks the ties. With
       depth from support alone, a shelf where nothing has been chosen twice yet
       gives every leaf the same value, and six things displacing by an
       identical 6.5px is not parallax — it is the whole slab sliding, which the
       eye reads as one flat object moving. Leaves in a real stack do not share a
       height. The index term runs the same way the sort does (most-supported
       first, so deeper as you go down), which means it reinforces the order
       rather than muddling it. */
    --depth: calc(0.42 + var(--support, 1) * 0.15 - var(--i, 0) * 0.045);

    translate: calc(var(--px, 0) * var(--depth) * -7px) calc(var(--py, 0) * var(--depth) * -4px);
    animation: nm-leaf-float calc(5.3s + var(--i, 0) * 0.62s) ease-in-out calc(var(--i, 0) * -1.7s) infinite;
    transition: translate 220ms cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow:
      0 1px 1px color-mix(in srgb, var(--nm-leaf-ink) 16%, transparent),
      0 calc(2px + var(--depth) * 9px) calc(6px + var(--depth) * 16px) calc(-4px - var(--depth) * 2px)
        color-mix(in srgb, var(--nm-leaf-ink) 26%, transparent);
    border-radius: 3px;
  }

  @keyframes nm-leaf-float {
    0%,
    100% {
      transform: translateY(0) rotateX(0deg);
    }

    50% {
      transform: translateY(calc(var(--depth) * -3.5px)) rotateX(1.4deg);
    }
  }

  /* A leaf lifts out of the stack under the pointer — the one place the shelf
     answers a touch directly rather than a position. */
  .nm-leaf:hover {
    z-index: 1;
    box-shadow:
      0 1px 1px color-mix(in srgb, var(--nm-leaf-ink) 18%, transparent),
      0 calc(6px + var(--depth) * 10px) calc(14px + var(--depth) * 18px) calc(-4px - var(--depth) * 2px)
        color-mix(in srgb, var(--nm-leaf-ink) 32%, transparent);
  }

  /* ── The card, on both grounds ────────────────────────────────────────── */
  .nm-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--space-s);
    margin-top: var(--space-m);
  }

  .nm-card {
    display: flex;
    /* The stretched Keep overlay is positioned against this. */
    position: relative;
    flex-direction: column;
    gap: var(--space-2xs);
    transition:
      border-color var(--dur-base) ease,
      box-shadow var(--dur-base) ease,
      transform var(--dur-base) ease;
    box-shadow: var(--nm-shadow, none);
    border: 1px solid var(--nm-hair);
    border-radius: 12px;
    background: var(--nm-surface);
    padding: var(--space-s);
  }

  /* DESIGN.md P2 is emphasis by glow — but glow is a dark-ground device, and
     on rice a 28px marigold bloom is invisible. The light branch spends the
     same meaning as a fill and a border, which is all marigold is allowed to
     be here: at ~2:1 on rice it can never carry type. */
  .nm-card[data-picked='true'] {
    box-shadow: var(--glow-marigold);
    border-color: var(--nm-keep);
  }

  #naam-app .nm-card[data-picked='true'] {
    box-shadow: none;
    background: var(--nm-keep-fill);
  }

  .nm-card-name {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  /* Devanagari gets a fixed block so a late font swap shifts nothing, and
     1.65 line-height because matras collide below about 1.6. */
  .nm-deva {
    display: block;
    min-height: 2.8rem;
    color: var(--nm-text);
    font-size: 1.7rem;
    line-height: 2.8rem;
    font-family: var(--font-deva), var(--font-body);
  }

  .nm-latin {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    margin: 0;
  }

  .nm-latin-main {
    color: var(--nm-text);
    font-size: 1.15rem;
    font-family: var(--font-display);
  }

  .nm-latin-alt {
    color: var(--nm-text-soft);
    text-transform: none;
  }

  /* ── The sound rail ───────────────────────────────────────────────────
     width: max-content is what makes this an instrument rather than a
     divider: the rule ends at the last tick, so its length IS the syllable
     count (DESIGN.md P4). The 26px is headroom for the swap control, which
     hangs above the first tick — so only the rows that HAVE one pay for it. */
  .nm-rail[data-swap='true'] {
    padding-top: 26px;
  }

  .nm-ticks {
    display: flex;
    position: relative;
    align-items: flex-start;
    gap: clamp(0.9rem, 4vw, 1.75rem);
    margin: 0;
    padding: 0;
    width: max-content;
    max-width: 100%;
    list-style: none;

    &::before {
      position: absolute;
      top: 4px;
      right: 0;
      left: 0;
      border-radius: 999px;
      background: var(--grad-signal);
      height: 2px;
      content: '';
    }
  }

  .nm-tick {
    display: flex;
    position: relative;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
  }

  .nm-tick-dot {
    display: block;
    border-radius: 999px;
    background: var(--nm-text);
    width: 10px;
    height: 10px;
  }

  .nm-tick-syllable {
    color: var(--nm-text-soft);
    text-transform: uppercase;
  }

  /* The document's own `!` — a harder consonant cluster, marked on the
     syllable whose onset carries it. */
  .nm-tick[data-cluster='true'] .nm-tick-dot {
    box-shadow: var(--ring-crimson);
    background: var(--crimson);
  }

  .nm-tick[data-cluster='true'] .nm-tick-syllable {
    color: var(--nm-accent-text);
  }

  .nm-swap-slot {
    position: absolute;
    bottom: calc(100% + 6px);
    left: 50%;
    transform: translateX(-50%);
  }

  .nm-swap {
    transition:
      border-color var(--dur-base) ease,
      color var(--dur-base) ease;
    cursor: pointer;
    border: 1px solid var(--nm-hair-strong);
    border-radius: 999px;
    background: var(--nm-surface-2);
    padding: 0.15rem 0.5rem;
    color: var(--nm-text-soft);
    white-space: nowrap;

    &[aria-pressed='true'] {
      border-color: var(--crimson);
      color: var(--nm-text);
    }

    &:disabled {
      opacity: 0.55;
      cursor: default;
    }
  }

  /* The document is speaking, and P5 says mono is the voice of data. Clamped
     to three lines: Monier-Williams glosses run from four characters to four
     hundred, and in a grid every row stretches to its tallest card. The full
     text is one tap away in the disclosure directly below. */
  .nm-gloss,
  .nm-source-gloss {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    color: var(--nm-text-soft);
    font-size: 0.95rem;
    line-height: 1.6;
    font-family: var(--font-deva), var(--font-mono);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .nm-source-gloss {
    display: block;
    margin: 0 0 0.35rem;
    overflow: visible;
  }

  .nm-undocumented,
  .nm-card-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs) var(--space-s);
    margin-top: auto;
    padding-top: var(--space-2xs);
  }

  /* ── KEEP ──────────────────────────────────────────────────────────────
     THE WHOLE CARD IS THE TARGET. A quiet outlined pill in a corner asks the
     visitor to notice it, aim at it, and work out that it — and not the name
     above it — is the thing that chooses. Three steps for one idea.

     The click lives on the <article> in NaamCard.tsx; the real <button> is
     still there and still does the work, so keyboard and screen-reader users
     get one properly-labelled control per card and nothing is nested inside
     anything interactive.

     I tried the stretched-pseudo-element pattern first — `.nm-pick::after`
     with `inset: 0` over the card — and it is written up everywhere, but it
     did not survive verification here: `elementFromPoint` reported the button
     at every point on the card while a real mouse press produced no click at
     all. Rather than ship an interaction whose only evidence was a synthetic
     event I had dispatched onto the button myself, it went.

     The pill is FILLED now rather than outlined. Marigold is ~2:1 on rice and
     can never carry type here, so the fill is the pale keep-fill with a
     marigold edge and the word stays in --nm-text: it reads as a control at a
     glance without putting text on a colour that cannot hold it. */
  .nm-pick {
    transition:
      border-color var(--dur-base) ease,
      background var(--dur-base) ease,
      box-shadow var(--dur-base) ease;
    cursor: pointer;
    border: 1px solid var(--nm-keep);
    border-radius: 999px;
    background: color-mix(in srgb, var(--nm-keep) 10%, transparent);
    padding: 0.32rem 0.9rem;
    color: var(--nm-text);

    &[aria-pressed='true'] {
      border-color: var(--nm-keep);
      background: var(--nm-keep-fill);
    }

    &:disabled {
      opacity: 0.5;
      cursor: default;
    }
  }

  /* The card is the target, so the card is what reacts — and it reacts to
     :focus-within too, or a keyboard user gets none of the feedback a mouse
     user gets for free. */
  .nm-card:has(.nm-pick:not(:disabled)) {
    cursor: pointer;
  }

  .nm-card:has(.nm-pick:not(:disabled)):hover,
  .nm-card:has(.nm-pick:focus-visible) {
    transform: translateY(-2px);
    box-shadow:
      0 2px 4px -2px color-mix(in srgb, var(--nm-text) 14%, transparent),
      0 12px 24px -14px color-mix(in srgb, var(--nm-keep) 70%, transparent);
    border-color: var(--nm-keep);
  }

  .nm-card:has(.nm-pick:not(:disabled)):hover .nm-pick,
  .nm-card:has(.nm-pick:focus-visible) .nm-pick {
    background: var(--nm-keep-fill);
  }

  .nm-source {
    summary {
      cursor: pointer;
      color: var(--nm-text-soft);
    }

    summary:hover {
      color: var(--nm-accent-text);
    }
  }

  .nm-source-body {
    margin-top: var(--space-2xs);
    border-left: 1px solid var(--nm-hair);
    padding-left: var(--space-2xs);
  }

  .nm-source-meta,
  .nm-source-note {
    opacity: 0.8;
    margin: 0;
    color: var(--nm-text-soft);
  }

  /* ── The tray: ONE shape, three parts missing ─────────────────────────
     Apple's rings work by Gestalt closure — an open ring is a perceptually
     unfinished shape. Three separate grey rectangles are not, which is why
     the prototype's tray was the weakest thing in it. So the three slots are
     drawn as a single ring, and every EMPTY slot erases its segment of the
     top and bottom edge. Filling slot two closes the middle third and
     changes what one and three look like. There is no "1/3 KEPT" counter:
     the shape says it, and a counter is the gamification cliché. */
  /* TRANSPARENT, not --nm-canvas. An opaque tray sat on top of .nm-room and
     cut the lamplight off in a hard horizontal line right where the lamp is —
     the light stopped at the edge of the thing emitting it. The border-top goes
     for the same reason: a rule across the pool is a seam in the room. The tray
     still reads as a distinct surface because the light falls off toward the
     edges, which is how a lit surface separates from its background anyway. */
  /* THE CONTROLS STAY IN THE OPEN SKY, and this is the one that took two tries.
     When the shelf of leaves left the flow to become lamps, the tray lost the
     block that had been holding it down, so I grew it to fill the column and
     pushed the contents to the bottom — on the reasoning that a lamp rests on
     something. What that actually did was drop the three keep-slots and their
     label into the busiest part of the scene, where the town, the flags and the
     lamps are, and neither the slots nor their Devanagari numerals could be
     read at all. A control has to win against whatever is behind it.

     So the tray keeps its natural height and its contents sit high, in the
     empty band above the range where nothing competes. The diyo does float
     there rather than resting on ground — which is fine, and arguably better: a
     flame against the alpenglow is the picture, and the valley below it is
     where everyone else's lamps are. */
  .nm-tray {
    display: flex;
    position: relative;
    /* FILLS THE COLUMN, and it has to. `.nm-hand` is `flex: 1 1 auto` with
       `max-height: 100%; overflow-y: auto` so a nine-card deal scrolls — but a
       tray sized to its content gives the hand nothing to be bounded BY, so the
       grid simply overflowed and the third row was unreachable. Measured:
       dealScrollable false against a 645px grid. min-height: 0 is the other
       half of it — without it a flex child refuses to shrink below its content
       and the overflow rule never engages. */
    flex: 1 1 auto;
    flex-direction: column;
    gap: 0.5rem;
    z-index: 1;
    min-height: 0;
    background: transparent;
    padding: 0.6rem clamp(0.75rem, 2.4vw, 1.4rem);
  }

  /* The lamp stands above the label, both centred over the three slots, so the
     light and the thing it lights share an axis. `align-items: baseline` would
     hang a 79px SVG off a 10px label's baseline — the lamp needs its own row. */
  /* The one rescued index link. Sits after the badge, deliberately the
     quietest thing in the rail — it is a legal obligation, not a destination. */
  /* ── The sound switch ─────────────────────────────────────────────────
     Quieter than the व/ब toggle beside it, because it changes how the page
     sounds rather than what it says. The glyph is a struck bowl seen from the
     side — a dot for the strike and a ring for the ring — which fills when the
     sound is on. It is not a speaker with waves coming out of it: this page
     does not have speakers in it, it has a bowl. */
  .nm-sound {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    transition: color var(--dur-base) ease;
    cursor: pointer;
    margin-left: var(--space-s);
    border: 0;
    background: transparent;
    padding: 0.25rem 0;
    color: var(--nm-text-soft);

    &:hover,
    &:focus-visible {
      color: var(--nm-accent-text);
    }
  }

  .nm-sound-glyph {
    display: inline-block;
    transition:
      background var(--dur-base) ease,
      box-shadow var(--dur-base) ease,
      border-color var(--dur-base) ease;
    border: 1px solid var(--nm-hair-strong);
    border-radius: 50%;
    width: 8px;
    height: 8px;

    &[data-on] {
      /* The strike, and the ring going out from it. */
      box-shadow: 0 0 0 3px color-mix(in srgb, var(--nm-keep) 26%, transparent);
      border-color: var(--nm-keep);
      background: var(--nm-keep);
    }
  }

  /* On a phone the rail has the wordmark, two toggles and a link in 44px. The
     switch keeps its glyph — which is the state — and drops the word. */
  @media (max-width: 599px) {
    .nm-sound-word {
      position: absolute;
      clip-path: inset(50%);
      width: 1px;
      height: 1px;
      overflow: hidden;
      white-space: nowrap;
    }
  }

  .nm-rail-a11y {
    margin-left: var(--space-s);
    color: var(--nm-text-soft);
    font-size: 0.62rem;
    text-decoration: none;
  }

  .nm-rail-a11y:hover,
  .nm-rail-a11y:focus-visible {
    color: var(--nm-accent-text);
    text-decoration: underline;
  }

  .nm-tray-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15rem;
    margin: 0 auto;
    width: 100%;
    max-width: 720px;
  }

  /* The site footer is hidden on this page, so its index rides here — but it is
     chrome, not content, and it was arriving at the same visual weight as
     "YOUR THREE" with crimson underlines competing beside the slots. It keeps
     its 24px targets and its contrast; it loses the decoration and drops half a
     step in size so the eye reaches the slots first. */
  .nm-index {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.75rem;
    margin-left: auto;
    font-size: 0.62rem;

    a {
      display: inline-flex;
      align-items: center;
      min-height: 24px;
      color: var(--nm-text-soft);
      text-decoration: none;

      &:hover,
      &:focus-visible {
        color: var(--nm-accent-text);
        text-decoration: underline;
      }
    }
  }

  /* ONE shape, three parts missing — not three boxes.
     An open ring is perceptually unfinished in a way three separate rectangles
     never are (this is why Apple's activity rings work and a progress bar does
     not), so the tray is a single continuous outline and each EMPTY slot punches
     a gap out of its top and bottom edge. Filling a slot does not paint a box;
     it closes the ring. That is also why filling slot 2 changes how 1 and 3
     read — the shape is shared, so the gaps are relative to each other.
     overflow:hidden so a filled slot's marigold clips to the rounded corners
     instead of spilling past them. */
  /* A CONTROL HAS TO WIN AGAINST WHATEVER IS BEHIND IT.
     These sat on paper when they were designed; they now sit over a valley at
     dusk, and wherever the tray happens to land — which moves with the deal
     size and the viewport — the town, the prayer flags and the lamps can end up
     directly behind them. Twice in this pass the three Devanagari numerals
     became unreadable and both times I fixed it by moving the scene, which is
     fixing the symptom at whichever width I happened to be looking at.
     A translucent paper surface fixes it at every width instead: the slots
     always read, and the valley is still visible through them. */
  .nm-slots {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    backdrop-filter: blur(3px);
    margin: 0 auto;
    box-shadow: 0 1px 12px -6px rgb(26 29 46 / 22%);
    border: 1.5px solid var(--nm-hair-strong);
    border-radius: 10px;
    background: color-mix(in srgb, var(--nm-surface) 76%, transparent);
    width: 100%;
    max-width: 460px;
    overflow: hidden;
    list-style: none;
  }

  /* The label above them, same reasoning, lighter touch. */
  .nm-quiet-label {
    border-radius: 4px;
    background: color-mix(in srgb, var(--nm-canvas) 68%, transparent);
    padding: 0.1rem 0.4rem;
  }

  .nm-slot {
    display: grid;
    position: relative;
    place-items: center;
    min-height: 62px;
  }

  /* The divider between parts, so "three" is legible without three borders. */
  .nm-slot + .nm-slot {
    border-left: 1.5px solid var(--nm-hair-strong);
  }

  .nm-slot::before,
  .nm-slot::after {
    position: absolute;
    height: 1.5px;
    content: '';
  }

  .nm-slot::before {
    top: -1.5px;
  }

  .nm-slot::after {
    bottom: -1.5px;
  }

  /* Empty: the ring is missing here. Exactly the border's own thickness, so the
     gap reads as absence rather than as a drawn dash. */
  .nm-slot:not([data-filled])::before,
  .nm-slot:not([data-filled])::after {
    right: 18%;
    left: 18%;
    background: var(--nm-canvas);
  }

  /* Kept: the ring is not merely present, it is marigold — fill and border,
     which is the only thing marigold is allowed to be on a light ground. */
  .nm-slot[data-filled] {
    background: var(--nm-keep-fill);
  }

  .nm-slot[data-filled]::before,
  .nm-slot[data-filled]::after {
    right: 0;
    left: 0;
    background: var(--nm-keep);
  }

  .nm-slot:first-child[data-filled]::before,
  .nm-slot:first-child[data-filled]::after {
    left: 7px;
  }

  .nm-slot:first-child[data-filled] {
    border-radius: 9px 0 0 9px;
  }

  .nm-slot:last-child[data-filled]::before,
  .nm-slot:last-child[data-filled]::after {
    right: 7px;
  }

  .nm-slot:last-child[data-filled] {
    border-radius: 0 9px 9px 0;
  }

  .nm-slot-take {
    display: grid;
    place-items: center;
    cursor: pointer;
    border: none;
    background: none;
    padding: 0.3rem;
    width: 100%;
    height: 100%;
  }

  /* A name is in flight toward this slot. The slot is already filled — state
     never waits for an animation — so the seat is held blank until the token
     lands on it, and the name appears in exactly the frame the token is
     removed. NaamApp sets and clears the attribute imperatively. */
  .nm-slot[data-landing] .nm-token {
    visibility: hidden;
  }

  /* AN EMPTY SLOT IS A CONTROL NOW, so it has to look like one can be pressed
     without shouting at three of them on the first frame. At rest it is what it
     always was — a Devanagari numeral in a waiting box — and the + only fades up
     under a pointer or a focus ring. The whole box is the target. */
  .nm-slot-empty {
    display: grid;
    position: relative;
    place-items: center;
    transition:
      background var(--dur-base) ease,
      border-color var(--dur-base) ease;
    cursor: pointer;
    border: 0;
    background: transparent;
    padding: 0;
    width: 100%;
    height: 100%;
  }

  .nm-slot-add {
    position: absolute;
    right: 0.42rem;
    bottom: 0.28rem;
    transform: scale(0.8);
    opacity: 0;
    transition:
      opacity var(--dur-base) ease,
      transform var(--dur-base) ease;
    color: var(--nm-accent-text);
    font-size: 0.95rem;
    line-height: 1;
  }

  .nm-slot-empty:hover,
  .nm-slot-empty:focus-visible {
    background: color-mix(in srgb, var(--nm-keep) 9%, transparent);
  }

  .nm-slot-empty:hover .nm-slot-add,
  .nm-slot-empty:focus-visible .nm-slot-add {
    transform: none;
    opacity: 1;
  }

  .nm-slot-empty:hover .nm-slot-ord,
  .nm-slot-empty:focus-visible .nm-slot-ord {
    opacity: 0.35;
  }

  /* Typing straight into the slot. It fills the box rather than sitting in it,
     so the box does not appear to gain a second, smaller box. */
  /* 1rem IS A HARD FLOOR, not a taste. iOS Safari zooms the viewport when a
     focused input's font-size is under 16px, and on a page whose whole premise
     is that it never scrolls, that zoom breaks the layout the moment somebody
     taps a slot. The visible text is smaller elsewhere on this row; this one
     control cannot be.

     line-height 1.6 for the same reason the cards use it: Devanagari matras sit
     above and below the baseline and clip inside a 64px box at 1.2. */
  .nm-slot-input {
    border: 0;
    border-bottom: 1.5px solid var(--nm-keep);
    border-radius: 0;
    background: transparent;
    padding: 0 0.4rem;
    width: 100%;
    height: 100%;
    color: var(--nm-text);
    font-size: 1rem;
    line-height: 1.6;
    font-family: var(--font-deva), var(--font-body);
    text-align: center;
  }

  .nm-slot-input:focus {
    outline: none;
  }

  /* The way out of the tray. Quiet until there is something to send, and then
     it is the warmest thing under the slots. */
  .nm-tray-send {
    animation: nm-say 420ms cubic-bezier(0.05, 0.7, 0.1, 1) backwards;
    transition:
      background var(--dur-base) ease,
      border-color var(--dur-base) ease;
    cursor: pointer;
    margin: 0.55rem auto 0;
    border: 1.5px solid var(--nm-keep);
    border-radius: 999px;
    background: var(--nm-keep-fill);
    padding: 0.42rem 1.1rem;
    color: var(--nm-text);
    font-size: 0.9rem;
  }

  .nm-tray-send:hover,
  .nm-tray-send:focus-visible {
    background: color-mix(in srgb, var(--nm-keep) 26%, transparent);
  }

  /* Devanagari numerals. Free, and unmistakably Nepali. */
  /* १ २ ३ — the only thing in an empty slot, so it has to carry it. At 0.55
     opacity on the soft token they read as smudges rather than as an invitation
     to fill something. Devanagari also needs the looser line-height: matras sit
     above the baseline and clip at 1.0. */
  .nm-slot-ord {
    opacity: 0.75;
    color: var(--nm-text-soft);
    font-size: 1.45rem;
    line-height: 1.7;
    font-family: var(--font-deva), var(--font-body);
  }

  /* Apple's Breathe band is 6–15s per breath, and above ~2% scale it stops
     reading as life and starts reading as movement. It stops the moment the
     slot is filled — see also [data-calm], which suspends it while the
     composer is in use. */
  @keyframes nm-breathe {
    0%,
    100% {
      transform: scale(1);
      opacity: 0.72;
    }

    50% {
      transform: scale(1.012);
      opacity: 1;
    }
  }

  .nm-slot:not([data-filled]) .nm-slot-empty {
    animation: nm-breathe 9s ease-in-out infinite;
  }

  .nm-slot:nth-child(2) .nm-slot-empty {
    animation-delay: 1.1s;
  }

  .nm-slot:nth-child(3) .nm-slot-empty {
    animation-delay: 2.2s;
  }

  /* Only one thing breathes at a time, and never while someone is typing. */
  .nm-shell[data-calm='true'] .nm-slot-empty {
    animation-play-state: paused;
  }

  /* The seated name, and the same object mid-flight — one class, so what
     lands is identical to what was already there and removing the flying
     copy is invisible. */
  .nm-token {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.1rem;
    min-width: 0;
    max-width: 100%;
  }

  .nm-token-deva {
    max-width: 100%;
    overflow: hidden;
    color: var(--nm-text);
    font-size: 1.2rem;
    line-height: 1.7;
    font-family: var(--font-deva), var(--font-body);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .nm-token-latin {
    color: var(--nm-text);
    font-size: 0.8rem;
    line-height: 1.4;
    font-family: var(--font-display);
  }

  /* OPAQUE, and it has to be. The slot underneath is filled the instant the
     click lands — state never waits for an animation — so a translucent copy
     shows the seated name through the flying one and the whole gesture reads
     as a rendering bug. Two stacked backgrounds put the marigold fill over an
     opaque ground in one property. */
  .nm-token--flying {
    display: flex;
    position: fixed;
    justify-content: center;
    z-index: 60;
    will-change: transform, opacity;
    margin: 0;
    box-shadow: var(--nm-shadow, none);
    border: 1.5px solid var(--nm-keep);
    border-radius: 9px;
    background: linear-gradient(var(--nm-keep-fill), var(--nm-keep-fill)), var(--nm-surface);
    pointer-events: none;
  }

  /* ── The composer: LAST IN-FLOW ITEM, never position: fixed ───────────
     A fixed element sits against the layout viewport and ends up underneath
     the iOS keyboard permanently. */
  .nm-composer {
    display: flex;
    position: relative;
    /* ABOVE THE VALLEY. It has an opaque background but no stacking position,
       so the moment a positioned canvas went in behind the shell the composer
       lost the paint order and the input vanished under the sky — a functional
       break, not a cosmetic one. The one place on this page a visitor must be
       able to see and reach cannot depend on source order. */
    z-index: 2;
    flex: 0 0 auto;
    flex-direction: column;
    gap: 0.4rem;
    border-top: 1px solid var(--nm-hair);
    background: var(--nm-surface);
    /* env(safe-area-inset-bottom) is 0 here — the site has no
       viewport-fit=cover — but written defensively so adding one later
       cannot put the composer under the home indicator. */
    padding: 0.6rem clamp(0.75rem, 2.4vw, 1.4rem) max(0.6rem, env(safe-area-inset-bottom));
  }

  .nm-composer-in {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    transition: border-color var(--dur-base) ease;
    margin: 0 auto;
    border: 1.5px solid var(--nm-hair-strong);
    border-radius: 999px;
    background: var(--nm-surface);
    padding: 0.2rem 0.2rem 0.2rem 0.9rem;
    width: 100%;
    max-width: 720px;

    &:focus-within {
      border-color: var(--crimson);
    }
  }

  .nm-composer-input {
    flex: 1 1 auto;
    border: none;
    background: none;
    padding: 0.45rem 0;
    min-width: 0;
    color: var(--nm-text);
    /* Never below 1rem — iOS Safari zooms the viewport on focus under 16px, and
       this page does not survive a zoom. */
    font-size: 1.08rem;
    line-height: 1.7;
    font-family: var(--font-deva), var(--font-body);

    &::placeholder {
      color: var(--nm-text-soft);
    }

    &:focus-visible {
      outline: none;
    }

    &:disabled {
      cursor: default;
    }
  }

  .nm-composer-go {
    display: grid;
    flex: 0 0 auto;
    place-items: center;
    transition: filter var(--dur-base) ease;
    cursor: pointer;
    border: none;
    border-radius: 999px;
    background: var(--crimson-deep);
    width: 36px;
    height: 36px;
    color: var(--on-fill);
    font-size: 1rem;

    &:hover {
      filter: brightness(1.08);
    }

    &:disabled {
      opacity: 0.45;
      cursor: default;
    }
  }

  .nm-thinking--composer {
    margin: 0 auto;
    width: 100%;
    max-width: 720px;
  }

  /* ── The send fields, as the last turn in the stream ──────────────────── */
  .nm-send {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    border: 1px solid var(--nm-hair);
    border-radius: 12px;
    background: var(--nm-surface);
    padding: var(--space-s);
  }

  .nm-send-picks {
    margin: 0;
    color: var(--nm-text);
    font-size: 1rem;
    line-height: 1.7;
    font-family: var(--font-deva), var(--font-display);
  }

  .nm-send-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: var(--space-2xs);
  }

  .nm-field {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    border: none;
    padding: 0;

    input,
    select,
    textarea {
      transition: border-color var(--dur-base) ease;
      border: 1px solid var(--nm-hair-strong);
      border-radius: 9px;
      background: var(--nm-surface-2);
      padding: 0.55rem 0.75rem;
      color: var(--nm-text);
      font-size: 0.95rem;
      line-height: 1.7;
      font-family: var(--font-deva), var(--font-body);

      &:focus-visible {
        border-color: var(--crimson);
      }
    }

    label {
      color: var(--nm-text-soft);
    }
  }

  .nm-send-go {
    align-self: flex-start;
    transition: filter var(--dur-base) ease;
    cursor: pointer;
    border: none;
    border-radius: 999px;
    background: var(--crimson-deep);
    padding: 0.45rem 1.1rem;
    color: var(--on-fill);
    font-size: 0.95rem;
    font-family: var(--font-display);

    &:hover {
      filter: brightness(1.08);
    }

    &:disabled {
      opacity: 0.5;
      cursor: default;
    }
  }

  /* ── The no-JS document ───────────────────────────────────────────────── */
  .nm-fallback {
    padding: clamp(6rem, 14vh, 8rem) 0 var(--space-3xl);
  }

  .nm-fallback-inner {
    margin: 0 auto;
    padding: 0 var(--space-l);
    max-width: 980px;
  }

  .nm-fallback-title {
    margin: 0 0 var(--space-m);
    font-size: clamp(2.4rem, 6vw, 4.25rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .nm-fallback-h2 {
    margin: var(--space-3xl) 0 var(--space-m);
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
  }

  .nm-fallback-standfirst {
    margin: 0 0 var(--space-s);
    max-width: 62ch;
    color: var(--nm-text-soft);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .nm-fallback-letters {
    margin: 0 0 var(--space-s);
    color: var(--nm-accent-text);
    line-height: 1.7;
  }

  .nm-fallback-help,
  .nm-fallback-provenance {
    margin: 0 0 var(--space-s);
    max-width: 68ch;
    color: var(--nm-text-soft);
    font-size: 0.9rem;
    line-height: 1.7;
  }

  .nm-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    margin-top: var(--space-m);
    max-width: 640px;
  }

  .nm-fallback-send {
    align-self: flex-start;
    cursor: pointer;
    border: none;
  }

  /* ── Reduced motion ───────────────────────────────────────────────────
     motion.css owns the global block and forbids per-component ones; this is
     the page-scoped exception the rebuild plan sanctions, and it is three
     rules rather than a second global. The global block already collapses
     durations to 0.01ms, so what is left here is the ambient loop, which must
     STOP rather than run 900 times faster, and the two JS-driven moves, which
     NaamApp skips outright by reading the same media query. */
  @media (prefers-reduced-motion: reduce) {
    .nm-slot .nm-slot-empty {
      opacity: 1;
      animation: none;
    }

    .nm-dealt {
      animation: none;
    }

    /* The card still ANSWERS a hover — the border and the shadow warm, which is
       how a visitor knows the whole surface is the button — it just stops
       moving. WCAG 2.3.3 is about motion, not about feedback, and taking the
       feedback away would leave the one control on the card with no hover
       state at all. */
    .nm-card,
    .nm-card:has(.nm-pick:not(:disabled)):hover,
    .nm-card:has(.nm-pick:focus-visible) {
      transform: none;
    }

    /* The ground still changes state per name kept; it stops easing into it. */
    .nm-room {
      transition: none;
    }

    /* The lamp stays LIT and stops moving — it is not hidden. An unmoving lit
       lamp is the honest still frame of a burning one, and WCAG 2.3.3 is about
       motion, not about light. The dust goes entirely: a drifting speck has no
       still frame worth keeping. */
    .nm-diyo-sway,
    .nm-diyo-inner,
    .nm-diyo-glow,
    .nm-room {
      animation: none;
    }

    .nm-diyo-glow {
      opacity: 0.9;
    }

    .nm-motes {
      display: none;
    }

    /* The thread is DRAWN, not animated away. The global block already floors
       the duration, but `backwards` would otherwise hold the connector at
       scaleY(0) for that instant and a reduced-motion visitor would see the
       mala with its cord missing between beads. */
    .nm-turn-rail::before {
      animation: none;
    }

    /* A leaf still arrives and still marks itself as yours; it stops sliding
       in to do it. The float and the parallax go entirely — depth stays, told
       by the shadows, which is the still frame of a floating thing. NaamWall
       also declines to attach the pointer listener at all under this query, so
       --px/--py are never written and `translate` never has anything to apply. */
    .nm-leaf,
    .nm-leaf[data-mine] {
      translate: none;
      animation: none;
      transition: none;
    }

    .nm-composer-in {
      animation: none;
    }

    /* The opening still arrives and still makes way; it stops travelling to do
       either. Opacity is the one channel WCAG 2.3.3 leaves open, and it is
       enough to say "this has stepped back". */
    .nm-turn,
    .nm-turn:has(.nm-said--you) {
      animation: nm-fade-in 180ms ease backwards;
    }

    .nm-shell[data-first] .nm-said,
    /* Drawn already, and still. stroke-dashoffset must be zeroed explicitly:
       killing the animation alone would leave the dasharray at 100 and the
       arrow would simply never appear. */
    .nm-doodle,
    .nm-doodle-line,
    .nm-doodle-barb {
      animation: none;
      stroke-dashoffset: 0;
    }

    .nm-said,
    .nm-turn,
    .nm-shell[data-composing] .nm-turn,
    .nm-shell[data-composing] .nm-doodle {
      transform: none;
      transition: opacity 200ms ease;
    }
  }

  /* ── Narrow ───────────────────────────────────────────────────────────── */
  @media (max-width: 599px) {
    .nm-deal {
      grid-template-columns: 1fr;
    }

    .nm-grid {
      grid-template-columns: 1fr;
    }

    .nm-index {
      margin-left: 0;
    }

    /* Every offset on the thread is derived from these three, so the rail
       narrows by re-declaring them and nothing else moves by hand.

       Narrower than the desktop rail but no longer TINY. At 16px and a 10px
       bead this was the worst version of the dotted-border problem, on the
       screen most of the family will actually open the page on. 22px costs
       about ten pixels of a 341px measure, which is a word every few lines —
       cheap for the difference between an ornament and an object. */
    .nm-turn {
      --nm-rail: 22px;
      --nm-rail-gap: 0.65rem;
      --nm-bead: 13px;
      --nm-bead-top: 7px;
    }

    /* NO ARROW HERE, AND THAT IS THE POINT OF IT.
       The doodle exists to span an empty gap between the invitation and the
       composer — on a 1280 desktop that gap is a 255px void and the gesture
       reads. At 390 there is no void: measured, the stream is 376px tall, the
       invitation overflows it and scrolls, and a 224px arrow bottom-anchored to
       that stream draws itself straight down through "6,715 names, out of the
       Vedas and the Sutras" and through the question under it. A hint that
       crosses out the words it is pointing at is worse than no hint, and on a
       phone the composer is already inches below the text it refers to.

       Hidden rather than shortened: any height at all lands on copy, because
       the copy reaches the bottom of the stream. */
    .nm-doodle {
      display: none;
    }
  }
</style>
