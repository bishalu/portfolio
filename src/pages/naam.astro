  .nm-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    border: 1px solid var(--hairline-on-ink);
    border-radius: 12px;
    background: var(--ink);
    padding: var(--space-s);
  }

  .nm-card[data-picked='true'] {
    box-shadow: var(--glow-marigold);
    border-color: var(--marigold);
  }

  .nm-card-name {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  /* Devanagari gets a fixed block so a late font swap shifts nothing. */
  .nm-deva {
    display: block;
    min-height: 2.5rem;
    color: var(--paper);
    font-size: 1.7rem;
    line-height: 2.5rem;
    font-family: var(--font-deva), var(--font-body);
  }

  .nm-deva--sm {
    min-height: 1.8rem;
    font-size: 1.15rem;
    line-height: 1.8rem;
  }

  .nm-latin {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    margin: 0;
  }

  .nm-latin-main {
    color: var(--paper);
    font-size: 1.15rem;
    font-family: var(--font-display);
  }

  .nm-latin-alt {
    color: var(--paper-soft);
    text-transform: none;
  }

  /* ── The sound rail ─────────────────────────────────────────────────── */

  /* The 26px is headroom for the swap control, which hangs above the first
     tick — so only the rows that HAVE one pay for it. Reserving it on every
     card put a band of void above two thirds of the grid. */
  .nm-rail[data-swap='true'] {
    padding-top: 26px;
  }

  /* width: max-content is what makes this an instrument rather than a divider.
     The rule used to be pinned right:0; left:0 behind a left-packed tick row,
     so it drew the same full-width gradient underline with two dots huddled at
     one end under every name on the page — 252px of line for 63px of ticks,
     identical on a one-syllable name and a three-syllable one. Ending it at the
     last tick makes its length the syllable count, which is the only reason a
     gradient is allowed here at all (DESIGN.md P4, MOTION.md §0 rule 1: motion
     and marks carry meaning or they are decoration). max-width keeps a long
     name inside its card. */
  .nm-ticks {
    display: flex;
    position: relative;
    align-items: flex-start;
    gap: clamp(0.9rem, 4vw, 1.75rem);
    margin: 0;
    padding: 0;
    width: max-content;
    max-width: 100%;
    list-style: none;

    /* DESIGN.md P4 — the gradient is a line, never a fill. */
    &::before {
      position: absolute;
      top: 4px;
      right: 0;
      left: 0;
      border-radius: 999px;
      background: var(--grad-signal);
      height: 2px;
      content: '';
    }
  }

  .nm-tick {
    display: flex;
    position: relative;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
  }

  .nm-tick-dot {
    display: block;
    border-radius: 999px;
    background: var(--paper);
    width: 10px;
    height: 10px;
  }

  .nm-tick-syllable {
    color: var(--paper-soft);
    text-transform: uppercase;
  }

  /* The document's own `!` — a harder consonant cluster, marked on the
     syllable whose onset carries it. */
  .nm-tick[data-cluster='true'] .nm-tick-dot {
    box-shadow: var(--ring-crimson);
    background: var(--crimson);
  }

  .nm-tick[data-cluster='true'] .nm-tick-syllable {
    color: var(--crimson-text);
  }

  /* The swap sits on the first tick because that is the syllable it changes.
     A wrapper carries the centring so the global hover translateY() cannot
     clobber it. */
  .nm-swap-slot {
    position: absolute;
    bottom: calc(100% + 6px);
    left: 50%;
    transform: translateX(-50%);
  }

  .nm-swap {
    transition:
      border-color var(--dur-base) ease,
      color var(--dur-base) ease;
    cursor: pointer;
    border: 1px solid var(--hairline-on-ink);
    border-radius: 999px;
    background: var(--ink-2);
    padding: 0.15rem 0.5rem;
    color: var(--paper-soft);
    white-space: nowrap;

    &[aria-pressed='true'] {
      border-color: var(--crimson);
      color: var(--paper);
    }

    &:disabled {
      opacity: 0.55;
      cursor: default;
    }
  }

  /* Ours: Atkinson, bone. The site is speaking. */
  /* The document is speaking, and P5 says mono is the voice of data. Same size
     as body copy — this is not a third label size — and deliberately NOT
     .label-mono: §3 assigns uppercase to labels, and a 60-character quotation
     set in caps is unreadable.

     Clamped to three lines. Monier-Williams glosses run from four characters
     ("sun") to four hundred, and in a three-column grid every row stretches to
     its tallest card: one plant-taxonomy entry left 200px of dead space beside
     it. The full text is one tap away in the disclosure directly below, so
     nothing is lost by clamping — and the grid stops looking broken. */
  .nm-gloss,
  .nm-source-gloss {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    color: var(--paper-soft);
    font-size: 0.95rem;
    line-height: 1.6;
    font-family: var(--font-deva), var(--font-mono);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  /* Inside the disclosure there is no grid to keep even, so let it run. */
  .nm-source-gloss {
    display: block;
    overflow: visible;
  }

  .nm-undocumented,
  .nm-reasons {
    margin: 0;
    color: var(--paper-soft);
  }

  .nm-card-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs) var(--space-s);
    margin-top: auto;
    padding-top: var(--space-2xs);
  }

  /* Sizing only. The labeling voice comes from .label-mono, which every
     mono-labelled control on this page now wears rather than re-declaring its
     own font-size / family / tracking / transform triple (DESIGN.md §3 — two
     mono sizes, and improvising a third is how a labeling system dies). */
  .nm-pick {
    transition: border-color var(--dur-base) ease;
    cursor: pointer;
    border: 1px solid var(--hairline-on-ink);
    border-radius: 999px;
    background: transparent;
    padding: 0.32rem 0.9rem;
    color: var(--paper);

    /* DESIGN.md P2 — emphasis by glow, never by a second fill. Marigold
       marks the honoured one. */
    &[aria-pressed='true'] {
      box-shadow: var(--glow-marigold);
      border-color: var(--marigold);
      color: var(--marigold);
    }

    &:disabled {
      opacity: 0.5;
      cursor: default;
    }
  }

  /* Everything below this line in a card is the document's, verbatim. */
  .nm-source {
    summary {
      cursor: pointer;
      color: var(--paper-soft);
    }

    summary:hover {
      color: var(--marigold);
    }
  }

  .nm-source-body {
    margin-top: var(--space-2xs);
    border-left: 1px solid var(--hairline-on-ink);
    padding-left: var(--space-2xs);
  }

  .nm-source-gloss {
    margin: 0 0 0.35rem;
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .nm-source-meta,
  .nm-source-note {
    opacity: 0.8;
    margin: 0;
    color: var(--paper-soft);
  }

  /* ── The guide island ───────────────────────────────────────────────── */
  .nm-guide {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
  }

  /* Capped at a measure, not stretched to the column. At 1024 and up the page
     column is ~900px and a six-option question only ever fills ~360px of it, so
     a full-width panel put three small chips in the top-left corner of a wide
     empty box. Capping the panel makes it read as one focused object — which is
     the whole point of asking one question at a time — and it keeps the panel's
     left edge aligned with the h1 above it rather than centring it into a
     second, competing axis. */
  .nm-panel {
    border: 1px solid var(--hairline-on-ink);
    border-radius: 14px;
    background: var(--ink);
    padding: var(--space-m);
    max-width: 46rem;
  }

  .nm-step-count {
    margin: 0 0 var(--space-2xs);
    color: var(--crimson-text);
  }

  .nm-step-label {
    margin-bottom: 0.35rem;
  }

  .nm-step-helper {
    margin: 0 0 var(--space-s);
    color: var(--paper-soft);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .nm-opts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }

  .nm-opt {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    transition: border-color var(--dur-base) ease;
    cursor: pointer;
    border: 1px solid var(--hairline-on-ink);
    border-radius: 10px;
    background: var(--ink-2);
    padding: 0.5rem 0.8rem;
    color: var(--paper);
    text-align: left;

    &[aria-pressed='true'] {
      box-shadow: var(--ring-crimson);
      border-color: var(--crimson);
    }

    &:disabled {
      opacity: 0.45;
      cursor: default;
    }
  }

  .nm-opt-label {
    font-size: 0.92rem;
  }

  /* Prose. "The smallest set in the document by a long way." is a sentence
     with a verb, not a label, so it is set in the body face — §3 assigns mono
     to labels, eyebrows and metadata, and a note is none of those. */
  .nm-opt-note {
    color: var(--paper-soft);
    font-size: 0.82rem;
    line-height: 1.5;
    font-family: var(--font-deva), var(--font-body);
  }

  .nm-step-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-s);
    margin-top: var(--space-m);
  }

  /* A quiet text link that happens to be a <button>. Body face, because these
     are sentences and half-sentences ("Change an answer", "what does Bhaskara
     mean"), not labels. */
  .nm-quiet {
    cursor: pointer;
    border: none;
    background: none;
    padding: 0;
    color: var(--crimson-text);
    font-size: 0.92rem;
    font-family: var(--font-deva), var(--font-body);
    text-align: left;

    &:hover {
      color: var(--marigold);
    }

    &:disabled {
      opacity: 0.5;
      cursor: default;
    }
  }

  .nm-next {
    transition: border-color var(--dur-base) ease;
    cursor: pointer;
    border: 1px solid var(--crimson);
    border-radius: 999px;
    background: transparent;
    padding: 0.4rem 1.1rem;
    color: var(--paper);

    &:hover {
      box-shadow: var(--glow-crimson);
    }

    &:disabled {
      opacity: 0.5;
      cursor: default;
    }
  }

  /* ── The ask ────────────────────────────────────────────────────────── */
  .nm-ask-label {
    display: block;
    margin-bottom: 0.3rem;
    color: var(--crimson-text);
  }

  .nm-ask-hint {
    margin: 0 0 var(--space-s);
    color: var(--paper-soft);
    font-size: 0.9rem;
  }

  .nm-ask-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }

  /* border-color on :focus-visible, never `outline: none`. The three
     `outline: none` declarations this page used to carry beat the global
     :focus-visible rule in motion.css on specificity, so the only remaining
     indicator on six controls was a legacy WHITE 2px box-shadow from
     _general.scss — on a page whose focus colour is crimson. They were also on
     :focus rather than :focus-visible, which merges focus into hover, and
     MOTION.md §2 forbids that by name. */
  .nm-ask-input {
    flex: 1 1 260px;
    transition: border-color var(--dur-base) ease;
    border: 1px solid var(--hairline-on-ink);
    border-radius: 10px;
    background: var(--ink-2);
    padding: 0.6rem 0.85rem;
    color: var(--paper);
    font-size: 0.95rem;
    font-family: var(--font-deva), var(--font-body);

    &:focus-visible {
      border-color: var(--crimson);
    }

    &:disabled {
      opacity: 0.55;
      cursor: default;
    }
  }

  /* .btn-pill carries the fill, the padding and the label voice — the one
     filled CTA in the system (DESIGN.md P2, tailwind.css:96). This used to
     re-declare all of it from scratch, which is the fifth independent copy of
     a rule that exists because the first four drifted. */
  .nm-ask-go {
    cursor: pointer;
    border: none;

    &:disabled {
      opacity: 0.5;
      cursor: default;
    }
  }

  .nm-ask-examples {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-s);
    margin: var(--space-s) 0 0;
    padding: 0;
    list-style: none;
  }

  /* .nm-status carries full sentences — "The model did not answer, so these
     are the document's own best matches." — so it is prose, not a label. The
     LIVE / LOCAL badge beside the results is the label; this is the caption
     that explains it. .nm-browse-status is a bare count and keeps .label-mono. */
  .nm-status {
    margin: 0;
    max-width: 62ch;
    min-height: 1.2rem;
    color: var(--paper-soft);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .nm-browse-status {
    margin: 0;
    min-height: 1.2rem;
    color: var(--paper-soft);
  }

  .nm-loading {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: var(--space-s);
  }

  .nm-ask-log {
    min-height: 0;
  }

  .nm-reply {
    margin: 0;
    border-left: 2px solid var(--crimson);
    padding-left: var(--space-s);
    max-width: 62ch;
    color: var(--paper);
    font-size: 1rem;
    line-height: 1.7;
  }

  /* ── Results ────────────────────────────────────────────────────────── */
  .nm-results-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-s);
  }

  /* One declared sub-scale for every panel heading on the page. There were
     three h2 sizes plus a 12px one; the section triple stays where DESIGN.md
     §1 P5 fixes it and everything below it uses this. */
  .nm-panel-title {
    margin: 0;
    color: var(--paper);
    font-size: clamp(1.2rem, 2.4vw, 1.55rem);
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  /* DESIGN.md §4 — two of the three words, and never a fourth. */
  .nm-badge {
    border: 1px solid var(--hairline-on-ink);
    border-radius: 999px;
    padding: 0.15rem 0.6rem;
    color: var(--paper-soft);
  }

  .nm-badge[data-source='live'] {
    border-color: var(--glacier);
    color: var(--glacier-text);
  }

  /* ── The tray ───────────────────────────────────────────────────────── */
  .nm-tray {
    border-top: 1px solid var(--hairline-on-ink);
    padding-top: var(--space-s);
  }

  .nm-tray-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-s);
  }

  .nm-tray-count {
    color: var(--paper-soft);
  }

  .nm-tray-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
