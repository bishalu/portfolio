---
/**
 * /naam — a family asking for help naming their son, as an app.
 * Spec: docs/design/DESIGN.md (Alpenglow) · docs/design/MOTION.md.
 *
 * WHY THIS PAGE IS A SHELL AND NOT A DOCUMENT. It used to be a long editorial
 * page: hero, wizard, shortlist, a 2,098-row browser, a form, a wall. It
 * worked and it passed every gate, but it was a document *about* naming rather
 * than an instrument *for* naming. This is one screen — rail, stream, three
 * slots, composer — and the page's only job now is to hand the viewport to
 * NaamApp.tsx and get out of the way.
 *
 * WHY IT IS LIGHT. DESIGN.md P1 reads "one world, three depths, zero themes".
 * This page breaks it deliberately and the exception is scoped so tightly it
 * cannot leak: every light token is declared on #naam-app, never on :root, so
 * no other route can inherit one and the site keeps `color-scheme: dark`. The
 * ACCENTS DO NOT CHANGE — crimson and marigold carry over from the dark site
 * untouched, only the ground flips. Same family, different room. Contrast was
 * recomputed from scratch against the light ground rather than inherited; see
 * the token block below, which records the ratio for every pairing that
 * carries text.
 *
 * WHY THE SHELL RULES ARE ALL UNDER html:not(.no-js). With JavaScript off the
 * app is display:none and this is an ordinary scrolling document again — the
 * .nm-fallback below, which is server-rendered into the NORMAL DOM rather than
 * into a <noscript>. Two reasons that matters: axe and Lighthouse both run
 * with JavaScript enabled and would never see a <noscript>, so it would ship
 * behind a gate that structurally cannot check it; and the app-shell CSS still
 * applies with JS off, which would lay the fallback out inside a clipped
 * 100svh box and leave it unreachable.
 *
 * WHY prerender STAYS TRUE: the readFileSync below only works at build time.
 * Under SSR it throws on Netlify.
 *
 * WHY THE STYLES ARE HERE AND is:global: island CSS cannot live in
 * _widgets.scss, which is inside the global bundle every route pays for; a
 * page style block is chunked per page in Astro 5. is:global is required
 * because Astro's scoping never reaches React-rendered DOM. Every class is
 * .nm-* so it cannot collide with anything.
 *
 * The PDF is untracked and this repo is public, so page numbers are cited as
 * text and the document itself is not served.
 */
import { readFileSync } from 'node:fs'
import { resolve } from 'node:path'
import DefaultLayout from '@layouts/DefaultLayout.astro'
import NaamApp from '@components/NaamApp.tsx'
import NaamCard from '@components/NaamCard.tsx'
import { NAAM_COPY, NAAM_RELATIONS } from '@/lib/naam/copy'
import { NAAM_SEED_DOCUMENTED } from '@/lib/naam/seeds'
import { NAAM_FEATURED, NAAM_PROVENANCE } from '@/generated/naam-facts'
import { isNaamGold, type NaamLetter, type NaamRow } from '@/types/naam'

export const prerender = true

const C = NAAM_COPY

/**
 * Read at build time, not imported: a 1.1 MB JSON import would hand tsc a
 * 2,097-element literal to infer and drag the whole dataset into the server
 * bundle. This runs at prerender time only, off the project root — resolving
 * against import.meta.url would land in the adapter's build directory. The
 * browser fetches the same file on mount (src/lib/naam/tray.ts).
 */
const rows = JSON.parse(readFileSync(resolve(process.cwd(), 'public/naam/names-core.json'), 'utf8')) as NaamRow[]
const byId = new Map(rows.map((row) => [row.id, row]))

/**
 * The no-JS shortlist. FOUR per letter, not twelve: this is the fallback, not
 * the page, and the app's TBT budget is 200ms — every card here is DOM that
 * the app's own visitors download, parse and then never see.
 */
const PER_LETTER = 4
const LETTERS: NaamLetter[] = ['B', 'S', 'V']

const fallbackRows = LETTERS.flatMap((letter) => {
  const featured = NAAM_FEATURED.map((id) => byId.get(id)).filter(
    (row): row is NaamRow => row !== undefined && row.letter === letter,
  )
  const taken = new Set(featured.map((row) => row.id))
  const gold = rows.filter(
    (row) => row.letter === letter && isNaamGold(row) && !row.badges.hardCluster && !taken.has(row.id),
  )
  return [...featured, ...gold].slice(0, PER_LETTER)
})

/**
 * Byan is a real row — Vyan / Byan, p.120 — so the family strip can render it
 * with its own Devanagari and its working व/ब spelling. It is also the seed
 * that silently vanished once: the document files it under "More", this page
 * reads only names-core.json, and `byId.get('vyan')` returned undefined with
 * no error and no gap in the layout. scripts/naam/build-dataset.mjs now forces
 * it into core (CORE_EXTRA_IDS); this throws rather than shrugging if that
 * ever stops being true.
 */
const seedRow = byId.get(NAAM_SEED_DOCUMENTED.id)
if (!seedRow) {
  throw new Error(
    `/naam: the documented seed '${NAAM_SEED_DOCUMENTED.id}' is not in public/naam/names-core.json. ` +
      'Add it to CORE_EXTRA_IDS in scripts/naam/build-dataset.mjs and re-run `npm run naam:build`.',
  )
}
---

<DefaultLayout title={C.meta.title} description={C.meta.description} appShell>
  <!-- noindex: this page exists for people who are sent the link. Search
       discovery adds nothing to that job, and the page carries a child's
       candidate names plus a public wall of what visitors typed. `follow` stays
       on so the links back into the site still count. Remove this line and the
       /naam clause in astro.config.mjs's sitemap filter to list it again. -->
  <meta slot="head" name="robots" content="noindex, follow" />
  <link slot="head" rel="preload" href="/fonts/Mukta-Devanagari-400.woff2" as="font" type="font/woff2" crossorigin />
  <!-- No preload for names-core.json, deliberately. `as="fetch"` preloads in
       CORS mode, but tray.ts fetches same-origin with default credentials, so
       the two never match: Chrome downloaded the file twice and logged
       "preload ... not used because the request credentials mode does not
       match" plus an unused-preload warning — two console problems against a
       zero-console gate, in exchange for a slower load. Matching them would
       mean crossorigin here AND credentials:'omit' there, which is a lot of
       coupling for one hop. The interactivity fix that actually mattered was
       moving the fetch off onIdle() and into the mount effect; that stands. -->

  <div id="naam-app" class="nm nm-app">
    <NaamApp seed={seedRow} client:load />
  </div>

  <!-- The no-JS half, in the normal DOM. Field names match
       public/__forms.html byte-for-byte or Netlify discards the submission
       silently, and every label wraps its control rather than pairing by id —
       so nothing here can collide with the app's own nma-* ids. -->
  <div class="nm nm-fallback">
    <div class="nm-fallback-inner">
      <h1 class="nm-fallback-title">{C.hero.headline}</h1>
      <p class="nm-fallback-standfirst">{C.hero.standfirst}</p>
      <p class="nm-fallback-standfirst">{C.noscript}</p>
      <p class="nm-fallback-letters">{C.hero.letters}</p>

      <h2 class="nm-fallback-h2">{C.shortlist.heading}</h2>
      <div class="nm-grid">
        {fallbackRows.map((row) => <NaamCard row={row} preferB={true} />)}
      </div>

      <h2 class="nm-fallback-h2">{C.form.heading}</h2>
      <p class="nm-fallback-standfirst">{C.form.standfirst}</p>

      <form
        class="nm-form"
        name="naam-suggestion"
        method="POST"
        action="/thank-you"
        data-netlify="true"
        netlify-honeypot="bot-field"
      >
        <input type="hidden" name="form-name" value="naam-suggestion" />
        <p hidden>
          <label>bot-field<input name="bot-field" tabindex="-1" autocomplete="off" /></label>
        </p>

        <label class="nm-field">
          <span class="label-mono">{C.form.name.label}</span>
          <input type="text" name="from" required maxlength={C.limits.name} autocomplete="name" />
        </label>

        <label class="nm-field">
          <span class="label-mono">{C.form.relation.label}</span>
          <select name="relation" required>
            <option value="">{C.form.relation.placeholder}</option>
            {NAAM_RELATIONS.map((relation) => <option value={relation}>{relation}</option>)}
          </select>
        </label>

        <label class="nm-field">
          <span class="label-mono">{C.form.names.label}</span>
          <input
            type="text"
            name="names"
            maxlength={C.limits.names}
            autocomplete="off"
            placeholder={C.form.names.placeholder}
          />
        </label>
        <p class="nm-fallback-help">{C.form.names.helper}</p>

        <label class="nm-field">
          <span class="label-mono">{C.form.reason.label}</span>
          <textarea name="reason" rows="3" maxlength={C.limits.reason}></textarea>
        </label>

        <!-- The tray is a JavaScript thing, so with JS off this is empty and
             the free-text field above is what carries a name. It is registered
             in public/__forms.html and must be posted either way. -->
        <input type="hidden" name="picks" value="[]" />

        <button type="submit" class="btn-pill nm-fallback-send">{C.form.submit}</button>
      </form>

      <p class="nm-fallback-provenance">{NAAM_PROVENANCE}</p>
      <p class="label-mono label-mono--sm nm-fallback-provenance">{C.card.devanagariNote}</p>
      <p class="nm-fallback-provenance">{C.hero.nwaran}</p>
    </div>
  </div>
</DefaultLayout>

<style lang="scss" is:global>
  /* ═══════════════════════════════════════════════════════════════════════
     /naam — page-scoped, is:global because Astro's scoping does not reach
     React-rendered DOM. Every class is .nm-* .
     Tokens: docs/design/DESIGN.md §1 (P1, P3), src/styles/tokens.css.
     ═══════════════════════════════════════════════════════════════════════ */

  /* One new script, not one new role (DESIGN.md P5). Mukta covers Devanagari
     and nothing else, so Bricolage and Atkinson keep every Latin role they
     already have. font-display: optional, never swap — swap is a CLS
     generator and the CLS floor is 0. U+200C-200D must stay in the range or
     conjuncts and half-forms stop rendering. */
  @font-face {
    font-style: normal;
    font-weight: 400;
    src: url('/fonts/Mukta-Devanagari-400.woff2') format('woff2');
    font-family: 'Mukta';
    font-display: optional;
    unicode-range: U+0900-097F, U+200C-200D, U+20A8, U+25CC, U+A830-A839;
  }

  /* The system fallback, restricted to the same range by the same mechanism.
     A bare 'Noto Sans Devanagari' in the stack would also serve Latin, and
     would beat Atkinson to it — this way both Devanagari faces can only ever
     answer for Devanagari. */
  @font-face {
    font-style: normal;
    font-weight: 400;
    src: local('Noto Sans Devanagari'), local('Nirmala UI'), local('Mangal'), local('Kohinoor Devanagari');
    font-family: 'Naam Deva Fallback';
    font-display: optional;
    unicode-range: U+0900-097F, U+200C-200D;
  }

  /* ── The shell, and the one blocker it exists to defeat ───────────────
     tailwind.css sets `body { min-height: 100vh }`. 100vh is the LARGE
     viewport, so on iOS Safari with the URL bar showing the body is 60–110px
     taller than what is visible and the document scrolls by exactly the
     chrome height — even with every child at 100svh and the footer gone.
     `min-height: 0` is what kills it.

     100svh, never dvh: dvh tracks a viewport that on this page never changes,
     so it can only ever introduce jumps. --kb-inset is written by NaamApp
     from visualViewport, because iOS does not resize the layout viewport for
     the soft keyboard (Android does, via interactive-widget=resizes-content
     in the layout's viewport meta).

     Every rule is scoped under html:not(.no-js): with JavaScript off this is
     an ordinary document again. ─────────────────────────────────────────── */
  html:not(.no-js) body[data-app] {
    height: calc(100svh - var(--kb-inset, 0px));
    min-height: 0;
    overflow: clip;
    overscroll-behavior: none;
  }

  /* min-height: 0 is the one everyone forgets: a column flex item's
     min-height is `auto`, which floors it at content height and makes
     flex-shrink silently do nothing. */
  html:not(.no-js) body[data-app] > main {
    flex: 1 1 0;
    min-height: 0;
    overflow: clip;
  }

  html:not(.no-js) body[data-app] > footer {
    display: none;
  }

  /* Do not subtract the header — put it in flow. No token, no calc(), no
     ResizeObserver, and the mobile-nav-open case then solves itself: the menu
     grows the header, main shrinks, the app reflows instead of being
     overlapped. */
  html:not(.no-js) body[data-app] #site-header {
    position: sticky;
    flex: 0 0 auto;
  }

  /* #naam-app, not .nm-app. The light tokens and the flex column are declared
     on the ID (1,0,0), so `html.no-js .nm-app` (0,2,1) lost the cascade and a
     visitor with JavaScript off got the dead app stacked on top of the working
     fallback. Matching the ID here makes it (1,1,1) and it wins. */
  html.no-js #naam-app {
    display: none;
  }

  html:not(.no-js) .nm-fallback {
    display: none;
  }

  /* ── Roles, and the ground under them ─────────────────────────────────
     .nm is both surfaces' root because --font-deva is declared here and
     consumed in a dozen places; rename it and every Devanagari glyph silently
     becomes tofu. The --nm-* roles resolve to the site's dark tokens by
     default, which is what the no-JS fallback is rendered on, and are
     REDECLARED on #naam-app for the light app. One card component, one set of
     rules, two grounds. ──────────────────────────────────────────────────── */
  .nm {
    /* Both members are unicode-range-restricted, so this prefix can be put in
       front of any role stack without touching a single Latin glyph. */
    --font-deva: 'Mukta', 'Naam Deva Fallback';
    --nm-canvas: var(--void);
    --nm-surface: var(--ink);
    --nm-surface-2: var(--ink-2);
    --nm-text: var(--paper);
    --nm-text-soft: var(--paper-soft);
    --nm-hair: var(--hairline-on-ink);
    --nm-hair-strong: var(--hairline-strong);
    --nm-accent-text: var(--crimson-text);
    --nm-keep: var(--marigold);
    /* Mixed from the token rather than restated as a literal: the fill and the
       mark have to be the same hue, and they stopped being so the moment
       --marigold was re-chosen for a light ground. 14% of the old marigold on
       bone was also invisible. */
    --nm-keep-fill: color-mix(in srgb, var(--marigold) 18%, transparent);
    --nm-live: var(--glacier);
    /* THE BASE OF THE FLAME, declared here beside the wall's paper and for the
       same reason: fire is not a different colour in a different room, so
       #naam-app does not override it. Mixed rather than picked — the page owns
       exactly two warm tokens and an ember is where they meet.

       It replaces `var(--nm-accent)`, which NaamDiyo's gradient read and which
       is declared nowhere on this site; only --nm-accent-text exists. An
       unresolvable var() in stop-color is invalid at computed-value time, so it
       fell back to that property's initial value — BLACK — and the flame burned
       from a black base. At 62px that reads as shadow around the wick, which is
       precisely why it survived a review that was looking at the lamp. */
    --nm-ember: color-mix(in srgb, var(--crimson) 55%, var(--marigold) 45%);

    /* THE WALL'S PAPER, and it is declared on .nm rather than on #naam-app on
       purpose: a note is a piece of paper, and paper does not change colour
       because the room it is in is dark. These three are the only colours on
       this page that do not resolve differently between the two grounds.
       Post-it yellow is #f6e27a — never #ffff00, which is a highlighter — and
       the ink is #2b2a26, never black. Contrast, measured on the note itself:
         #2b2a26 on #f6e27a   11.0:1   the Devanagari and the Latin
         the 76% mix          5.6:1    the signature, which is small text
       Both clear AA at the sizes used, which is why the signature can be a mono
       micro-label without becoming a decorative smudge. */
    --nm-note: #f6e27a;
    --nm-note-ink: #2b2a26;
    --nm-note-ink-soft: color-mix(in srgb, var(--nm-note-ink) 76%, var(--nm-note));

    /* Mukta is FIRST in every stack on this page and that is safe: its
       @font-face carries a unicode-range, so it can only ever supply
       Devanagari and every Latin glyph falls straight through to Bricolage,
       Atkinson or DM Mono. Without this, any Devanagari outside .nm-deva —
       a starter chip, the व/ब control, a name inside a reason — renders as
       tofu, and shipping boxes is worse than shipping no Devanagari at all. */
    font-family: var(--font-deva), var(--font-body);
  }

  .nm h1,
  .nm h2,
  .nm h3 {
    font-family: var(--font-deva), var(--font-display);
  }

  .nm .label-mono,
  .nm .pulse-caption {
    font-family: var(--font-deva), var(--font-mono);
  }

  /* ── THE ONE SANCTIONED LIGHT SURFACE ─────────────────────────────────
     Declared here and nowhere else. Cool stone with hot marigold and crimson
     on top is how Nepali festival colour actually reads — bright warm objects
     against grey sky and stone — and it is deliberately NOT warm cream with
     terracotta, which is the most common machine-generated light palette in
     circulation and would make this page look like every other AI-designed
     page rather than like Nepal.

     CONTRAST, recomputed from scratch against the light ground. The dark-mode
     ratios carry no information here:
       ink   #1A1D2E on rice  16.0:1   body text
       ink/65%        on rice  5.1:1   secondary text (4.6:1 on sky)
       crimson-deep   on rice  5.7:1   the accent that carries text
       crimson        on rice  4.2:1   focus ring and borders only — NOT text
       marigold       on rice  ~2:1    FILL AND BORDER ONLY, never type
       glacier        on rice  2.7:1   the live dot and its border, never type
     ────────────────────────────────────────────────────────────────────── */
  #naam-app {
    --naam-sky: #edeff2;
    --naam-rice: #fafaf8;
    --naam-ink: #1a1d2e;
    --nm-canvas: var(--naam-sky);
    --nm-surface: var(--naam-rice);
    --nm-surface-2: #f1f3f6;
    --nm-text: var(--naam-ink);
    --nm-text-soft: rgb(26 29 46 / 65%);
    --nm-hair: rgb(26 29 46 / 13%);
    --nm-hair-strong: rgb(26 29 46 / 26%);
    --nm-accent-text: var(--crimson-deep);
    --nm-keep-fill: color-mix(in srgb, var(--marigold) 20%, transparent);
    --nm-shadow: 0 1px 2px rgb(26 29 46 / 5%), 0 10px 24px -16px rgb(26 29 46 / 30%);

    display: flex;
    flex-direction: column;
    background: var(--nm-canvas);
    height: 100%;
    color: var(--nm-text);
  }

  .nm-shell {
    display: flex;
    position: relative;
    flex: 1 1 0;
    flex-direction: column;
    min-height: 0;
  }

  /* ── THE THREAD AND THE PLATE ─────────────────────────────────────────
     Two columns from 1100px, and the split is not a way to use up width — it
     is the only arrangement in which the agent can lead.

     Stacked, an arriving hand of cards is ~370px of a 439px stream, so the
     model's sentence was pushed above the fold the instant it was answered
     (measured: top:-180 at 1280×800, -581 at 390). Reply + line + cards is
     506px of content and no scroll offset fits that into 439.

     The two columns are also two different KINDS of thing, which is why this
     reads as a room rather than as a sidebar. The left is a thread — a mala,
     turns strung in the order they happened, and you pass along it. The right
     is a plate — a thali, where what is being weighed is laid out and three of
     it is chosen. Words go on the thread; names go on the plate. The lamp
     stands at the foot of the plate and lights it, so the two halves sit at
     different temperatures: the conversation stays cool paper, the offering is
     warm. That is the whole of the separation — there is no rule between them,
     because a hairline would say "two panels" where the light already says
     "one room, lit from over here".

     Below 1100 it stacks back and the hand becomes a band you swipe. */
  @media (min-width: 1100px) {
    .nm-shell {
      display: grid;
      grid-template-rows: auto minmax(0, 1fr) auto;
      /* The plate is sized from the CARD, not from the leftovers. Three cards
         plus the gaps and the tray's padding need ~700px before a gloss stops
         breaking mid-phrase — at 46vw the cards came out 180px and "to shine,
         be bright" wrapped to two lines while "from the document" broke across
         two more. 56vw gives ~218px each at 1280 and the thread still keeps
         ~560px, which is a comfortable measure for prose and more than the
         invitation was getting when it had the whole width. */
      grid-template-columns: minmax(0, 1fr) clamp(31rem, 56vw, 46rem);
      grid-template-areas:
        'top top'
        'stream tray'
        'composer composer';
    }

    .nm-topbar {
      grid-area: top;
    }

    .nm-streamwrap {
      grid-area: stream;
      min-height: 0;
    }

    .nm-tray {
      grid-area: tray;
      justify-content: center;
      min-height: 0;
      overflow: clip;
    }

    .nm-composer {
      grid-area: composer;
    }

    /* The lamp moved into the right column, so its light moves with it.
       Leaving the pool at 50% would light the room from a point the lamp
       visibly is not — the same lie this page already fixed once vertically. */
    .nm-room {
      background:
        radial-gradient(58% 52% at 78% 84%, color-mix(in srgb, var(--nm-keep) 17%, transparent) 0%, transparent 70%),
        radial-gradient(105% 64% at 78% 100%, color-mix(in srgb, var(--nm-keep) 8%, transparent) 0%, transparent 62%);
    }
  }

  /* ── The lamp, and the room it lights ─────────────────────────────────
     The page used to be inert between clicks, which is the whole reason it
     read as a document rather than as something you were inside. One element
     is now always alive, and it is a light source rather than a decoration —
     so the ground is LIT instead of painted, which is what games do and what
     a flat hex fill can never do.

     The flicker must not look like a loop. Two animations run at deliberately
     incommensurate periods (2.3s and 3.7s); a single sine reads as CSS, two
     out of phase read as fire. The ground rides the same clock at a fifth of
     the amplitude, so the paper breathes without anyone noticing why. */

  /* The pool is centred ON the lamp — which sits low, with the tray — and
     throws its light UPWARD across the conversation. It was at 50% 34% while
     the lamp was at 3% 6%, and a room lit from somewhere the light source
     visibly is not is a thing the eye catches even when it cannot say why. */
  .nm-room {
    position: absolute;
    z-index: 0;
    animation: nm-room-breathe 3.7s ease-in-out infinite;
    inset: 0;
    background:
      radial-gradient(78% 58% at 50% 88%, color-mix(in srgb, var(--nm-keep) 15%, transparent) 0%, transparent 70%),
      radial-gradient(140% 70% at 50% 100%, color-mix(in srgb, var(--nm-keep) 7%, transparent) 0%, transparent 62%);
    pointer-events: none;
  }

  /* Dust in the lamplight — the ambient-particle technique without confetti,
     and what a real butter lamp actually looks like. Suspended while typing
     ([data-calm]) because it is the part that can pull the eye; the flame is
     not, because a lamp that goes out when you start writing is worse than one
     that flickers beside you. */
  .nm-motes {
    position: absolute;
    opacity: 0.5;
    z-index: 0;
    inset: 0;
    pointer-events: none;
  }

  .nm-mote {
    position: absolute;
    animation: nm-mote-drift linear infinite;
    border-radius: 50%;
    background: color-mix(in srgb, var(--nm-keep) 55%, transparent);
    width: 2px;
    height: 2px;
  }

  .nm[data-calm='true'] .nm-motes {
    opacity: 0;
    transition: opacity 600ms ease;
  }

  @keyframes nm-room-breathe {
    0%,
    100% {
      opacity: 0.86;
    }
    50% {
      opacity: 1;
    }
  }

  @keyframes nm-mote-drift {
    0% {
      transform: translate3d(0, 0, 0);
      opacity: 0;
    }
    18% {
      opacity: 0.7;
    }
    82% {
      opacity: 0.5;
    }
    100% {
      transform: translate3d(14px, -190px, 0);
      opacity: 0;
    }
  }

  .nm-diyo {
    position: relative;
    flex-shrink: 0;
    z-index: 1;
    line-height: 0;
  }

  /* transform STRING, not individual properties: individual transforms animate
     CSS variables and are not composited. */
  .nm-diyo-sway {
    transform-origin: 22px 30px;
    animation: nm-flame-sway 3.7s ease-in-out infinite;
  }

  .nm-diyo-inner {
    transform-origin: 22px 24px;
    animation: nm-flame-gutter 2.3s ease-in-out infinite;
  }

  .nm-diyo-glow {
    animation: nm-flame-glow 2.3s ease-in-out infinite;
  }

  /* Three stops, not two, and roughly double the amplitude of the first
     attempt. Two stops make a pendulum — the eye predicts it instantly and it
     reads as a CSS animation. A third stop off-centre breaks the symmetry, and
     because the gutter beneath runs at 2.3s against this 3.7s, the pair never
     lands in the same relative phase twice inside a sitting. */
  @keyframes nm-flame-sway {
    0%,
    100% {
      transform: rotate(-3deg) scaleY(0.97);
    }
    38% {
      transform: rotate(2.2deg) scaleY(1.06);
    }
    64% {
      transform: rotate(-0.8deg) scaleY(1.01);
    }
  }

  @keyframes nm-flame-gutter {
    0%,
    100% {
      transform: scale(1) translateY(0);
    }
    40% {
      transform: scale(0.9) translateY(1px);
    }
    70% {
      transform: scale(1.06) translateY(-1px);
    }
  }

  @keyframes nm-flame-glow {
    0%,
    100% {
      opacity: 0.8;
    }
    45% {
      opacity: 1;
    }
  }

  /* Thinking: the flame narrows and leans. This IS the loading state — there
     is no separate spinner and no pulse-line while the lamp can say it. */
  .nm-diyo[data-state='thinking'] .nm-diyo-sway {
    transform-origin: 22px 32px;
    animation-duration: 1.15s;
  }

  .nm-diyo[data-state='thinking'] .nm-diyo-inner {
    animation-duration: 0.7s;
  }

  /* A name lands: the flame flares once and settles. */
  .nm-diyo[data-state='flare'] .nm-diyo-glow {
    animation: nm-flame-flare 180ms ease-out;
  }

  .nm-diyo[data-state='flare'] .nm-diyo-outer {
    animation: nm-flame-flare 180ms ease-out;
  }

  @keyframes nm-flame-flare {
    0% {
      transform: scale(1);
    }
    45% {
      transform: scale(1.22);
    }
    100% {
      transform: scale(1);
    }
  }

  /* Flying names. position: fixed, so this layer carries no geometry — it is
     here only so the tokens inherit the light tokens and React never diffs
     them. */
  .nm-fx {
    position: absolute;
    z-index: 40;
    inset: 0;
    pointer-events: none;
  }

  /* A spark off the lamp when the third name lands — the page's one particle
     moment, and it is deliberately NOT confetti. Confetti is paper falling at a
     party; this is a flame throwing embers, which is the only thing on this
     screen that could throw anything. Warm-only, and small enough that twelve
     of them read as a lift rather than as a burst. Positioned and animated from
     NaamApp; this is only what one looks like. */
  /* 6px with a glow, not 4px with a soft edge. The first version measured 3px
     wide at 0.47 opacity once the gradient's falloff and the animation's scale
     were applied — a spark that existed in the DOM, animated correctly, and was
     invisible on screen. A warm dot on a warm lit ground needs a hot core and
     something to bloom into, or the lamplight it is rising through simply eats
     it. */
  .nm-ember {
    position: absolute;
    box-shadow: 0 0 7px 1px color-mix(in srgb, var(--nm-keep) 45%, transparent);
    border-radius: 50%;
    background: radial-gradient(circle, #fff6de 0%, var(--nm-keep) 58%, transparent 76%);
    width: 6px;
    height: 6px;
    pointer-events: none;
  }

  /* ── The rail ─────────────────────────────────────────────────────────
     Named .nm-topbar, NOT .nm-rail: NaamCard's sound rail already owns that
     class and this page renders both. */
  .nm-topbar {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: var(--space-2xs);
    border-bottom: 1px solid var(--nm-hair);
    padding: 0 clamp(0.75rem, 2.4vw, 1.4rem);
    height: 44px;
  }

  /* Explicit colour and weight: it was inheriting the topbar's soft token and
     landing at roughly 1.6:1 on the light ground — the page's own name was the
     least legible thing on it. */
  .nm-brand {
    margin: 0;
    color: var(--nm-text);
    font-weight: 600;
    font-size: 1.05rem;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .nm-swap-rail {
    transition: border-color var(--dur-base) ease;
    cursor: pointer;
    margin-left: auto;
    border: 1px solid var(--nm-hair-strong);
    border-radius: 999px;
    background: transparent;
    padding: 0.25rem 0.7rem;
    color: var(--nm-text-soft);
    font-size: 0.9rem;
    line-height: 1.7;
    font-family: var(--font-deva), var(--font-body);

    &[aria-pressed='true'] {
      border-color: var(--crimson);
      color: var(--nm-text);
    }
  }

  /* DESIGN.md §4 — two of the three words, and never a fourth. */
  .nm-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border: 1px solid var(--nm-hair-strong);
    border-radius: 999px;
    padding: 0.15rem 0.55rem;
    color: var(--nm-text-soft);

    /* Glacier is 2.7:1 on rice, so it is the dot and the border. The word is
       set in --nm-text-soft, which is 5.1:1. */
    &[data-source='live'] {
      border-color: var(--nm-live);
    }

    &[data-source='live']::before {
      display: block;
      border-radius: 999px;
      background: var(--nm-live);
      width: 6px;
      height: 6px;
      content: '';
    }
  }

  /* ── The stream ───────────────────────────────────────────────────────── */
  .nm-streamwrap {
    display: flex;
    position: relative;
    flex: 1 1 0;
    min-height: 0;
  }

  .nm-stream {
    flex: 1 1 auto;
    margin: 0;
    padding: var(--space-m) clamp(0.75rem, 2.4vw, 1.4rem) var(--space-s);
    min-height: 0;
    /* overflow-anchor would fight the scroll-to-bottom on every insertion. */
    overflow-anchor: none;
    overflow-y: auto;
    /* Without `contain` an overscroll chains to the document and fires
       pull-to-refresh on a page that must never move. */
    overscroll-behavior: contain;
    list-style: none;
  }

  /* ── The thread, and the beads strung on it ───────────────────────────
     A log is a column of blocks all shouting at the same volume, and it gets
     louder the longer you use it — which is exactly why this screen felt
     overwhelming three turns in. This is a counting object instead: a thread
     down the left, one bead per turn, and the beads you have passed worn
     smaller, fainter and compressed to a single line.

     THE GAP BELONGS TO THE TURN BELOW IT, as padding-top rather than as the
     margin-bottom this used to be, and that is not a style preference. The
     thread has to bridge the space between two beads, and a pseudo-element can
     only read its OWN element's custom properties — so with the gap as a bottom
     margin the connector would have had to know the PREVIOUS turn's spacing,
     which CSS cannot express. As padding-top, --nm-gap is right there.

     That also makes the compression free: a passed turn simply declares a
     smaller --nm-gap, so the mala tightens where you have already been and
     keeps its air around the exchange you are on.

     No timeline library. Every one of them (react-chrono,
     react-vertical-timeline-component, shadcn's blocks) renders a vertical rule
     with cards hanging off it, which is precisely the log being escaped. This
     is a two-column grid, two pseudo-elements and one keyframe. ────────────── */
  .nm-turn {
    --nm-gap: var(--space-m);
    /* The rail's width and the bead's, in one place: the narrow breakpoint
       re-declares these three and every offset below follows. */
    --nm-rail: 22px;
    --nm-rail-gap: 0.7rem;
    --nm-bead: 12px;
    /* Where the bead's top sits, so it lands on the optical centre of the
       first line of text beside it (1rem at 1.7 line-height is a 27px box). */
    --nm-bead-top: 7px;

    display: grid;
    grid-template-columns: var(--nm-rail) minmax(0, 1fr);
    column-gap: var(--nm-rail-gap);
    margin: 0 auto;
    padding-top: var(--nm-gap);
    max-width: 720px;
  }

  /* Nothing is strung above the first bead, and the stream's own top padding
     is already the air above it. 0px, not 0: it is read inside calc(). */
  .nm-turn:first-child {
    --nm-gap: 0px;
  }

  .nm-turn[data-past] {
    --nm-gap: var(--space-2xs);
  }

  /* The .sr-only speaker label is position:absolute, so it is out of flow and
     never takes a grid cell — the rail and the body auto-place into the two
     columns without anything having to be placed by hand. */
  .nm-turn-rail {
    position: relative;
  }

  /* The cord: a continuous faint line with diagonal ticks laid over it. Two
     layers, because either one alone is wrong — the ticks by themselves render
     as a dashed border, which is worse than a plain rule, and a plain 1px
     vertical rule IS the timeline-library look. Together the line carries the
     continuity a strung object needs and the ticks give it a twist, and at
     13% under 26% neither is individually legible. */
  .nm-turn-rail::before,
  .nm-turn-rail::after {
    position: absolute;
    left: calc(var(--nm-rail) / 2 - 1px);
    background-image: repeating-linear-gradient(-64deg, var(--nm-hair-strong) 0 1px, transparent 1px 3px);
    background-color: var(--nm-hair);
    width: 2px;
    content: '';
  }

  /* THE CONNECTOR, and it draws. The line REACHING the new bead is the progress
     signal; a node simply appearing is not, and instant appearance is what
     makes a sequence read as a log. scaleY off a top origin rather than an SVG
     stroke-dashoffset: on a straight 2px vertical the two are pixel-identical,
     and this one composites and costs no element. */
  .nm-turn-rail::before {
    top: calc(-1 * var(--nm-gap));
    transform-origin: top;
    animation: nm-thread 500ms cubic-bezier(0.05, 0.7, 0.1, 1) backwards;
    height: calc(var(--nm-gap) + var(--nm-bead-top));
  }

  .nm-turn-rail::after {
    top: calc(var(--nm-bead-top) + var(--nm-bead));
    bottom: 0;
  }

  .nm-turn:first-child .nm-turn-rail::before {
    display: none;
  }

  /* The thread ends at the bead you are on. There is nothing strung after it
     yet, and a cord running past the last bead into empty space is the log's
     "and it continues" — the opposite of what a counting object says. */
  .nm-turn:last-child .nm-turn-rail::after {
    display: none;
  }

  @keyframes nm-thread {
    from {
      transform: scaleY(0);
    }

    to {
      transform: scaleY(1);
    }
  }

  /* FIVE SILHOUETTES, NEVER ONE REPEATED DOT — the repeated bullet is the
     single thing that makes a vertical sequence read as a log, and a mala is
     not one shape repeated either. All of it is one empty <span>: no SVG, no
     icon font, no per-turn element beyond this one.

     `rotate` and `scale` are used as INDIVIDUAL transform properties rather
     than as a transform string, and that is the point of them here: the facet
     beads are permanently turned 45° and the worn state permanently scales, so
     writing both into one `transform` would mean every worn facet has to
     restate the rotation. They are static, so the note about individual
     transforms not compositing does not apply — nothing animates them. */
  .nm-bead {
    display: block;
    position: absolute;
    top: var(--nm-bead-top);
    left: calc((var(--nm-rail) - var(--nm-bead)) / 2);
    transition:
      opacity var(--dur-base) ease,
      scale var(--dur-base) ease,
      filter var(--dur-base) ease;
    border: 1.5px solid transparent;
    border-radius: 50%;
    width: var(--nm-bead);
    height: var(--nm-bead);
  }

  /* The agent spoke. The ordinary counting bead, and the one there are most
     of, so it is the quietest. */
  .nm-bead[data-bead='said'] {
    background: color-mix(in srgb, var(--nm-text) 30%, transparent);
  }

  /* You asked. Open, because a question is. */
  .nm-bead[data-bead='asked'] {
    border-color: var(--crimson);
    background: var(--nm-canvas);
  }

  /* Names came. The facet — the bead that catches the light. */
  .nm-bead[data-bead='dealt'] {
    rotate: 45deg;
    border-color: var(--nm-keep);
    border-radius: 3px;
    background: var(--nm-keep-fill);
  }

  /* The wall: the shape of the paper it summarises, down to the uneven radius
     and a tilt of its own. */
  .nm-bead[data-bead='note'] {
    rotate: -7deg;
    border-color: rgb(38 32 22 / 22%);
    border-radius: 1px 3px 2px 4px;
    background: var(--nm-note);
  }

  /* Nothing came back. A facet that did not fill. */
  .nm-bead[data-bead='stuck'] {
    rotate: 45deg;
    border-color: var(--nm-accent-text);
    border-radius: 3px;
    background: var(--nm-canvas);
  }

  /* The send: the large bead a mala is counted from and finished at. The ring
     is box-shadow rather than a bigger box, so the bead keeps the same
     geometry as every other one and the worn scale still centres on it. */
  .nm-bead[data-bead='guru'] {
    box-shadow:
      0 0 0 2px var(--nm-canvas),
      0 0 0 3.5px var(--nm-keep);
    background: var(--nm-keep);
  }

  /* WORN. Smaller, fainter, desaturated — the beads you have already passed
     through your fingers. It is the bead that carries the wear and not the
     text: washing out a summary line would cost contrast for an effect the
     bead gives for free. */
  .nm-turn[data-past] .nm-bead {
    scale: 0.72;
    opacity: 0.55;
    filter: saturate(0.35);
  }

  .nm-turn[data-past]:hover .nm-bead,
  .nm-turn[data-past]:focus-within .nm-bead {
    scale: 0.92;
    opacity: 1;
    filter: none;
  }

  .nm-turn-body {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    min-width: 0;
  }

  /* A passed turn, compressed. It is a real <button> with a real accessible
     name — `bead.reopen` rides along in .sr-only text, because a control
     labelled only "Ways to start" says what it is and not what pressing it
     does — and it is a button rather than a clickable div because axe is the
     gate that decides that (P10). */
  .nm-turn-shut {
    display: block;
    position: relative;
    transition: color var(--dur-base) ease;
    cursor: pointer;
    border: none;
    border-radius: 4px;
    background: none;
    padding: 0;
    min-width: 0;
    min-height: 24px;
    color: var(--nm-text-soft);
    text-align: left;

    &:hover {
      color: var(--nm-text);
    }

    &:focus-visible {
      outline: 2px solid var(--crimson);
      outline-offset: 3px;
    }
  }

  /* The bead is in the other grid column and is aria-hidden, so it cannot be
     its own control — this stretches the button's hit area left across the
     rail so that tapping the bead is tapping the turn, which is the gesture
     the object suggests. */
  .nm-turn-shut::before {
    position: absolute;
    inset: 0 0 0 calc(-1 * (var(--nm-rail) + var(--nm-rail-gap)));
    content: '';
  }

  .nm-turn-shut-line {
    display: block;
    overflow: hidden;
    font-size: 0.88rem;
    line-height: 1.7;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* A turn is a typographic block. No bubble, no avatar, no right-aligned
     user message — that is the single clearest chat-widget tell and P11
     forbids the grammar. The speaker is stated in .sr-only text instead. */
  .nm-said {
    margin: 0;
    max-width: 62ch;
    color: var(--nm-text-soft);
    font-size: 1rem;
    line-height: 1.7;
  }

  .nm-said--lead {
    max-width: 24ch;
    color: var(--nm-text);
    font-size: clamp(1.35rem, 3.2vw, 1.7rem);
    line-height: 1.35;
    font-family: var(--font-deva), var(--font-display);
    letter-spacing: -0.02em;
  }

  /* What the visitor said. It used to carry a 2px crimson rule down its left
     edge; the thread now runs down the same side about thirty pixels further
     out and the bead beside this turn is the crimson ring, so the rule became
     the second vertical mark in a row saying the same word. One signal: the
     bead says who spoke, the ink weight says it is not the page talking. */
  .nm-said--you {
    color: var(--nm-text);
  }

  .nm-said--note {
    color: var(--nm-accent-text);
  }

  .nm-quiet-label {
    margin: 0;
    color: var(--nm-text-soft);
  }

  /* ── The wall, inline, as a turn ──────────────────────────────────────
     Not behind an "Everyone" tab: a tab is a filing decision, and it makes the
     family something you go and look up. You are choosing next to people who
     already chose, so it is in the conversation.

     WHY IT IS NO LONGER A ROW OF PILLS. A pill row on a page whose every other
     pill is a control (the starters, the badge, the swap) reads as filters —
     something you are expected to click — and nothing here is clickable. It is
     a record of what other people put up, and the object that says that without
     a word of explanation is a wall of pinned notes. It is also the only place
     on this screen where other people accumulate, which is half the answer to
     "nothing grows".

     PURE CSS, ZERO DEPENDENCIES, and every number below is doing a job. */
  .nm-wall {
    display: flex;
    /* flex-start, never the default stretch: a stretched note is exactly as
       tall as the tallest thing in its row, which lines every bottom edge up
       and undoes the tilt's whole job. */
    flex-wrap: wrap;
    align-items: flex-start;
    margin: 0;
    /* Room for the tilt and the lift to happen in without clipping. */
    padding: 0.4rem 0.5rem 0.6rem 0;
    list-style: none;
  }

  /* THE PIN OWNS ROTATION AND NOTHING ELSE. `transform` is one property and two
     things want it — the permanent per-note tilt, and the transient lift on
     hover — so they are split across two elements. Sharing one would mean the
     lift has to restate the tilt, and the next thing added here (the plan's
     layout animation) would clobber both.

     The tilt is ±3°, hashed off the name by NaamApp, so the wall never
     reshuffles on a re-render: a random angle re-rolls every render and reads
     as a glitch rather than as a hand. Past about 4° it stops looking pinned
     and starts looking rotated.

     OVERLAP, with a negative margin and an ascending z-index. A perfectly
     spaced row is a leaderboard; an overlapping pile is a wall, and this is a
     wall. The vertical overlap is deliberately smaller than the horizontal one
     — enough to break the grid, not enough to bury a signature. */
  .nm-note-pin {
    position: relative;
    transform: rotate(var(--tilt, 0deg));
    z-index: var(--z, 0);
    transition: transform 180ms cubic-bezier(0.05, 0.7, 0.1, 1);
    margin: 0 -0.5rem -0.25rem 0;
  }

  /* Un-tilt to 0° and lift two pixels: "picked up" is a far stronger physical
     cue than any change of shadow, and it brings the note out from under the
     ones overlapping it. */
  .nm-note-pin:hover {
    transform: rotate(0deg);
    z-index: 30;
  }

  /* TWO SHADOWS, NEVER ONE. A single blurred shadow is the Material-card tell.
     Paper has a hard contact shadow where it touches plus a wide faint lift,
     and the pair is what the eye reads as a physical object rather than as an
     elevation token.

     The radius is four different sub-pixel values because a 999px pill or a
     uniform 8px is UI chrome — this is a cut edge.

     The background is three layers in one property and costs no elements: the
     glue band across the top 18%, a very faint fibre so the paper has tooth,
     and the yellow. A shared feTurbulence would be truer grain, but at this
     size it is one raster pass per note for something under a millimetre
     across, and the two shadows plus the curl already carry the paper. The
     fibre runs at 112° and repeats every 6px on purpose — nearer the horizontal
     and tighter it stopped reading as tooth and started reading as ruled paper,
     which is a different object.

     SQUARE-ISH, via a min-height a signed note already exceeds. A note whose
     height is whatever two lines of text need is 90×44, and ten of those
     overlapping read as one yellow strip rather than as ten pieces of paper —
     the tilt cannot break a shape that wide. At 3.6rem the block is close
     enough to square for a 3° rotation to be legible on it. */
  .nm-note {
    display: flex;
    position: relative;
    flex-direction: column;
    gap: 0.05rem;
    transition:
      transform 180ms cubic-bezier(0.05, 0.7, 0.1, 1),
      box-shadow 180ms ease;
    box-shadow:
      0 1px 1px rgb(38 32 22 / 14%),
      0 8px 14px -6px rgb(38 32 22 / 16%);
    border-radius: 1px 3px 2px 4px;
    background-image:
      linear-gradient(to bottom, rgb(38 32 22 / 6%) 0 18%, transparent 18%),
      repeating-linear-gradient(112deg, rgb(38 32 22 / 2.5%) 0 1px, transparent 1px 6px);
    background-color: var(--nm-note);
    padding: 0.5rem 0.65rem 0.45rem;
    min-width: 5.2rem;
    max-width: 13rem;
    min-height: 3.6rem;
    color: var(--nm-note-ink);
  }

  .nm-note-pin:hover .nm-note {
    transform: translateY(-2px);
    box-shadow:
      0 2px 2px rgb(38 32 22 / 12%),
      0 14px 22px -8px rgb(38 32 22 / 22%);
  }

  /* The curl: paper does not lie flat, and the darkening under its bottom edge
     is what says the corners are off the wall. Positioned just below the note
     so it is not painted over by the note's own background. */
  .nm-note::after {
    position: absolute;
    right: 9%;
    bottom: -2px;
    left: 9%;
    box-shadow: 0 4px 6px -3px rgb(38 32 22 / 42%);
    height: 3px;
    content: '';
  }

  .nm-note-deva {
    font-size: 1.05rem;
    line-height: 1.6;
    font-family: var(--font-deva), var(--font-body);
  }

  .nm-note-latin {
    color: var(--nm-note-ink-soft);
    font-size: 0.78rem;
    line-height: 1.35;
    font-family: var(--font-display);
  }

  /* THE SIGNATURE, and it is part of the note rather than a caption under it:
     bottom right, smaller, the way somebody actually signs a thing they pinned
     up. Only approved suggestions carry one — the family's own six do not need
     attributing — so its presence is what visibly separates "ours, to start"
     from "someone else already chose this", with nothing labelling either. */
  .nm-note-who {
    align-self: flex-end;
    /* auto, not a fixed gap: it presses the signature onto the bottom edge of
       the note whatever the name above it needed, which is where a signature
       goes. */
    margin-top: auto;
    padding-top: 0.25rem;
    max-width: 100%;
    overflow: hidden;
    color: var(--nm-note-ink-soft);
    font-size: 0.58rem;
    font-family: var(--font-mono);
    letter-spacing: var(--tracking-label);
    text-align: right;
    text-overflow: ellipsis;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* ── Starter chips ────────────────────────────────────────────────────── */
  .nm-chips {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs);
  }

  .nm-chip {
    transition:
      border-color var(--dur-base) ease,
      color var(--dur-base) ease;
    cursor: pointer;
    border: 1px solid var(--nm-hair-strong);
    border-radius: 999px;
    background: var(--nm-surface);
    padding: 0.4rem 0.85rem;
    color: var(--nm-text-soft);
    font-size: 0.92rem;
    line-height: 1.7;
    /* Mukta first, chips included: a starter that reads ▯▯▯▯ is what a
       missing Devanagari face looks like, and this row is where it shows. */
    font-family: var(--font-deva), var(--font-body);

    &:hover {
      border-color: var(--crimson);
      color: var(--nm-text);
    }

    &:disabled {
      opacity: 0.5;
      cursor: default;
    }
  }

  .nm-chip-hide {
    cursor: pointer;
    border: none;
    background: none;
    padding: 0.4rem 0.2rem;
    color: var(--nm-text-soft);

    &:hover {
      color: var(--nm-accent-text);
    }
  }

  /* ── Thinking: P8, never a spinner ────────────────────────────────────── */
  .nm-thinking {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    max-width: 320px;
  }

  #naam-app .pulse-line {
    background: var(--nm-hair);
  }

  /* Lowercase: it is a caption, not a label (DESIGN.md §3). */
  .nm-caption {
    margin: 0;
    color: var(--nm-text-soft);
    text-transform: lowercase;
  }

  /* ── The deal ─────────────────────────────────────────────────────────
     Names are not shown, they are DEALT: 100ms apart (under ~50 reads as
     "they all appeared"), 420ms each on Material's emphasized-decelerate,
     out of a seeded ±3° rotation so a card lands at the same angle every
     time. This is the page's signature and its one boldness budget.

     No data-reveal anywhere in here: anything inserted into the stream never
     intersects the observer's root, so it would stay at opacity 0 forever. */
  .nm-deal {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: var(--space-2xs);
  }

  @keyframes nm-deal {
    from {
      transform: translateY(16px) rotate(var(--tilt, 0deg)) scale(0.97);
      opacity: 0;
    }

    to {
      transform: none;
      opacity: 1;
    }
  }

  .nm-dealt {
    display: flex;
    animation: nm-deal 420ms cubic-bezier(0.05, 0.7, 0.1, 1) backwards;
    animation-delay: calc(var(--i, 0) * 100ms);
  }

  .nm-dealt > .nm-card {
    flex: 1 1 auto;
  }

  /* ── The hand, lying on the plate ─────────────────────────────────────── */
  .nm-hand {
    min-width: 0;
  }

  /* Three cards abreast, and the plate is sized so they land at their natural
     width rather than being squeezed to fit it. */
  @media (min-width: 1100px) {
    .nm-hand > .nm-deal {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* Stacked, the hand is a band above the slots and you swipe along it. Three
     full-height cards in one column would leave the conversation about 200px,
     which is the problem this move exists to solve, not a smaller version of
     it. Sideways, one card is legible, the next is visibly there, and the
     agent's words keep the top of the screen. */
  @media (max-width: 1099px) {
    .nm-hand > .nm-deal {
      display: flex;
      gap: var(--space-2xs);
      /* The dealt cards lift and rotate; without the padding the top of that
         motion is clipped by the scroller's own edge. */
      padding-block: 2px 0.3rem;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
    }

    .nm-hand .nm-dealt {
      flex: 0 0 min(72vw, 17rem);
      scroll-snap-align: start;
    }

    /* THE CARD ON THE BAND IS THE SHORT CARD, and the reason is arithmetic. At
       390×780 the chrome takes 175px, the slots and their label 90 and the lamp
       60 — so a full 370px card leaves the conversation SIXTY PIXELS, which is
       the bug this whole move exists to fix wearing a different hat. Measured
       at that size the agent's reply was still off the top of the screen.

       What goes is `.nm-reasons` — "matched on · 2 syllables · easy to say".
       That is the matcher explaining itself, and on this layout the agent has
       just explained the same three names in its own sentence, in prose, in the
       column directly above. Two voices giving the same reasons is redundant on
       a desktop and unaffordable on a phone. Nothing is hidden that the visitor
       cannot get: the name, the script, the syllables, the gloss, Keep and the
       document's own line are all still on the card, and the reasons are still
       rendered in full on a reopened hand in the stream. */
    .nm-hand .nm-reasons {
      display: none;
    }

    /* Long glosses are the other overflow, and they are the document's words —
       so this clamps rather than truncates the source: the full line is always
       one tap away under "from the document". */
    .nm-hand .nm-gloss {
      display: -webkit-box;
      overflow: hidden;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 3;
    }
  }

  /* ── The stacked height budget, and why it is written as a cap ─────────
     The conversation needs a floor, or the tray — which is `flex: 0 0 auto` —
     simply takes what it wants and starves the stream to two lines. But a floor
     ALONE is how I pushed the composer off the bottom of a phone: measured at
     390×780, stream 176 + tray 503 + composer 70 came to 793 in a 739px shell,
     the send button's bottom landed at 834, and because the document is
     `overflow: clip` there was nowhere for it to go. It was not clipped or
     scrolled to — it was unreachable, so a visitor on a phone could ask once
     and never again.

     So the floor is modest and the HAND carries the cap. The tray may shrink,
     the hand may not exceed a share of the viewport, and the composer is
     therefore reachable by construction rather than by arithmetic that happens
     to work on the one handset I measured. svh, not vh: on iOS Safari `vh` is
     the tall viewport with the toolbars retracted, which is exactly the 90px
     lie that puts a control under the browser chrome. */
  @media (max-width: 1099px) {
    .nm-streamwrap {
      flex: 1 1 auto;
      min-height: 5.5rem;
    }

    /* A SHARE of the shell, not a fixed cap. Independent floors and ceilings
       can each look reasonable and still sum past the viewport — that is
       exactly how 360×640 kept the send button 77px below the fold after the
       390×780 numbers had been fixed. A percentage cannot: whatever the tray
       takes, the stream and the composer keep the rest. */
    .nm-tray {
      flex: 0 1 auto;
      min-height: 0;
      max-height: 58%;
    }

    .nm-hand {
      flex: 1 1 auto;
      min-height: 0;
    }

    /* Sideways between cards, and up and down inside one when the phone is too
       short to show a whole card at once. Clipping instead would hide Keep,
       which is the only thing on the card that does anything. */
    .nm-hand > .nm-deal {
      max-height: 100%;
      overflow: auto;
    }

    /* The lamp is the page's light source, not its subject, and on a phone it
       was spending 79px of a budget the send button needed. It still reads —
       the flicker is what matters and that survives the scale. */
    .nm-diyo svg {
      width: 44px;
      height: 56px;
    }
  }

  .nm-turn-note {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    margin: 0;
  }

  .nm-turn-note-text {
    color: var(--nm-text-soft);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  /* Offered rather than yanked: the stream sticks to the bottom only while
     you are within 100px of it. */
  .nm-jump {
    position: absolute;
    bottom: var(--space-2xs);
    left: 50%;
    transform: translateX(-50%);
    z-index: 20;
    cursor: pointer;
    box-shadow: var(--nm-shadow, none);
    border: 1px solid var(--nm-hair-strong);
    border-radius: 999px;
    background: var(--nm-surface);
    padding: 0.35rem 0.85rem;
    color: var(--nm-text);
  }

  /* ── The card, on both grounds ────────────────────────────────────────── */
  .nm-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--space-s);
    margin-top: var(--space-m);
  }

  .nm-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    transition: border-color var(--dur-base) ease;
    box-shadow: var(--nm-shadow, none);
    border: 1px solid var(--nm-hair);
    border-radius: 12px;
    background: var(--nm-surface);
    padding: var(--space-s);
  }

  /* DESIGN.md P2 is emphasis by glow — but glow is a dark-ground device, and
     on rice a 28px marigold bloom is invisible. The light branch spends the
     same meaning as a fill and a border, which is all marigold is allowed to
     be here: at ~2:1 on rice it can never carry type. */
  .nm-card[data-picked='true'] {
    box-shadow: var(--glow-marigold);
    border-color: var(--nm-keep);
  }

  #naam-app .nm-card[data-picked='true'] {
    box-shadow: none;
    background: var(--nm-keep-fill);
  }

  .nm-card-name {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  /* Devanagari gets a fixed block so a late font swap shifts nothing, and
     1.65 line-height because matras collide below about 1.6. */
  .nm-deva {
    display: block;
    min-height: 2.8rem;
    color: var(--nm-text);
    font-size: 1.7rem;
    line-height: 2.8rem;
    font-family: var(--font-deva), var(--font-body);
  }

  .nm-latin {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    margin: 0;
  }

  .nm-latin-main {
    color: var(--nm-text);
    font-size: 1.15rem;
    font-family: var(--font-display);
  }

  .nm-latin-alt {
    color: var(--nm-text-soft);
    text-transform: none;
  }

  /* ── The sound rail ───────────────────────────────────────────────────
     width: max-content is what makes this an instrument rather than a
     divider: the rule ends at the last tick, so its length IS the syllable
     count (DESIGN.md P4). The 26px is headroom for the swap control, which
     hangs above the first tick — so only the rows that HAVE one pay for it. */
  .nm-rail[data-swap='true'] {
    padding-top: 26px;
  }

  .nm-ticks {
    display: flex;
    position: relative;
    align-items: flex-start;
    gap: clamp(0.9rem, 4vw, 1.75rem);
    margin: 0;
    padding: 0;
    width: max-content;
    max-width: 100%;
    list-style: none;

    &::before {
      position: absolute;
      top: 4px;
      right: 0;
      left: 0;
      border-radius: 999px;
      background: var(--grad-signal);
      height: 2px;
      content: '';
    }
  }

  .nm-tick {
    display: flex;
    position: relative;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
  }

  .nm-tick-dot {
    display: block;
    border-radius: 999px;
    background: var(--nm-text);
    width: 10px;
    height: 10px;
  }

  .nm-tick-syllable {
    color: var(--nm-text-soft);
    text-transform: uppercase;
  }

  /* The document's own `!` — a harder consonant cluster, marked on the
     syllable whose onset carries it. */
  .nm-tick[data-cluster='true'] .nm-tick-dot {
    box-shadow: var(--ring-crimson);
    background: var(--crimson);
  }

  .nm-tick[data-cluster='true'] .nm-tick-syllable {
    color: var(--nm-accent-text);
  }

  .nm-swap-slot {
    position: absolute;
    bottom: calc(100% + 6px);
    left: 50%;
    transform: translateX(-50%);
  }

  .nm-swap {
    transition:
      border-color var(--dur-base) ease,
      color var(--dur-base) ease;
    cursor: pointer;
    border: 1px solid var(--nm-hair-strong);
    border-radius: 999px;
    background: var(--nm-surface-2);
    padding: 0.15rem 0.5rem;
    color: var(--nm-text-soft);
    white-space: nowrap;

    &[aria-pressed='true'] {
      border-color: var(--crimson);
      color: var(--nm-text);
    }

    &:disabled {
      opacity: 0.55;
      cursor: default;
    }
  }

  /* The document is speaking, and P5 says mono is the voice of data. Clamped
     to three lines: Monier-Williams glosses run from four characters to four
     hundred, and in a grid every row stretches to its tallest card. The full
     text is one tap away in the disclosure directly below. */
  .nm-gloss,
  .nm-source-gloss {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    color: var(--nm-text-soft);
    font-size: 0.95rem;
    line-height: 1.6;
    font-family: var(--font-deva), var(--font-mono);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .nm-source-gloss {
    display: block;
    margin: 0 0 0.35rem;
    overflow: visible;
  }

  .nm-undocumented,
  .nm-reasons {
    margin: 0;
    color: var(--nm-text-soft);
  }

  .nm-card-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs) var(--space-s);
    margin-top: auto;
    padding-top: var(--space-2xs);
  }

  .nm-pick {
    transition:
      border-color var(--dur-base) ease,
      background var(--dur-base) ease;
    cursor: pointer;
    border: 1px solid var(--nm-hair-strong);
    border-radius: 999px;
    background: transparent;
    padding: 0.32rem 0.9rem;
    color: var(--nm-text);

    &[aria-pressed='true'] {
      border-color: var(--nm-keep);
      background: var(--nm-keep-fill);
    }

    &:disabled {
      opacity: 0.5;
      cursor: default;
    }
  }

  .nm-source {
    summary {
      cursor: pointer;
      color: var(--nm-text-soft);
    }

    summary:hover {
      color: var(--nm-accent-text);
    }
  }

  .nm-source-body {
    margin-top: var(--space-2xs);
    border-left: 1px solid var(--nm-hair);
    padding-left: var(--space-2xs);
  }

  .nm-source-meta,
  .nm-source-note {
    opacity: 0.8;
    margin: 0;
    color: var(--nm-text-soft);
  }

  /* ── The tray: ONE shape, three parts missing ─────────────────────────
     Apple's rings work by Gestalt closure — an open ring is a perceptually
     unfinished shape. Three separate grey rectangles are not, which is why
     the prototype's tray was the weakest thing in it. So the three slots are
     drawn as a single ring, and every EMPTY slot erases its segment of the
     top and bottom edge. Filling slot two closes the middle third and
     changes what one and three look like. There is no "1/3 KEPT" counter:
     the shape says it, and a counter is the gamification cliché. */
  /* TRANSPARENT, not --nm-canvas. An opaque tray sat on top of .nm-room and
     cut the lamplight off in a hard horizontal line right where the lamp is —
     the light stopped at the edge of the thing emitting it. The border-top goes
     for the same reason: a rule across the pool is a seam in the room. The tray
     still reads as a distinct surface because the light falls off toward the
     edges, which is how a lit surface separates from its background anyway. */
  .nm-tray {
    display: flex;
    position: relative;
    flex: 0 0 auto;
    flex-direction: column;
    gap: 0.5rem;
    z-index: 1;
    background: transparent;
    padding: 0.6rem clamp(0.75rem, 2.4vw, 1.4rem);
  }

  /* The lamp stands above the label, both centred over the three slots, so the
     light and the thing it lights share an axis. `align-items: baseline` would
     hang a 79px SVG off a 10px label's baseline — the lamp needs its own row. */
  /* The one rescued index link. Sits after the badge, deliberately the
     quietest thing in the rail — it is a legal obligation, not a destination. */
  /* ── The sound switch ─────────────────────────────────────────────────
     Quieter than the व/ब toggle beside it, because it changes how the page
     sounds rather than what it says. The glyph is a struck bowl seen from the
     side — a dot for the strike and a ring for the ring — which fills when the
     sound is on. It is not a speaker with waves coming out of it: this page
     does not have speakers in it, it has a bowl. */
  .nm-sound {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    transition: color var(--dur-base) ease;
    cursor: pointer;
    margin-left: var(--space-s);
    border: 0;
    background: transparent;
    padding: 0.25rem 0;
    color: var(--nm-text-soft);

    &:hover,
    &:focus-visible {
      color: var(--nm-accent-text);
    }
  }

  .nm-sound-glyph {
    display: inline-block;
    transition:
      background var(--dur-base) ease,
      box-shadow var(--dur-base) ease,
      border-color var(--dur-base) ease;
    border: 1px solid var(--nm-hair-strong);
    border-radius: 50%;
    width: 8px;
    height: 8px;

    &[data-on] {
      /* The strike, and the ring going out from it. */
      box-shadow: 0 0 0 3px color-mix(in srgb, var(--nm-keep) 26%, transparent);
      border-color: var(--nm-keep);
      background: var(--nm-keep);
    }
  }

  /* On a phone the rail has the wordmark, two toggles and a link in 44px. The
     switch keeps its glyph — which is the state — and drops the word. */
  @media (max-width: 599px) {
    .nm-sound-word {
      position: absolute;
      clip-path: inset(50%);
      width: 1px;
      height: 1px;
      overflow: hidden;
      white-space: nowrap;
    }
  }

  .nm-rail-a11y {
    margin-left: var(--space-s);
    color: var(--nm-text-soft);
    font-size: 0.62rem;
    text-decoration: none;
  }

  .nm-rail-a11y:hover,
  .nm-rail-a11y:focus-visible {
    color: var(--nm-accent-text);
    text-decoration: underline;
  }

  .nm-tray-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15rem;
    margin: 0 auto;
    width: 100%;
    max-width: 720px;
  }

  /* The site footer is hidden on this page, so its index rides here — but it is
     chrome, not content, and it was arriving at the same visual weight as
     "YOUR THREE" with crimson underlines competing beside the slots. It keeps
     its 24px targets and its contrast; it loses the decoration and drops half a
     step in size so the eye reaches the slots first. */
  .nm-index {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.75rem;
    margin-left: auto;
    font-size: 0.62rem;

    a {
      display: inline-flex;
      align-items: center;
      min-height: 24px;
      color: var(--nm-text-soft);
      text-decoration: none;

      &:hover,
      &:focus-visible {
        color: var(--nm-accent-text);
        text-decoration: underline;
      }
    }
  }

  /* ONE shape, three parts missing — not three boxes.
     An open ring is perceptually unfinished in a way three separate rectangles
     never are (this is why Apple's activity rings work and a progress bar does
     not), so the tray is a single continuous outline and each EMPTY slot punches
     a gap out of its top and bottom edge. Filling a slot does not paint a box;
     it closes the ring. That is also why filling slot 2 changes how 1 and 3
     read — the shape is shared, so the gaps are relative to each other.
     overflow:hidden so a filled slot's marigold clips to the rounded corners
     instead of spilling past them. */
  .nm-slots {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: 0 auto;
    border: 1.5px solid var(--nm-hair-strong);
    border-radius: 10px;
    width: 100%;
    max-width: 460px;
    overflow: hidden;
    list-style: none;
  }

  .nm-slot {
    display: grid;
    position: relative;
    place-items: center;
    min-height: 62px;
  }

  /* The divider between parts, so "three" is legible without three borders. */
  .nm-slot + .nm-slot {
    border-left: 1.5px solid var(--nm-hair-strong);
  }

  .nm-slot::before,
  .nm-slot::after {
    position: absolute;
    height: 1.5px;
    content: '';
  }

  .nm-slot::before {
    top: -1.5px;
  }

  .nm-slot::after {
    bottom: -1.5px;
  }

  /* Empty: the ring is missing here. Exactly the border's own thickness, so the
     gap reads as absence rather than as a drawn dash. */
  .nm-slot:not([data-filled])::before,
  .nm-slot:not([data-filled])::after {
    right: 18%;
    left: 18%;
    background: var(--nm-canvas);
  }

  /* Kept: the ring is not merely present, it is marigold — fill and border,
     which is the only thing marigold is allowed to be on a light ground. */
  .nm-slot[data-filled] {
    background: var(--nm-keep-fill);
  }

  .nm-slot[data-filled]::before,
  .nm-slot[data-filled]::after {
    right: 0;
    left: 0;
    background: var(--nm-keep);
  }

  .nm-slot:first-child[data-filled]::before,
  .nm-slot:first-child[data-filled]::after {
    left: 7px;
  }

  .nm-slot:first-child[data-filled] {
    border-radius: 9px 0 0 9px;
  }

  .nm-slot:last-child[data-filled]::before,
  .nm-slot:last-child[data-filled]::after {
    right: 7px;
  }

  .nm-slot:last-child[data-filled] {
    border-radius: 0 9px 9px 0;
  }

  .nm-slot-take {
    display: grid;
    place-items: center;
    cursor: pointer;
    border: none;
    background: none;
    padding: 0.3rem;
    width: 100%;
    height: 100%;
  }

  /* A name is in flight toward this slot. The slot is already filled — state
     never waits for an animation — so the seat is held blank until the token
     lands on it, and the name appears in exactly the frame the token is
     removed. NaamApp sets and clears the attribute imperatively. */
  .nm-slot[data-landing] .nm-token {
    visibility: hidden;
  }

  .nm-slot-empty {
    display: grid;
    place-items: center;
  }

  /* Devanagari numerals. Free, and unmistakably Nepali. */
  /* १ २ ३ — the only thing in an empty slot, so it has to carry it. At 0.55
     opacity on the soft token they read as smudges rather than as an invitation
     to fill something. Devanagari also needs the looser line-height: matras sit
     above the baseline and clip at 1.0. */
  .nm-slot-ord {
    opacity: 0.75;
    color: var(--nm-text-soft);
    font-size: 1.45rem;
    line-height: 1.7;
    font-family: var(--font-deva), var(--font-body);
  }

  /* Apple's Breathe band is 6–15s per breath, and above ~2% scale it stops
     reading as life and starts reading as movement. It stops the moment the
     slot is filled — see also [data-calm], which suspends it while the
     composer is in use. */
  @keyframes nm-breathe {
    0%,
    100% {
      transform: scale(1);
      opacity: 0.72;
    }

    50% {
      transform: scale(1.012);
      opacity: 1;
    }
  }

  .nm-slot:not([data-filled]) .nm-slot-empty {
    animation: nm-breathe 9s ease-in-out infinite;
  }

  .nm-slot:nth-child(2) .nm-slot-empty {
    animation-delay: 1.1s;
  }

  .nm-slot:nth-child(3) .nm-slot-empty {
    animation-delay: 2.2s;
  }

  /* Only one thing breathes at a time, and never while someone is typing. */
  .nm-shell[data-calm='true'] .nm-slot-empty {
    animation-play-state: paused;
  }

  /* The seated name, and the same object mid-flight — one class, so what
     lands is identical to what was already there and removing the flying
     copy is invisible. */
  .nm-token {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.1rem;
    min-width: 0;
    max-width: 100%;
  }

  .nm-token-deva {
    max-width: 100%;
    overflow: hidden;
    color: var(--nm-text);
    font-size: 1.2rem;
    line-height: 1.7;
    font-family: var(--font-deva), var(--font-body);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .nm-token-latin {
    color: var(--nm-text);
    font-size: 0.8rem;
    line-height: 1.4;
    font-family: var(--font-display);
  }

  /* OPAQUE, and it has to be. The slot underneath is filled the instant the
     click lands — state never waits for an animation — so a translucent copy
     shows the seated name through the flying one and the whole gesture reads
     as a rendering bug. Two stacked backgrounds put the marigold fill over an
     opaque ground in one property. */
  .nm-token--flying {
    display: flex;
    position: fixed;
