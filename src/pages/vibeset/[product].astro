---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import { getCollection, render } from 'astro:content'

export const prerender = true

export async function getStaticPaths() {
  // Choon has no page here — it lives at choon.vibeset.ai, and every link
  // that used to point at /vibeset/choon now goes straight there.
  const products = await getCollection('products', ({ id }) => !id.startsWith('choon'))
  return products.map((p) => ({
    params: { product: p.id.replace(/\.mdx$/, '') },
    props: { entry: p },
  }))
}

const { entry } = Astro.props
const data = entry.data
const slug = entry.id.replace(/\.mdx$/, '')

// The systems behind this product, from the capabilities collection.
const capabilities = (await getCollection('capabilities', ({ data: d }) => d.product === slug)).sort(
  (a, b) => a.data.order - b.data.order,
)

/**
 * D5 — the search router (Curation). Three real paths, chosen per query by
 * classify_query_complexity. The axis below is logarithmic on purpose: on a
 * linear scale a 1 ms exact match next to a 300 ms embedding search is
 * invisible, which would hide the one fact this panel exists to state.
 */
const LAT_MIN = 0.5
const LAT_MAX = 1000
const logPos = (ms: number) =>
  ((Math.log10(ms) - Math.log10(LAT_MIN)) / (Math.log10(LAT_MAX) - Math.log10(LAT_MIN))) * 100

const routes = [
  {
    name: 'sql',
    lo: 1,
    hi: 10,
    when: 'The query names something exactly',
    example: 'artist = "Bicep", 124–128 bpm',
    why: 'Indexed columns answer it. No model runs.',
  },
  {
    name: 'hybrid',
    lo: 50,
    hi: 150,
    when: 'Part literal, part description',
    example: '"like Bicep but slower"',
    why: 'Text match narrows it down, then vectors rank what is left.',
  },
  {
    name: 'semantic',
    lo: 150,
    hi: 300,
    when: 'No literal to match on',
    example: '"last hour of a warehouse set"',
    why: 'Embedding search across the catalog. The expensive path, earned.',
  },
]
const LAT_TICKS = [1, 10, 100, 1000]

/**
 * D6 — the /v1 B2B API (Cue). A reference, not a console: the API is
 * key-gated (an unauthenticated /v1/health returns 401), so anything that
 * looked interactive here would be a lie. Shapes are read from the service's
 * own route definitions.
 */
const endpoints = [
  { m: 'POST', p: '/v1/match', d: 'Music for a video you have already sent.' },
  { m: 'POST', p: '/v1/videos/ingest', d: 'Send a video URL. Returns a job to poll.' },
  { m: 'POST', p: '/v1/underscore', d: 'Analyse and match in one call.' },
  { m: 'GET', p: '/v1/videos/{id}', d: 'Is the analysis ready yet?' },
  { m: 'GET', p: '/v1/match/jobs/{id}', d: 'Is the match ready yet?' },
]
const apiFacts = [
  ['auth', 'per-account API keys, scoped and revocable'],
  ['retries', 'Idempotency-Key — a repeat is not a second charge'],
  ['cost control', 'monthly spend cap, enforced server-side'],
  ['metering', 'every call attributed to a key'],
]

// Per-product media (visual artifacts live here, not in the collection)
type Media =
  | { type: 'image'; src: string; alt: string; href?: string }
  | { type: 'article'; href: string; headline: string; excerpt: string }
  | { type: 'gradient' }

const media: Record<string, Media> = {
  curation: { type: 'gradient' },
  cue: {
    type: 'image',
    src: '/vibeset/cue-signin.webp',
    alt: 'Cue sign-in screen: “Music perfectly synced to picture.”',
    href: data.liveUrl,
  },
}
const m = media[slug] ?? { type: 'gradient' }
---

<DefaultLayout title={`Vibeset ${data.name} — Bishal Upadhyaya`} description={data.tagline}>
  <!-- Media zone -->
  <div class="vbp-media" style={`--accent: ${data.accent}`}>
    {
      m.type === 'image' && (
        <a href={m.href ?? '#'} rel="noopener" class="vbp-shot-link">
          <img class="vbp-shot" src={m.src} alt={m.alt} width="1200" height="750" />
        </a>
      )
    }
    {
      m.type === 'article' && (
        <a class="vbp-article-card" href={m.href} target="_blank" rel="noopener noreferrer">
          <p class="vbp-article-headline">{m.headline}</p>
          <p class="vbp-article-excerpt">{m.excerpt}</p>
          <span class="vbp-article-cta label-mono">Read the story ↳</span>
        </a>
      )
    }
    {m.type === 'gradient' && <div class="vbp-gradient" />}
  </div>

  <!-- Info zone -->
  <article class="vbp-info" style={`--accent: ${data.accent}`}>
    <div class="container">
      <nav class="vbp-nav" aria-label="Breadcrumb">
        <a href="/#work" class="vbp-back label-mono">← Vibeset</a>
      </nav>

      <p class="label-mono vbp-eyebrow">{data.eyebrow} · Vibeset</p>
      <h1 class="vbp-name">{data.name}</h1>
      <p class="vbp-tagline">{data.tagline}</p>
      <p class="vbp-description">{data.description}</p>

      {
        data.stats.length > 0 && (
          <dl class="vbp-stats">
            {data.stats.map((s) => (
              <div>
                <dt class="label-mono">{s.label}</dt>
                <dd>{s.value}</dd>
              </div>
            ))}
          </dl>
        )
      }

      {
        data.liveUrl && (
          <p class="vbp-cta-row">
            <a class="btn-pill" href={data.liveUrl} rel="noopener">
              {data.liveLabel ?? 'Open'} ↳
            </a>
          </p>
        )
      }

      {
        slug === 'curation' && (
          <div class="vbp-demo">
            <h2 class="vbp-demo-label label-mono">Three ways to answer one query</h2>
            <p class="vbp-demo-note">
              Most searches don't need an embedding model. The ones that do are ruined by exact matching.
              So the router reads the query and picks. The axis is logarithmic: the cheap path really is a
              hundred times cheaper.
            </p>

            <div class="rt-router">
              {routes.map((r) => (
                <div class="rt-route">
                  <p class="rt-route-head">
                    <span class="rt-route-name label-mono">{r.name}</span>
                    <span class="rt-route-ms label-mono">{`${r.lo}–${r.hi} ms`}</span>
                  </p>
                  <div class="rt-track" aria-hidden="true">
                    <span
                      class="rt-bar"
                      style={`left:${logPos(r.lo)}%; width:${Math.max(1.5, logPos(r.hi) - logPos(r.lo))}%`}
                    />
                  </div>
                  <p class="rt-route-when">{r.when}</p>
                  <p class="rt-route-eg label-mono">{r.example}</p>
                  <p class="rt-route-why">{r.why}</p>
                </div>
              ))}

              <div class="rt-axis label-mono" aria-hidden="true">
                {LAT_TICKS.map((t) => (
                  <span class="rt-tick" style={`left:${logPos(t)}%`}>
                    {t < 1000 ? `${t}ms` : '1s'}
                  </span>
                ))}
              </div>
            </div>
          </div>
        )
      }

      {
        slug === 'cue' && (
          <div class="vbp-demo">
            <h2 class="vbp-demo-label label-mono">There's an API behind it</h2>
            <p class="vbp-demo-note">
              Cue is a service too. Here is the contract. It's key-gated, so this is a reference rather
              than something you can run from here.
            </p>

            <ul class="api-list">
              {endpoints.map((e) => (
                <li class="api-row">
                  <span class={`api-m label-mono api-m-${e.m.toLowerCase()}`}>{e.m}</span>
                  <code class="api-p">{e.p}</code>
                  <span class="api-d">{e.d}</span>
                </li>
              ))}
            </ul>

            <dl class="api-facts">
              {apiFacts.map(([k, v]) => (
                <div>
                  <dt class="label-mono">{k}</dt>
                  <dd>{v}</dd>
                </div>
              ))}
            </dl>
          </div>
        )
      }

      {
        capabilities.length > 0 && (
          <div class="vbp-caps">
            <h2 class="vbp-caps-label label-mono">What's underneath</h2>
            <ul class="vbp-caps-list" data-reveal-stagger>
              {capabilities.map((c) => (
                <li class="vbp-cap" data-reveal="settle">
                  <h3 class="vbp-cap-name">{c.data.name}</h3>
                  <p class="vbp-cap-tagline">{c.data.tagline}</p>
                  {c.data.features.length > 0 && (
                    <ul class="vbp-cap-features">
                      {c.data.features.map((f) => (
                        <li>{f}</li>
                      ))}
                    </ul>
                  )}
                  {c.data.techStack.length > 0 && (
                    <p class="vbp-cap-stack label-mono">{c.data.techStack.join(' · ')}</p>
                  )}
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </article>
</DefaultLayout>

<style lang="scss">
  /* The media zone is a screen (tokens.css --stage). Every product shot on this
     site is a dark UI, and DESIGN.md §5 licenses each product's real brand hue
     for three non-text uses in here — Cue's lime is 1.09:1 on bone and 14.06:1
     on the stage, so this surface is what keeps that clause payable. */
  .vbp-media {
    display: flex;
    position: relative;
    justify-content: center;
    align-items: center;
    background: var(--stage);
    padding-top: 72px; /* clear the fixed header */
    width: 100%;
    min-height: 40vh;
    overflow: hidden;
  }

  .vbp-shot-link {
    display: block;
    padding: var(--space-l);
    max-width: 900px;
  }

  .vbp-shot {
    display: block;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.4);
    border: 1px solid var(--stage-hair);
    border-radius: 12px;
    width: 100%;
    height: auto;
  }

  .vbp-gradient {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 30% 40%, color-mix(in srgb, var(--accent) 30%, transparent) 0%, transparent 60%),
      var(--stage);
  }

  .vbp-article-card {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-m);
    padding: var(--space-2xl);
    width: 100%;
    min-height: 40vh;

    &:hover .vbp-article-headline {
      color: var(--marigold-on-stage);
    }
  }

  .vbp-article-headline {
    transition: color var(--dur-base) ease;
    margin: 0;
    max-width: 20ch;
    color: var(--on-stage);
    font-weight: 600;
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    line-height: 1.15;
    font-family: var(--font-display);
  }

  .vbp-article-excerpt {
    margin: 0;
    max-width: 52ch;
    color: var(--on-stage-soft);
    font-size: clamp(0.9rem, 1.5vw, 1.05rem);
    line-height: 1.6;
  }

  .vbp-article-cta {
    color: var(--marigold-on-stage);
  }

  .vbp-info {
    padding: var(--space-2xl) 0 var(--space-3xl);
  }

  .vbp-nav {
    margin-bottom: var(--space-xl);
  }

  .vbp-back {
    display: inline-flex;
    align-items: center;
    /* WCAG 2.5.8 — a standalone breadcrumb link, not prose. */
    min-height: 24px;
    color: var(--ink-soft);

    &:hover {
      color: var(--crimson-text);
    }
  }

  .vbp-eyebrow {
    margin: 0 0 var(--space-s);
    color: var(--crimson-text);
  }

  .vbp-name {
    margin: 0 0 var(--space-s);
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .vbp-tagline {
    margin: 0 0 var(--space-l);
    color: var(--paper);
    font-weight: 600;
    font-size: clamp(1rem, 2vw, 1.3rem);
    line-height: 1.4;
  }

  .vbp-description {
    margin: 0 0 var(--space-m);
    max-width: 65ch;
    color: var(--ink-soft);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  /* ── Measured ───────────────────────────────────────────────────────────
     Promoted from an inline mono run, where the values rode along in the same
     size and colour as their labels and so read as mentioned rather than
     measured (docs/design/DESIGN.md §3). The 1px grid gap on a hairline ground
     is the rule — no borders to keep in sync. */
  .vbp-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 1px;
    margin: 0 0 var(--space-l);
    border: 1px solid var(--hairline-on-ink);
    border-radius: var(--radius-large);
    background: var(--hairline-on-ink);
    overflow: hidden;

    > div {
      background: var(--ink);
      padding: 0.7rem 0.85rem;
    }

    dt {
      margin: 0;
      color: var(--paper-soft);
      font-size: 0.6rem;
      letter-spacing: 0.1em;
    }

    dd {
      margin: 0.2rem 0 0;
      color: var(--paper);
      font-weight: 600;
      font-size: 1.35rem;
      font-family: var(--font-display);
      font-variant-numeric: tabular-nums;
      letter-spacing: -0.02em;
      line-height: 1.15;
    }
  }

  .vbp-cta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-m);
    margin: 0 0 var(--space-xl);
  }

  .vbp-note-link {
    color: var(--crimson-text);
    font-size: 0.9rem;
  }


  /* ── The workbench ──────────────────────────────────────────────────────
     Moved here off the landing page: the home page is an index, and this
     needs room to be used rather than glanced at (DESIGN.md §2). */
  .vbp-demo {
    margin-bottom: var(--space-l);
    border-top: 1px solid var(--hairline-on-ink);
    padding-top: var(--space-l);
  }

  .vbp-demo-label {
    margin: 0 0 0.3rem;
  }

  .vbp-demo-note {
    margin: 0 0 var(--space-m);
    color: var(--paper-soft);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  /* ── The search router (Curation) ───────────────────────────────────────
     Shared logarithmic axis. On a linear scale the 1 ms path is a sliver and
     the panel's whole point disappears. */
  .rt-router {
    position: relative;
    border-top: 1px solid var(--border-color-subtle);
    padding-top: var(--space-m);
  }

  .rt-route + .rt-route {
    margin-top: var(--space-m);
    border-top: 1px solid var(--border-color-subtle);
    padding-top: var(--space-m);
  }

  .rt-route-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-s);
    margin: 0 0 0.4rem;
  }

  .rt-route-name {
    color: var(--marigold-text);
  }

  .rt-route-ms {
    color: var(--paper-soft);
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    font-variant-numeric: tabular-nums;
  }

  .rt-track {
    position: relative;
    border-radius: 999px;
    background: var(--ink-2);
    height: 6px;
  }

  .rt-bar {
    position: absolute;
    top: 0;
    bottom: 0;
    border-radius: 999px;
    background: var(--grad-signal);
  }

  .rt-route-when {
    margin: 0.5rem 0 0.1rem;
    color: var(--paper);
    font-size: 0.92rem;
  }

  .rt-route-eg {
    margin: 0 0 0.25rem;
    color: var(--glacier-text);
    font-size: 0.65rem;
    letter-spacing: 0.06em;
    text-transform: none;
  }

  .rt-route-why {
    margin: 0;
    color: var(--paper-soft);
    font-size: 0.88rem;
    line-height: 1.55;
  }

  .rt-axis {
    position: relative;
    margin-top: var(--space-s);
    border-top: 1px solid var(--border-color-subtle);
    height: 1.2rem;
  }

  .rt-tick {
    position: absolute;
    top: 0.25rem;
    transform: translateX(-50%);
    color: var(--paper-soft);
    font-size: 0.58rem;
    letter-spacing: 0.08em;
  }

  /* ── The /v1 API (Cue) ──────────────────────────────────────────────────
     A manifest, not a console. Rules rather than boxes: this is a spec sheet,
     and a card grid would make it look like a dashboard. */
  .api-list {
    margin: 0 0 var(--space-m);
    border-top: 1px solid var(--border-color-subtle);
    padding: 0;
    list-style: none;
  }

  .api-row {
    display: grid;
    grid-template-columns: 3.2rem minmax(0, auto) minmax(0, 1fr);
    align-items: baseline;
    gap: 0.4rem 0.8rem;
    border-bottom: 1px solid var(--border-color-subtle);
    padding: 0.55rem 0;
  }

  .api-m {
    font-size: 0.6rem;
    letter-spacing: 0.1em;
  }

  .api-m-post {
    color: var(--marigold-text);
  }

  .api-m-get {
    color: var(--glacier-text);
  }

  .api-p {
    color: var(--paper);
    font-size: 0.85rem;
    font-family: var(--font-mono);
  }

  .api-d {
    color: var(--paper-soft);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .api-facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 1px;
    margin: 0;
    border: 1px solid var(--hairline-on-ink);
    border-radius: var(--radius-large);
    background: var(--hairline-on-ink);
    overflow: hidden;

    > div {
      background: var(--ink);
      padding: 0.6rem 0.75rem;
    }

    dt {
      margin: 0;
      color: var(--paper-soft);
      font-size: 0.6rem;
      letter-spacing: 0.1em;
    }

    dd {
      margin: 0.2rem 0 0;
      color: var(--paper);
      font-size: 0.85rem;
      line-height: 1.45;
    }
  }

  @media (max-width: 599px) {
    .api-row {
      grid-template-columns: 3.2rem minmax(0, 1fr);
    }

    .api-d {
      grid-column: 1 / -1;
    }
  }

  /* ── What's underneath ──────────────────────────────────────────────────
     Stacked rows, not a card grid: a portfolio that lays capabilities out in
     tiles reads as a product dashboard (docs/design/DESIGN.md P1). Separation
     is a hairline, and the stack degrades honestly from four rows to one —
     Choon has a single capability and still looks deliberate.
     No numbering: `order` is authoring order, not a pipeline. */
  .vbp-caps {
    border-top: 1px solid var(--hairline-on-ink);
    padding-top: var(--space-l);
  }

  .vbp-caps-label {
    margin: 0 0 var(--space-m);
  }

  .vbp-caps-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .vbp-cap + .vbp-cap {
    margin-top: var(--space-l);
    border-top: 1px solid var(--border-color-subtle);
    padding-top: var(--space-l);
  }

  .vbp-cap-name {
    position: relative;
    margin: 0 0 0.2rem;
    padding-left: 1.4rem;
    color: var(--paper);
    font-weight: 600;
    font-size: var(--font-size-1);
    font-family: var(--font-display);
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  /* The signal tick — the site's mark for "a station on the path". */
  .vbp-cap-name::before {
    position: absolute;
    top: 0.62em;
    left: 0;
    background: var(--grad-signal);
    width: 14px;
    height: 2px;
    content: '';
  }

  .vbp-cap-tagline {
    margin: 0 0 var(--space-xs);
    padding-left: 1.4rem;
    color: var(--paper-soft);
    line-height: 1.5;
  }

  .vbp-cap-features {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.1rem;
    margin: 0 0 0.6rem;
    padding: 0 0 0 1.4rem;
    list-style: none;

    li {
      position: relative;
      padding-left: 0.85rem;
      color: var(--paper-soft);
      font-size: 0.85rem;
    }

    li::before {
      position: absolute;
      top: 0.55em;
      left: 0;
      border-radius: 50%;
      background: var(--glacier);
      width: 4px;
      height: 4px;
      content: '';
    }
  }

  .vbp-cap-stack {
    margin: 0;
    padding-left: 1.4rem;
    color: var(--paper-soft);
    font-size: 0.65rem;
    letter-spacing: 0.1em;
  }
</style>
