---
export const prerender = true

import DefaultLayout from '@layouts/DefaultLayout.astro'
import PageHero from '@components/PageHero.astro'

/**
 * Where the contact form lands (CloseSection posts here via Netlify Forms).
 * A real person just sent a real message — confirm what happened, say when
 * they'll hear back, and give them somewhere to go next.
 */
---

<DefaultLayout
  title="Message sent — Bishal Upadhyaya"
  description="Your message reached Bishal's inbox."
>
  <PageHero title="Message sent" subtitle="It's in my inbox. I read everything myself." />

  <section class="ty">
    <div class="ty-inner">
      <p class="ty-lede" data-reveal>
        I'll reply within two business days, usually sooner. If it's urgent, email me at
        <a href="mailto:bishal@vibeset.ai">bishal@vibeset.ai</a>.
      </p>

      <p class="ty-note" data-reveal>
        If I'm not the right fit, I'll tell you and point you to someone who is.
      </p>

      <p class="ty-ctas" data-reveal>
        <a class="btn-pill" href="/#vibeset">See what I've shipped ↳</a>
        <a class="ty-cta-quiet" href="/notes/choon">Or read an engineering case note</a>
      </p>
    </div>
  </section>
</DefaultLayout>

<style lang="scss">
  .ty {
    padding: var(--space-2xl) 0 var(--space-3xl);
  }

  .ty-inner {
    margin: 0 auto;
    padding: 0 var(--space-l);
    max-width: 640px;
  }

  .ty-lede {
    margin: 0 0 var(--space-s);
    color: var(--paper);
    font-size: var(--font-size-1);
    line-height: 1.6;
  }

  .ty-lede a {
    color: var(--crimson-text);

    &:hover {
      color: var(--marigold);
    }
  }

  .ty-note {
    margin: 0 0 var(--space-l);
    color: var(--paper-soft);
    line-height: 1.6;
  }

  .ty-ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-s) var(--space-m);
    margin: 0;
  }


  .ty-cta-quiet {
    color: var(--paper-soft);
    font-size: 0.95rem;

    &:hover {
      color: var(--marigold);
    }
  }
</style>
