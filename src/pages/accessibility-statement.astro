---
export const prerender = true

import DefaultLayout from '@layouts/DefaultLayout.astro'
import PageHero from '@components/PageHero.astro'

/**
 * Accessibility statement — written as an engineering note, not boilerplate
 * (docs/design/DESIGN.md P9: proof over claim). Every threshold below is
 * enforced by .claude/skills/verify-site and fails the check if it regresses.
 *
 * When the gates or the known gaps change, change this page in the same commit.
 */

const gates = [
  { label: 'axe-core violations', value: '0', note: 'across /, /about, /research, /vibeset/choon' },
  { label: 'Lighthouse accessibility', value: '100', note: 'mobile, production build' },
  { label: 'Lighthouse best practices', value: '100', note: 'mobile, production build' },
  { label: 'Cumulative layout shift', value: '0', note: 'not "good" — zero' },
  { label: 'Total blocking time', value: '≤ 200 ms', note: 'measured on throttled mobile' },
]

const lastVerified = 'August 2026'
---

<DefaultLayout
  title="Accessibility — Bishal Upadhyaya"
  description="How bishal.ai is built for accessibility, what it is measured against, and what is still imperfect."
>
  <PageHero
    title="Accessibility"
    subtitle="What this site is measured against, and where it still falls short."
  />

  <article class="a11y">
    <div class="a11y-inner">
      <section class="a11y-section" data-reveal>
        <p class="a11y-lede">
          This site targets <strong>WCAG 2.2 Level AA</strong>. That claim is checked by a script rather
          than asserted — every number below is a gate in the build, and the check fails if any of them
          regresses.
        </p>
      </section>

      <section class="a11y-section" data-reveal>
        <h2 class="a11y-h2"><span class="label-mono a11y-no">Measured</span>The gates</h2>
        <ul class="a11y-gates" data-reveal-stagger>
          {
            gates.map((g) => (
              <li class="a11y-gate" data-reveal>
                <p class="a11y-gate-value">{g.value}</p>
                <p class="a11y-gate-label label-mono">{g.label}</p>
                <p class="a11y-gate-note">{g.note}</p>
              </li>
            ))
          }
        </ul>
        <p class="a11y-method label-mono">
          tooling: playwright + @axe-core/playwright · lighthouse · last full pass {lastVerified}
        </p>
      </section>

      <section class="a11y-section" data-reveal>
        <h2 class="a11y-h2"><span class="label-mono a11y-no">Built in</span>What that means in practice</h2>
        <ul class="a11y-list">
          <li>
            <strong>Keyboard first.</strong> Every control is reachable and operable by keyboard, and focus
            is always visible — a 2px crimson outline, never merged with the hover style.
          </li>
          <li>
            <strong>Motion is optional.</strong> With <code>prefers-reduced-motion</code> set, the page is
            complete, functional and fully drawn — just still. Nothing is hidden and nothing collapses;
            animated indicators render their resting state instead.
          </li>
          <li>
            <strong>Nothing depends on JavaScript to be read.</strong> Scroll-reveal animations are
            opt-out: without JS, all content renders immediately rather than staying invisible.
          </li>
          <li>
            <strong>Type is chosen for legibility.</strong> Body copy is set in Atkinson Hyperlegible,
            designed to raise character distinction for low-vision readers.
          </li>
          <li>
            <strong>Contrast is tokenized.</strong> Accent colours that do not meet AA at small sizes have
            separate text-safe variants, so the accessible value is the easy one to reach for.
          </li>
          <li>
            <strong>Loading never traps you.</strong> There are no spinners or skeleton screens; progress
            is a labelled status region with a text caption.
          </li>
        </ul>
      </section>

      <section class="a11y-section" data-reveal>
        <h2 class="a11y-h2"><span class="label-mono a11y-no">Gaps</span>Where it falls short</h2>
        <p>
          A statement that lists no problems isn't a statement, it's marketing. Current known issues:
        </p>
        <ul class="a11y-list">
          <li>
            <strong>The audio workbench is visual-first.</strong> The Choon stress test communicates
            through a spectrum canvas. Results are announced as text, but the live spectrum itself has no
            non-visual equivalent.
          </li>
          <li>
            <strong>Automated testing has limits.</strong> Zero axe violations is a floor, not a
            guarantee. Axe catches roughly a third to a half of real accessibility problems; the rest need
            people. This site has not yet been tested by a screen-reader user who does not build it.
          </li>
          <li>
            <strong>Third-party content isn't covered.</strong> Links out to the Vibeset products lead to
            applications with their own, separately-tracked accessibility posture.
          </li>
        </ul>
      </section>

      <section class="a11y-section" data-reveal>
        <h2 class="a11y-h2"><span class="label-mono a11y-no">Contact</span>Found a barrier?</h2>
        <p>
          Tell me and I'll fix it. Accessibility bugs go to the front of the queue — they're the one
          category where "works for most people" isn't a passing grade.
        </p>
        <p class="a11y-contact">
          <a class="a11y-mail" href="mailto:bishal@vibeset.ai?subject=Accessibility%20on%20bishal.ai"
            >bishal@vibeset.ai ↳</a
          >
        </p>
        <p class="a11y-updated label-mono">last reviewed {lastVerified} against wcag 2.2 aa</p>
      </section>
    </div>
  </article>
</DefaultLayout>

<style lang="scss">
  .a11y {
    padding: var(--space-2xl) 0 var(--space-3xl);
  }

  .a11y-inner {
    margin: 0 auto;
    padding: 0 var(--space-l);
    max-width: 780px;
  }

  .a11y-section + .a11y-section {
    margin-top: var(--space-2xl);
  }

  .a11y-lede {
    margin: 0;
    color: var(--paper);
    font-size: var(--font-size-1);
    line-height: 1.6;
  }

  .a11y-h2 {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-xs);
    margin: 0 0 var(--space-s);
    font-weight: 600;
    font-size: var(--font-size-3);
    font-family: var(--font-display);
    letter-spacing: -0.015em;
    line-height: 1.1;
  }

  .a11y-no {
    color: var(--marigold);
  }

  /* The 1px grid gap is the hairline — no borders to keep in sync. */
  .a11y-gates {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 1px;
    margin: 0 0 var(--space-s);
    border: 1px solid var(--hairline-on-ink);
    border-radius: var(--radius-large);
    background: var(--hairline-on-ink);
    padding: 0;
    overflow: hidden;
    list-style: none;
  }

  .a11y-gate {
    margin: 0;
    background: var(--ink);
    padding: var(--space-s);
  }

  .a11y-gate-value {
    margin: 0;
    color: var(--paper);
    font-weight: 600;
    font-size: 1.6rem;
    font-family: var(--font-display);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .a11y-gate-label {
    margin: 0.35rem 0 0;
  }

  .a11y-gate-note {
    margin: 0.2rem 0 0;
    color: var(--paper-soft);
    font-size: 0.8rem;
    line-height: 1.4;
  }

  .a11y-method {
    margin: 0;
    color: var(--paper-soft);
  }

  .a11y-list {
    margin: var(--space-xs) 0 0;
    padding: 0;
    list-style: none;
  }

  .a11y-list li {
    position: relative;
    margin: 0 0 var(--space-s);
    padding-left: var(--space-m);
    color: var(--paper-soft);
    line-height: 1.6;
  }

  /* A short signal tick, not a bullet glyph. */
  .a11y-list li::before {
    position: absolute;
    top: 0.7em;
    left: 0;
    background: var(--grad-signal);
    width: 12px;
    height: 2px;
    content: '';
  }

  .a11y-list strong {
    color: var(--paper);
    font-weight: 600;
  }

  .a11y-section p {
    color: var(--paper-soft);
    line-height: 1.6;
  }

  .a11y-contact {
    margin: var(--space-s) 0 var(--space-m);
  }

  .a11y-mail {
    color: var(--crimson-text);
    font-size: var(--font-size-1);
    text-decoration: none;
  }

  .a11y-mail:hover {
    color: var(--marigold);
  }

  .a11y-updated {
    margin: 0;
    border-top: 1px solid var(--border-color-subtle);
    padding-top: var(--space-s);
    color: var(--paper-soft);
  }
</style>
