---
import Navigation from '../components/Navigation.astro'
import { Link, SkipLink } from 'accessible-astro-components'
import { Icon } from 'astro-icon/components'
import ThemeToggle from './ThemeToggle.astro'

/**
 * Header Component - Bishal Upadhyaya Portfolio
 * Transparent → frosted-glass compressed bar on scroll (dvdrod.com pattern).
 *
 * Section links are root-relative (/#work) so they work from every page,
 * not just home — the script below intercepts them and smooth-scrolls when
 * the target is already on this page. About is a real route; Research lives
 * on the home page and its full list hangs off that section, not the nav.
 *
 * `.scrolled` is applied HERE, at build time, on every non-home route — the
 * script below already sets it unconditionally off `!isHome`, so this only
 * moves the decision earlier. It matters because `.scrolled` changes the
 * header's HEIGHT (+1px border, logo 1.5rem → 1.2rem): applying it after
 * hydration shifted every non-home page by ~4px. Invisible while the header is
 * `position: fixed` and nothing below it moves — but /naam puts the header in
 * flow so it can size a 100svh app, and there that shift would resize the whole
 * page after load, against a CLS-0 gate.
 */
const isHome = Astro.url.pathname === '/'
/* /naam pins its own palette and does not read the ground tokens, so the
   toggle would sit there looking pressable and change nothing. A control that
   appears to do nothing is worse than no control. Hiding it here rather than
   in naam keeps that page untouched. */
const showThemeToggle = !Astro.url.pathname.startsWith('/naam')
---

<header id="site-header" class:list={{ scrolled: !isHome }}>
  <SkipLink />
  <Navigation>
    <li class="menu-item">
      <a href="/#hero" class="nav-anchor">Home</a>
    </li>
    <li class="menu-item">
      <a href="/#work" class="nav-anchor">Work</a>
    </li>
    <li class="menu-item">
      <a href="/#research" class="nav-anchor">Research</a>
    </li>
    <li class="menu-item">
      <a href="/about">About</a>
    </li>
    <li class="menu-item">
      <a href="/naam">Naam</a>
    </li>
    <li class="menu-item">
      <a href="/#contact" class="nav-anchor">Contact</a>
    </li>
    <li class="menu-item type-icon animate-rotate">
      <Link href="https://github.com/bishalu">
        <Icon aria-hidden="true" name="lucide:github" />
        <span class="sr-only">GitHub Profile</span>
      </Link>
    </li>
    {showThemeToggle && <ThemeToggle />}
  </Navigation>
</header>

<script>
  document.addEventListener('astro:page-load', () => {
    const header = document.getElementById('site-header') as HTMLElement | null
    if (!header) return

    // Non-home pages keep the frost permanently so the bar always separates
    // from the content under it. Home starts transparent over the hero.
    const isHome = window.location.pathname === '/'

    // Scroll compression — add .scrolled when past 60px
    const onScroll = () => {
      if (!isHome || window.scrollY > 60) {
        header.classList.add('scrolled')
      } else {
        header.classList.remove('scrolled')
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true })
    onScroll() // run once on load

    // Smooth-scroll section links when their target is on this page; from any
    // other page, let the browser navigate to /#section normally.
    const anchors = header.querySelectorAll<HTMLAnchorElement>('a.nav-anchor')
    anchors.forEach((anchor) => {
      anchor.addEventListener('click', (e) => {
        const hash = anchor.hash
        if (!hash) return
        const target = document.querySelector(hash)
        if (!target) return
        e.preventDefault()
        target.scrollIntoView({ behavior: 'smooth' })
        history.pushState(null, '', hash)
      })
    })

    /* ── Where am I ────────────────────────────────────────────────────────
       The home page is one long scroll through four sections, and until now the
       nav gave no indication which one you were in. This marks the current
       section as you pass through it — no new nav items, no new colours, just
       the existing label losing its dimming and gaining a rule.

       aria-current="true" rather than "page": the target is a section of this
       page, not a different page. */
    if (!isHome) return
    const sections = Array.from(anchors)
      .map((a) => ({ a, el: a.hash ? document.querySelector(a.hash) : null }))
      .filter((s): s is { a: HTMLAnchorElement; el: Element } => !!s.el)
    if (!sections.length) return

    const mark = (active: Element | null) => {
      for (const { a, el } of sections) {
        const on = el === active
        a.classList.toggle('is-current', on)
        if (on) a.setAttribute('aria-current', 'true')
        else a.removeAttribute('aria-current')
      }
    }

    // Threshold sits near the top of the viewport so the "current" section is
    // the one being read, not whichever happens to be largest on screen.
    const spy = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) mark(entry.target)
        }
      },
      { rootMargin: '-20% 0px -70% 0px' },
    )
    sections.forEach(({ el }) => spy.observe(el))
  })
</script>

<style lang="scss" is:global>
  #site-header {
    position: fixed;
    top: 0;
    z-index: 200;
    transition:
      padding 0.35s cubic-bezier(0.4, 0, 0.2, 1),
      background 0.35s cubic-bezier(0.4, 0, 0.2, 1),
      box-shadow 0.35s cubic-bezier(0.4, 0, 0.2, 1),
      backdrop-filter 0.35s ease;
    box-shadow: none;
    border: none;
    background-color: transparent;
    padding: 0;
    width: 100%;

    /* ── Compressed state (after scroll): frosted paper ──────────────────────
       This was hand-written as rgba(24, 28, 48, 0.82) — dark glass, invisible
       to any token sweep, and the single most conspicuous artifact a ground
       change can leave behind: a night-coloured bar pinned over a bone page. */
    &.scrolled {
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border-bottom: 1px solid var(--hairline-on-ink);
      background: var(--console-bg);

      /* Tighten inner padding */
      > .container {
        padding-top: 0.55rem;
        padding-bottom: 0.55rem;
      }

      /* Shrink logo slightly */
      .logo-text {
        font-size: 1.2rem;
      }

      /* Shrink nav text slightly */
      nav a,
      nav button {
        font-size: 0.68rem;
      }
    }

    a,
    button {
      opacity: 1 !important;
      color: var(--paper) !important;
      font-weight: 500;
      font-size: 0.72rem;
      font-family: var(--font-mono);
      letter-spacing: var(--tracking-label);
      text-transform: uppercase;

      &:hover,
      &:focus-visible {
        opacity: 0.7 !important;
        text-decoration: none;
      }
    }

    /* The section you are in. Marked with a rule as well as weight — a colour
       or opacity difference alone would be the only signal, and WCAG 1.4.1
       rules that out. Nothing moves; the label just stops being one of five. */
    a.is-current {
      position: relative;
      font-weight: 700;

      &::after {
        position: absolute;
        bottom: -5px;
        left: 0;
        background: var(--crimson);
        width: 100%;
        height: 2px;
        content: '';
      }
    }

    .type-icon {
      display: block;
      margin-inline: -7px;

      svg {
        fill: currentColor;
        inline-size: 26px;
        block-size: 26px;
        color: var(--paper) !important;
      }
    }
  }
</style>
