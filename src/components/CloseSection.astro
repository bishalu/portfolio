---
/**
 * CloseSection — the ink closing band (docs/design/DESIGN.md §5.6).
 * Work-with-me tiers (decluttered) + a real inline contact form. The signal
 * terminates here: a final trace runs into the form's submit button.
 */
import { Icon } from 'astro-icon/components'
---

<section class="cs on-ink" id="contact">
  <div class="cs-inner">
    <span id="work-with-me" class="cs-anchor" aria-hidden="true"></span>

    <header class="cs-head" data-reveal>
      <p class="cs-head-eyebrow">Work with me</p>
      <h2 class="cs-title">Bring me the hard part.</h2>
    </header>

    <!-- Prose, not a pricing table. A tier grid with a "most chosen" badge is
         SaaS grammar, and it sat in the last impression slot on a personal
         site (docs/design/DESIGN.md P11). Same three options, said plainly,
         with a face attached — there was no photograph of Bishal anywhere on
         this page. -->
    <div class="cs-intro" data-reveal>
      <!-- The source is a wide landscape shot where the subject is small, so a
           plain cover-crop lands on scenery. Zoom to the face inside the
           circle instead of shipping a second asset. -->
      <span class="cs-portrait">
        <img src="/about-portrait.webp" alt="Bishal Upadhyaya" width="88" height="88" loading="lazy" decoding="async" />
      </span>
      <p class="cs-intro-line">
        Send me a product, a workflow, a dataset, or the problem you can't get anyone to take seriously.
        I'll usually come back with something you can look at. If it's worth continuing, a short paid
        pilot; if that works, fractional or ongoing. And if I'm not the right fit, I'll say so and point
        you to someone who is.
      </p>
    </div>

    <div class="cs-bottom">
      <div class="cs-form-wrap" data-reveal>
        <div class="cs-terminal" aria-hidden="true">
          <svg viewBox="0 0 300 24" preserveAspectRatio="none" fill="none">
            <path
              d="M0 12 H180 L192 12 198 4 204 20 210 8 216 14 222 12 H300"
              stroke="url(#cs-grad)"
              stroke-width="2"
              stroke-linecap="round"></path>
            <defs>
              <linearGradient id="cs-grad" x1="0" y1="0" x2="300" y2="0" gradientUnits="userSpaceOnUse">
                <stop offset="0" stop-color="var(--crimson)"></stop>
                <stop offset="1" stop-color="var(--marigold)"></stop>
              </linearGradient>
            </defs>
          </svg>
        </div>

        <!-- Posts to a real endpoint. This used to carry data-netlify and post
             to Netlify Forms, which never received a single submission: Forms
             intercepts at the edge, but this site is output:'server' and the
             adapter's preferStatic only covers GET, so every POST landed in the
             SSR function instead. /api/contact sends the mail itself. No JS
             required — the endpoint answers a plain form POST with a 303. -->
        <form id="cs-form" class="cs-form" name="contact" method="POST" action="/api/contact">
          <div class="cs-form-row">
            <label>
              <span class="label-mono">Name</span>
              <input type="text" name="firstname" required autocomplete="name" />
            </label>
            <label>
              <span class="label-mono">Email</span>
              <input type="email" name="email" required autocomplete="email" />
            </label>
          </div>
          <label>
            <span class="label-mono">A link, if there is one</span>
            <input type="url" name="link" autocomplete="url" placeholder="https://" />
          </label>
          <label>
            <span class="label-mono">What would you like me to look at?</span>
            <textarea name="message" rows="4" required></textarea>
          </label>

          <!-- Honeypot. Real people never see it; bots fill everything. Kept out
               of the accessibility tree AND out of tab order, so it cannot be
               reached by keyboard or announced. -->
          <div class="cs-hp" aria-hidden="true">
            <label>
              Company
              <input type="text" name="company" tabindex="-1" autocomplete="off" />
            </label>
          </div>

          <button type="submit" class="cs-send btn">Send it ↳</button>
        </form>
      </div>

      <div class="cs-direct" data-reveal>
        <!-- One way out, not three. GitHub and LinkedIn already sit in the footer;
             repeating them here split attention at the moment the page asks for
             one thing. -->
        <p class="cs-direct-line">Or skip the form.</p>
        <ul class="cs-links">
          <li>
            <a href="mailto:bishal@vibeset.ai">
              <Icon aria-hidden="true" name="lucide:mail" size={16} />
              bishal@vibeset.ai
            </a>
          </li>
        </ul>

      </div>
    </div>
  </div>
</section>

<style lang="scss">
  .cs {
    padding: var(--space-3xl) 0;
  }

  .cs-inner {
    position: relative;
    margin: 0 auto;
    padding: 0 var(--space-l);
    max-width: 1200px;
  }

  .cs-anchor {
    position: absolute;
    top: -80px;
  }

  .cs-head {
    margin-bottom: var(--space-xl);
  }

  .cs-head-eyebrow {
    margin: 0 0 var(--space-xs);
    color: var(--paper-soft);
    font-size: 0.95rem;
  }

  .cs-title {
    margin: var(--space-xs) 0 0;
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    line-height: 1.02;
    letter-spacing: -0.015em;
  }

  /* ── How to work together ──────────────────────────────────────────── */
  .cs-intro {
    display: flex;
    align-items: flex-start;
    gap: var(--space-m);
    margin-bottom: var(--space-2xl);
    max-width: 680px;
  }

  .cs-portrait {
    display: block;
    position: relative;
    flex-shrink: 0;
    border: 1px solid var(--hairline-on-ink);
    border-radius: 50%;
    width: 88px;
    height: 88px;
    overflow: hidden;

    img {
      display: block;
      transform: scale(2.6);
      transform-origin: 50% 46%;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }

  .cs-intro-line {
    margin: 0;
    color: var(--paper-soft);
    font-size: 1.02rem;
    line-height: 1.7;
  }

  /* ── Form + direct ─────────────────────────────────────────────────── */
  .cs-bottom {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    align-items: start;
    gap: clamp(2rem, 5vw, 5rem);
  }

  .cs-terminal {
    margin-bottom: var(--space-s);
    height: 24px;

    svg {
      width: 100%;
      height: 100%;
    }
  }

  .cs-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }

  .cs-form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-s);
  }

  .cs-form label {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .cs-form input,
  .cs-form textarea {
    transition: border-color var(--dur-base) ease;
    border: 1px solid var(--hairline-on-ink);
    border-radius: 10px;
    background: var(--ink-2);
    padding: 0.65rem 0.85rem;
    color: var(--paper);
    font-size: 0.95rem;
    font-family: var(--font-body);

    &:focus {
      outline: none;
      border-color: var(--crimson);
    }
  }

  .cs-hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .cs-send {
    align-self: flex-start;
    cursor: pointer;
    border: none;
    border-radius: 999px;
    background: var(--crimson-deep);
    padding: 0.7rem 1.6rem;
    color: var(--on-fill);
    font-weight: 500;
    font-size: 0.85rem;
    font-family: var(--font-mono);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;

    &:hover {
      box-shadow: var(--glow-crimson);
    }
  }

  .cs-direct-line {
    margin: 0 0 var(--space-m);
    color: var(--paper-soft);
    font-size: 1rem;
    line-height: 1.6;
  }


  .cs-balgo-link {
    font-weight: 700;
  }

  .cs-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    margin: 0;
    padding: 0;
    list-style: none;

    a {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      color: var(--paper);
      font-size: 0.9rem;
      font-family: var(--font-mono);

      &:hover {
        color: var(--marigold-text);
      }

      svg {
        color: var(--marigold-text);
      }
    }
  }

  /* ── Responsive ────────────────────────────────────────────────────── */
  @media (max-width: 1023px) {
    .cs-bottom {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 599px) {
    .cs-form-row {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 479px) {
    .cs-inner {
      padding: 0 var(--space-m);
    }
  }
</style>
