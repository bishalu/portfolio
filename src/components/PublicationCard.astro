---
/**
 * PublicationCard — one paper on /research.
 *
 * Not a card, despite the name. DESIGN.md §0 rules out card grids: they are
 * what makes a personal site read as a product dashboard, and four bordered
 * boxes on a bordered page was the clearest example of it left on the site.
 * A paper is an entry in a record, so it is set as one — hairline-separated,
 * left-aligned, the year in the margin.
 *
 * The name stays because /research imports it and renaming a component is not
 * what this change is about.
 */
interface Props {
  title: string
  abstract: string
  year: number
  journal?: string
  doi?: string
  pdf?: string
  coauthors?: string[]
  tags?: string[]
}

const { title, abstract, year, journal, doi, pdf, coauthors = [], tags = [] } = Astro.props

/* Three of the four entries carry placeholder coauthors — "Research Group",
   "Lab Colleagues", "Research Team". Printing those is worse than printing
   nothing: it reads as a redaction, and it goes into the ScholarlyArticle
   JSON-LD as a Person named "Research Group". Real names render; placeholders
   are dropped until real ones exist. */
const PLACEHOLDER = /^(research (group|team)|lab colleagues)$/i
const namedAuthors = coauthors.filter((a) => !PLACEHOLDER.test(a.trim()))
---

<article class="pub">
  <!-- The spike train, which /research was the one page not to carry.
       Publications about action potentials, drawn as one — it is the site's
       oldest and most specific device, and the page built for the papers was
       the page reading as a plain document without it. Same glyph and same
       gradient as ResearchTimeline on the home page; the id is namespaced so
       two instances on one document cannot collide. -->
  <span class="pub-spike" aria-hidden="true">
    <svg viewBox="0 0 24 48" width="24" height="48" fill="none">
      <defs>
        <linearGradient id="pub-grad" x1="0" y1="0" x2="0" y2="48" gradientUnits="userSpaceOnUse">
          <stop offset="0" stop-color="var(--crimson)"></stop>
          <stop offset="1" stop-color="var(--marigold)"></stop>
        </linearGradient>
      </defs>
      <path
        d="M12 0 V16 L8 20 L16 26 L12 30 V48"
        stroke="url(#pub-grad)"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  </span>

  <p class="pub-meta label-mono">
    <span class="pub-year">{year}</span>
    {journal && <span class="pub-journal">{journal}</span>}
  </p>

  <h2 class="pub-title">{title}</h2>

  {namedAuthors.length > 0 && <p class="pub-authors">with {namedAuthors.join(', ')}</p>}

  <p class="pub-abstract">{abstract}</p>

  {
    tags.length > 0 && (
      <p class="pub-tags label-mono--sm">
        {tags.map((tag, i) => (
          <>
            {i > 0 && <span class="pub-sep" aria-hidden="true"> · </span>}
            <span>{tag}</span>
          </>
        ))}
      </p>
    )
  }

  {
    (doi || pdf) && (
      <p class="pub-links label-mono">
        {doi && (
          <a href={`https://doi.org/${doi}`} target="_blank" rel="noopener noreferrer">
            DOI ↳
          </a>
        )}
        {pdf && (
          <a href={pdf} target="_blank" rel="noopener noreferrer">
            PDF ↳
          </a>
        )}
      </p>
    )
  }
</article>

<style lang="scss">
  /* The rail sits in its own 24px column in the margin, so the record's text
     keeps the left edge it already had and the spike hangs beside it. */
  .pub {
    display: grid;
    grid-template-columns: 24px minmax(0, 1fr);
    column-gap: var(--space-m);
    border-top: 1px solid var(--hairline-on-ink);
    padding: var(--space-l) 0 0;

    > *:not(.pub-spike) {
      grid-column: 2;
    }
  }

  .pub-spike {
    display: flex;
    grid-row: 1 / -1;
    grid-column: 1;
    justify-content: center;
    padding-top: 0.2rem;

    svg {
      flex-shrink: 0;
    }
  }

  /* Below the text column the margin is worth more than the ornament. */
  @media (max-width: 560px) {
    .pub {
      display: block;
    }

    .pub-spike {
      display: none;
    }
  }

  .pub-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.9rem;
    margin: 0 0 var(--space-xs);
  }

  .pub-year {
    color: var(--crimson-text);
  }

  .pub-title {
    margin: 0;
    max-width: 40ch;
    color: var(--paper);
    font-weight: 600;
    font-size: clamp(1.15rem, 2vw, 1.4rem);
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .pub-authors {
    margin: var(--space-2xs) 0 0;
    color: var(--paper-soft);
    font-size: 0.9rem;
  }

  .pub-abstract {
    margin: var(--space-s) 0 0;
    max-width: 68ch;
    color: var(--paper-soft);
    font-size: 1rem;
    line-height: 1.75;
  }

  .pub-tags {
    margin: var(--space-s) 0 0;
    color: var(--paper-soft);
  }

  .pub-sep {
    opacity: 0.55;
  }

  .pub-links {
    display: flex;
    gap: var(--space-m);
    margin: var(--space-s) 0 0;

    a {
      color: var(--paper-soft);

      &:hover {
        color: var(--marigold-text);
      }
    }
  }
</style>
