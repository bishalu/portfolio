---
/**
 * Work — the spine (docs/design/DESIGN.md §0, §5–6).
 *
 * Five stations on one signal path, not a card grid. Three of them are the
 * Vibeset products, each with a running instrument: Curation (live search),
 * Cue (local sync workbench), Choon (published eval, failing row included).
 * Two are outside music — Golo and KTM Capital — and they are IN this spine
 * rather than in a footnote strip after it, because they are the only evidence
 * on the site for voice and for behaviour-shaped data, and those are two of the
 * things the positioning leads with. A capability mentioned after the proof
 * section has already lost the argument.
 *
 * Each station carries a transferable line: the thing it demonstrates that has
 * nothing to do with music. That line is the section's whole job.
 */
import { getCollection } from 'astro:content'
import VibeFinder from '@components/VibeFinder.tsx'
import CueSync from '@components/CueSync.tsx'
// Imported at build time, not fetched: the widget's claim is that it does no
// network work, and that should be literally true.
import cueSync from '../data/cue-sync.json'

const products = (await getCollection('products')).sort((a, b) => a.data.order - b.data.order)
const bySlug = Object.fromEntries(products.map((p) => [p.id.replace(/\.mdx$/, ''), p.data]))
const curation = bySlug['curation']
const cue = bySlug['cue']
const choon = bySlug['choon']
---

<section class="vs" id="work">
  <!-- /#work was the anchor for a year and is linked from the product pages,
       the footer and anything anyone has bookmarked. It stays as an alias. -->
  <span id="vibeset" class="vs-anchor" aria-hidden="true"></span>
  <div class="vs-inner">
    <header class="vs-head" data-reveal>
      <p class="vs-head-eyebrow">Work</p>
      <h2 class="vs-title">Where these systems ship today.</h2>
      <p class="vs-lede">
        Music is where this ships today. The problems underneath are not musical: audio understood at
        catalog scale, video and sound aligned in time, retrieval that has to be cheap <em>and</em> right,
        models small enough to run anywhere, and evaluation honest enough to trust. Three of these are
        running below — the last two are not about music at all.
      </p>
    </header>

    <!-- ── FIND · Curation ─────────────────────────────────────────────── -->
    <article class="vs-station" data-reveal="settle">
      <div class="vs-copy">
        <p class="vs-eyebrow label-mono"><span class="vs-eyebrow-stage">{curation.eyebrow}</span> · {curation.name}</p>
        <p class="vs-transfer">Retrieval that picks its own strategy</p>
        <h3 class="vs-name"><a href="/vibeset/curation">{curation.tagline}</a></h3>
        <p class="vs-desc">{curation.description}</p>
        <p class="vs-stats label-mono">
          {curation.stats.map((s, i) => <span>{i > 0 && <span class="vs-stat-dot"> · </span>}{s.label} {s.value}</span>)}
        </p>
        <p class="vs-ctas">
          <a class="btn-pill" href={curation.liveUrl} rel="noopener">{curation.liveLabel} ↳</a>
        </p>
      </div>
      <div class="vs-demo">
        <p class="vs-demo-label label-mono">
          <!-- Bars rather than a dot: what is running here is an audio catalog,
               not a service healthcheck. A swap, not an addition — see MOTION.md §2. -->
          <span class="sig-eq" aria-hidden="true"><span></span><span></span><span></span></span>
          live
        </p>
        <VibeFinder client:visible />
      </div>
    </article>

    <!-- ── FIT · Cue ───────────────────────────────────────────────────── -->
    <article class="vs-station" data-reveal="settle">
      <div class="vs-copy">
        <p class="vs-eyebrow label-mono"><span class="vs-eyebrow-stage">{cue.eyebrow}</span> · {cue.name}</p>
        <p class="vs-transfer">Two modalities, aligned in time</p>
        <h3 class="vs-name"><a href="/vibeset/cue">{cue.tagline}</a></h3>
        <p class="vs-desc">{cue.description}</p>
        <p class="vs-stats label-mono">
          {cue.stats.map((s, i) => <span>{i > 0 && <span class="vs-stat-dot"> · </span>}{s.label} {s.value}</span>)}
        </p>
        <p class="vs-ctas">
          <a class="btn-pill" href={cue.liveUrl} rel="noopener">{cue.liveLabel} ↳</a>
        </p>
      </div>
      <div class="vs-demo">
        <p class="vs-demo-label label-mono">
          <span class="sig-eq" aria-hidden="true"><span></span><span></span><span></span></span>
          live
        </p>
        <CueSync data={cueSync} client:visible />
      </div>
    </article>

    <!-- ── PROVE · Choon ───────────────────────────────────────────────── -->
    <article class="vs-station" data-reveal="settle">
      <div class="vs-copy">
        <p class="vs-eyebrow label-mono"><span class="vs-eyebrow-stage">{choon.eyebrow}</span> · {choon.name}</p>
        <p class="vs-transfer">Representation learning, small enough to run</p>
        <h3 class="vs-name"><a href="/vibeset/choon">{choon.tagline}</a></h3>
        <p class="vs-desc">{choon.description}</p>
        <p class="vs-stats label-mono">
          {choon.stats.map((s, i) => <span>{i > 0 && <span class="vs-stat-dot"> · </span>}{s.label} {s.value}</span>)}
        </p>
        <p class="vs-ctas">
          <a class="btn-pill" href={choon.liveUrl} rel="noopener">{choon.liveLabel} ↳</a>
        </p>
      </div>
      <div class="vs-demo">
        <!-- Real eval numbers only. Both figures are published with their full
             protocol at /notes/choon; the weak row is the whole point of
             showing this rather than a staged identification. The workbench
             itself lives on /vibeset/choon — the landing page is an index
             (docs/design/DESIGN.md §2). -->
        <figure class="vs-frozen">
          <figcaption class="vs-frozen-head label-mono">
            <span class="vs-frozen-badge">eval</span>
            <span class="vs-frozen-input">66,000-track proxy catalog</span>
          </figcaption>

          <div class="vs-frozen-body">
            <dl class="vs-frozen-stats">
              <div>
                <dt class="label-mono">core conditions</dt>
                <dd>93.8%</dd>
              </div>
              <div>
                <dt class="label-mono">recall@1, all attacks</dt>
                <dd>76.9%</dd>
              </div>
              <div class="vs-frozen-weak">
                <dt class="label-mono">high-pass filter</dt>
                <dd>15.3%</dd>
              </div>
            </dl>
            <p class="vs-frozen-note">Every matcher has a condition it fails. This one is ours.</p>
          </div>
        </figure>

        <p class="vs-frozen-cta">
          <a class="vs-cta-quiet" href="/notes/choon">How this was measured ↳</a>
        </p>
      </div>
    </article>

    <!-- ── Outside music ────────────────────────────────────────────────
         Same spine, no demo panel: these have public source rather than a
         running instrument, and pretending otherwise would need a fourth badge
         word (DESIGN.md §4 allows exactly three). They are stations, not a
         footnote, because voice and behaviour-shaped data are two of the things
         the top of this page claims. -->
    <article class="vs-station vs-station--quiet" data-reveal="settle">
      <div class="vs-copy">
        <p class="vs-eyebrow label-mono"><span class="vs-eyebrow-stage">VOICE</span> · Golo</p>
        <p class="vs-transfer">Speech into a structured profile</p>
        <h3 class="vs-name">
          <a href="https://github.com/bishalu/veer" target="_blank" rel="noopener noreferrer">
            Two minutes of talking, read as a personality profile ↳
          </a>
        </h3>
        <p class="vs-desc">
          Listens to someone speak and returns a structured psychological reading — Big Five, public and
          private personas — with schema-enforced outputs across more than one model provider. The
          interesting problem is making a model commit to a shape when the input is a human being talking.
        </p>
      </div>
    </article>

    <article class="vs-station vs-station--quiet" data-reveal="settle">
      <div class="vs-copy">
        <p class="vs-eyebrow label-mono"><span class="vs-eyebrow-stage">GUARDRAILS</span> · KTM Capital</p>
        <p class="vs-transfer">Language models inside hard limits</p>
        <h3 class="vs-name">
          <a href="https://github.com/bishalu/ktm_capital" target="_blank" rel="noopener noreferrer">
            News sentiment, traded against stop-losses that do not negotiate ↳
          </a>
        </h3>
        <p class="vs-desc">
          Paper trading on news sentiment, inside hard stop-loss and position caps the model cannot argue
          its way past. The guardrails are the point, not the alpha — this is the shape any consequential
          agent needs before it is allowed near anything real.
        </p>
      </div>
    </article>

    <!-- ── The pipeline underneath the music three ─────────────────────── -->
    <aside class="vs-pipe" data-reveal>
      <p class="label-mono vs-pipe-title">Underneath the three above</p>
      <!-- tabindex: the strip scrolls horizontally on narrow viewports, so it
           needs to be reachable and scrollable by keyboard. -->
      <ol class="vs-pipe-flow" aria-label="The pipeline underneath" tabindex="0">
        <li><span class="vs-pipe-node">setlist scrapers</span></li>
        <li><span class="vs-pipe-node">ETL + LLM enrichment</span></li>
        <li><span class="vs-pipe-node vs-pipe-node-em">licensed pgvector catalog</span></li>
        <li><span class="vs-pipe-node">LLM ensemble</span></li>
        <li><span class="vs-pipe-node">three products</span></li>
      </ol>
    </aside>
  </div>
</section>

<style lang="scss">
  .vs {
    background: transparent;
    padding: var(--space-3xl) 0;
  }

  .vs-inner {
    margin: 0 auto;
    padding: 0 var(--space-l);
    max-width: 1200px;
  }

  .vs-head {
    margin-bottom: var(--space-2xl);
    max-width: 720px;
  }

  /* An eyebrow says where you are. It is not data, so it is not mono — that
     voice is reserved for numbers and status (docs/design/DESIGN.md §3), and
     spending it on every section header is what made the page read as an
     instrument panel rather than a page. */
  .vs-head-eyebrow {
    margin: 0 0 var(--space-xs);
    color: var(--paper-soft);
    font-size: 0.95rem;
  }

  /* Retired anchor, kept addressable. Offset so a jump clears the fixed header. */
  .vs-anchor {
    display: block;
    position: relative;
    top: -80px;
  }

  /* What this station demonstrates that has nothing to do with music. It sits
     above the product name deliberately: the transferable claim is what a
     stranger is scanning for, and the product is the evidence for it. */
  .vs-transfer {
    margin: 0 0 var(--space-2xs);
    color: var(--paper);
    font-weight: 600;
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
    line-height: 1.35;
    letter-spacing: -0.01em;
  }

  .vs-title {
    margin: var(--space-xs) 0 var(--space-s);
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    letter-spacing: -0.015em;
    line-height: 1.02;
  }

  .vs-lede {
    margin: 0;
    color: var(--ink-soft);
    font-size: 1.05rem;
    line-height: 1.65;
  }

  /* ── Stations ───────────────────────────────────────────────────────── */
  /* Grid children default to min-width:auto, so a long mono stat run refuses
     to shrink and pushes the page sideways at 320px. */
  .vs-station > * {
    min-width: 0;
  }

  .vs-stats {
    overflow-wrap: anywhere;
  }

  .vs-station {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    border-top: 1px solid var(--hairline-on-paper);
    padding: var(--space-2xl) 0;
  }

  /* No demo panel, so no empty right-hand column — the copy takes the measure
     it would have had anyway rather than stretching across the full grid. */
  .vs-station--quiet {
    grid-template-columns: minmax(0, 1fr);
    padding: var(--space-xl) 0;

    .vs-copy {
      max-width: 62ch;
    }

    .vs-name {
      font-size: clamp(1rem, 1.6vw, 1.15rem);
    }
  }

  .vs-eyebrow {
    margin: 0 0 var(--space-s);
  }

  .vs-eyebrow-stage {
    color: var(--crimson-text);
    font-weight: 500;
  }

  .vs-name a {
    color: inherit;
    text-decoration: none;

    &:hover {
      color: var(--crimson-text);
    }
  }

  .vs-name {
    margin: 0 0 var(--space-s);
    font-size: clamp(1.4rem, 2.4vw, 1.9rem);
    letter-spacing: -0.01em;
    line-height: 1.15;
  }

  .vs-desc {
    margin: 0 0 var(--space-m);
    color: var(--ink-soft);
    font-size: 0.98rem;
    line-height: 1.7;
  }

  .vs-stats {
    margin: 0 0 var(--space-m);
    color: var(--ink-soft);
  }

  .vs-stat-dot {
    color: var(--marigold-text);
  }

  .vs-ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-s);
    margin: 0;
  }


  .vs-cta-quiet {
    color: var(--crimson-text);
    font-size: 0.9rem;

    &:hover {
      color: var(--crimson-text);
    }
  }

  .vs-demo-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 var(--space-s);
  }

  /* ── Cue screenshots ────────────────────────────────────────────────── */
  .vs-shots {
    display: block;
    position: relative;
    transition: transform 0.22s var(--ease-out);
    padding-bottom: 14%;

    img {
      display: block;
      box-shadow: 0 24px 56px rgba(0, 0, 0, 0.5);
      border: 1px solid var(--hairline-on-paper);
      border-radius: 12px;
      width: 82%;
      height: auto;
    }

    .vs-shot-back {
      position: absolute;
      right: 0;
      bottom: 0;
      z-index: -1;
      width: 62%;
      opacity: 0.92;
    }

    &:hover {
      transform: translateY(-2px);
    }
  }

  /* ── Pipeline strip ─────────────────────────────────────────────────── */
  .vs-pipe {
    border-top: 1px solid var(--hairline-on-paper);
    padding-top: var(--space-l);
  }

  .vs-pipe-title {
    margin: 0 0 var(--space-s);
  }

  .vs-pipe-flow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0;
    padding: 0.25rem 0;
    overflow-x: auto;
    list-style: none;

    li {
      display: flex;
      flex-shrink: 0;
      align-items: center;
      gap: 0.75rem;

      &:not(:last-child)::after {
        display: block;
        border-radius: 999px;
        background: var(--grad-signal);
        width: clamp(1.25rem, 3vw, 3rem);
        height: 2px;
        content: '';
      }
    }
  }

  .vs-pipe-node {
    border: 1px solid var(--hairline-on-paper);
    border-radius: 999px;
    padding: 0.35rem 0.9rem;
    color: var(--ink-soft);
    font-size: 0.72rem;
    letter-spacing: var(--tracking-label);
    font-family: var(--font-mono);
    text-transform: uppercase;
    white-space: nowrap;
  }

  .vs-pipe-node-em {
    border-color: var(--marigold);
    color: var(--paper);
  }

  /* ── Responsive ─────────────────────────────────────────────────────── */
  @media (max-width: 1023px) {
    .vs-station {
      grid-template-columns: 1fr;
      gap: var(--space-l);
    }
  }

  @media (max-width: 479px) {
    .vs-inner {
      padding: 0 var(--space-m);
    }
  }

  /* ── Frozen Choon result ────────────────────────────────────────────────
     A real run from the eval harness, shown still. Badged `replay` because
     that is what it is — recorded output, not an invented one. */
  .vs-frozen {
    margin: 0;
    border: 1px solid var(--hairline-on-ink);
    border-radius: var(--radius-large);
    background: var(--card-background);
    overflow: hidden;
  }

  .vs-frozen-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--border-color-subtle);
    padding: 0.6rem 0.9rem;
  }

  .vs-frozen-badge {
    border-radius: var(--radius-pill);
    background: rgba(76, 168, 162, 0.16);
    padding: 0.12rem 0.5rem;
    color: var(--glacier-text);
  }

  .vs-frozen-input {
    color: var(--paper-soft);
  }

  .vs-frozen-body {
    padding: var(--space-s) 0.9rem 0.9rem;
  }

  .vs-frozen-verdict {
    margin: 0;
    color: var(--glacier-text);
    font-weight: 500;
    font-size: 0.7rem;
    letter-spacing: var(--tracking-label);
    font-family: var(--font-mono);
    text-transform: uppercase;
  }

  .vs-frozen-track {
    margin: 0.2rem 0 var(--space-s);
    color: var(--paper);
    font-weight: 600;
    font-size: 1.15rem;
    font-family: var(--font-display);
    letter-spacing: -0.01em;
  }

  /* 1px gap on a hairline ground — the gap is the rule, so there are no
     borders to keep in sync. */
  .vs-frozen-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(90px, 1fr));
    gap: 1px;
    margin: 0 0 var(--space-s);
    border: 1px solid var(--hairline-on-ink);
    border-radius: var(--radius-small);
    background: var(--hairline-on-ink);
    overflow: hidden;

    > div {
      background: var(--ink);
      padding: 0.5rem 0.6rem;
    }

    dt {
      margin: 0;
      color: var(--paper-soft);
      font-size: 0.6rem;
      letter-spacing: 0.1em;
    }

    dd {
      margin: 0.15rem 0 0;
      color: var(--paper);
      font-weight: 600;
      font-size: 1.05rem;
      font-family: var(--font-display);
      font-variant-numeric: tabular-nums;
      letter-spacing: -0.02em;
    }
  }

  /* The failing condition. Marked in marigold rather than hidden — publishing
     it is the credibility, not a caveat (docs/design/DESIGN.md P9). */
  .vs-frozen-weak dd {
    color: var(--marigold-text);
  }

  .vs-frozen-note {
    margin: 0;
    color: var(--paper-soft);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .vs-frozen-cta {
    margin: var(--space-s) 0 0;
  }
</style>
