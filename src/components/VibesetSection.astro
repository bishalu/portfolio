---
/**
 * Vibeset — the lifecycle triptych (docs/design/DESIGN.md §5–6).
 * Three stations on the signal: FIND (Curation, live search demo),
 * FIT (Cue, the shipped app), PROVE (Choon, in-browser stress test).
 * Eyebrows encode the real music lifecycle — not decoration.
 */
import { getCollection } from 'astro:content'
import VibeFinder from '@components/VibeFinder.tsx'
import CueSync from '@components/CueSync.tsx'
// Imported at build time, not fetched: the widget's claim is that it does no
// network work, and that should be literally true.
import cueSync from '../data/cue-sync.json'

const products = (await getCollection('products')).sort((a, b) => a.data.order - b.data.order)
const bySlug = Object.fromEntries(products.map((p) => [p.id.replace(/\.mdx$/, ''), p.data]))
const curation = bySlug['curation']
const cue = bySlug['cue']
const choon = bySlug['choon']
---

<section class="vs" id="vibeset">
  <div class="vs-inner">
    <header class="vs-head" data-reveal>
      <p class="label-mono">Vibeset</p>
      <h2 class="vs-title">Three systems, in production.</h2>
      <p class="vs-lede">
        I cofounded <a href="https://vibeset.ai" rel="noopener">Vibeset</a>. Retrieval over a licensed
        catalogue, music matched to picture, audio identified after the internet has mangled it. The
        music is incidental — these are the same problems as voice, video and search anywhere else.
      </p>
    </header>

    <!-- ── FIND · Curation ─────────────────────────────────────────────── -->
    <article class="vs-station" data-reveal="settle">
      <div class="vs-copy">
        <p class="vs-eyebrow label-mono"><span class="vs-eyebrow-stage">{curation.eyebrow}</span> · {curation.name}</p>
        <h3 class="vs-name"><a href="/vibeset/curation">{curation.tagline}</a></h3>
        <p class="vs-desc">{curation.description}</p>
        <p class="vs-stats label-mono">
          {curation.stats.map((s, i) => <span>{i > 0 && <span class="vs-stat-dot"> · </span>}{s.label} {s.value}</span>)}
        </p>
        <p class="vs-ctas">
          <a class="btn-pill" href={curation.liveUrl} rel="noopener">{curation.liveLabel} ↳</a>
        </p>
      </div>
      <div class="vs-demo">
        <p class="vs-demo-label label-mono">
          <!-- Bars rather than a dot: what is running here is an audio catalog,
               not a service healthcheck. A swap, not an addition — see MOTION.md §2. -->
          <span class="sig-eq" aria-hidden="true"><span></span><span></span><span></span></span>
          live
        </p>
        <VibeFinder client:visible />
      </div>
    </article>

    <!-- ── FIT · Cue ───────────────────────────────────────────────────── -->
    <article class="vs-station" data-reveal="settle">
      <div class="vs-copy">
        <p class="vs-eyebrow label-mono"><span class="vs-eyebrow-stage">{cue.eyebrow}</span> · {cue.name}</p>
        <h3 class="vs-name"><a href="/vibeset/cue">{cue.tagline}</a></h3>
        <p class="vs-desc">{cue.description}</p>
        <p class="vs-stats label-mono">
          {cue.stats.map((s, i) => <span>{i > 0 && <span class="vs-stat-dot"> · </span>}{s.label} {s.value}</span>)}
        </p>
        <p class="vs-ctas">
          <a class="btn-pill" href={cue.liveUrl} rel="noopener">{cue.liveLabel} ↳</a>
        </p>
      </div>
      <div class="vs-demo">
        <p class="vs-demo-label label-mono">
          <span class="sig-eq" aria-hidden="true"><span></span><span></span><span></span></span>
          live
        </p>
        <CueSync data={cueSync} client:visible />
      </div>
    </article>

    <!-- ── PROVE · Choon ───────────────────────────────────────────────── -->
    <article class="vs-station" data-reveal="settle">
      <div class="vs-copy">
        <p class="vs-eyebrow label-mono"><span class="vs-eyebrow-stage">{choon.eyebrow}</span> · {choon.name}</p>
        <h3 class="vs-name"><a href="/vibeset/choon">{choon.tagline}</a></h3>
        <p class="vs-desc">{choon.description}</p>
        <p class="vs-stats label-mono">
          {choon.stats.map((s, i) => <span>{i > 0 && <span class="vs-stat-dot"> · </span>}{s.label} {s.value}</span>)}
        </p>
        <p class="vs-ctas">
          <a class="btn-pill" href={choon.liveUrl} rel="noopener">{choon.liveLabel} ↳</a>
        </p>
      </div>
      <div class="vs-demo">
        <!-- Real eval numbers only. Both figures are published with their full
             protocol at /notes/choon; the weak row is the whole point of
             showing this rather than a staged identification. The workbench
             itself lives on /vibeset/choon — the landing page is an index
             (docs/design/DESIGN.md §2). -->
        <figure class="vs-frozen">
          <figcaption class="vs-frozen-head label-mono">
            <span class="vs-frozen-badge">eval</span>
            <span class="vs-frozen-input">66,000-track proxy catalog</span>
          </figcaption>

          <div class="vs-frozen-body">
            <dl class="vs-frozen-stats">
              <div>
                <dt class="label-mono">core conditions</dt>
                <dd>93.8%</dd>
              </div>
              <div>
                <dt class="label-mono">recall@1, all attacks</dt>
                <dd>76.9%</dd>
              </div>
              <div class="vs-frozen-weak">
                <dt class="label-mono">high-pass filter</dt>
                <dd>15.3%</dd>
              </div>
            </dl>
            <p class="vs-frozen-note">Every matcher has a condition it fails. This one is ours.</p>
          </div>
        </figure>

        <p class="vs-frozen-cta">
          <a class="vs-cta-quiet" href="/notes/choon">How this was measured ↳</a>
        </p>
      </div>
    </article>

    <!-- ── The substrate all three draw on ─────────────────────────────
         A matrix, not a flow. Two earlier versions of this were wrong in the
         same way: they drew a chain, and a chain says every product comes out
         of the same end. It doesn't. Choon is mostly the model; Curation is
         mostly retrieval; Cue is mostly representation and timing.

         An adjacency matrix is the honest shape for that — every layer against
         every product, weights on the cells. It is also the shape a CTO can
         read in one pass, which a bipartite graph with fifteen crossing edges
         is not.

         Layer names are deliberately domain-free. The same six rows describe a
         claims platform or a clinical retrieval system; music is where they
         happen to run today, and naming them after music would have made the
         practice look narrower than it is. -->
    <aside class="vs-sub" data-reveal>
      <p class="label-mono vs-sub-title">Underneath</p>

      <div class="vs-sub-scroll" role="region" aria-label="Capabilities each product draws on" tabindex="0">
        <table class="vs-sub-table">
          <caption class="sr-only">
            Six shared capabilities against the three products. A filled mark means the product leans on that
            capability; an outlined mark means it uses it.
          </caption>
          <thead>
            <tr>
              <th scope="col"><span class="sr-only">Capability</span></th>
              <th scope="col">Curation</th>
              <th scope="col">Cue</th>
              <th scope="col">Choon</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">
                Ingest and provenance
                <span class="vs-sub-gloss">connectors, crawlers, rights tracked at the source</span>
              </th>
              <td><span class="vs-mark vs-mark-lean"><span class="sr-only">leans on</span></span></td>
              <td><span class="vs-mark vs-mark-uses"><span class="sr-only">uses</span></span></td>
              <td><span class="vs-mark vs-mark-uses"><span class="sr-only">uses</span></span></td>
            </tr>
            <tr>
              <th scope="row">
                Enrich
                <span class="vs-sub-gloss">ETL, LLM labelling, human review in the loop</span>
              </th>
              <td><span class="vs-mark vs-mark-lean"><span class="sr-only">leans on</span></span></td>
              <td><span class="vs-mark vs-mark-uses"><span class="sr-only">uses</span></span></td>
              <td><span class="vs-mark vs-mark-uses"><span class="sr-only">uses</span></span></td>
            </tr>
            <tr>
              <th scope="row">
                Represent
                <span class="vs-sub-gloss">embeddings, fingerprints, learned features</span>
              </th>
              <td><span class="vs-mark vs-mark-lean"><span class="sr-only">leans on</span></span></td>
              <td><span class="vs-mark vs-mark-lean"><span class="sr-only">leans on</span></span></td>
              <td><span class="vs-mark vs-mark-lean"><span class="sr-only">leans on</span></span></td>
            </tr>
            <tr>
              <th scope="row">
                Train and compress
                <span class="vs-sub-gloss">fine-tuning, pruning, quantisation, latency budgets</span>
              </th>
              <td><span class="vs-mark vs-mark-uses"><span class="sr-only">uses</span></span></td>
              <td><span class="vs-mark vs-mark-uses"><span class="sr-only">uses</span></span></td>
              <td><span class="vs-mark vs-mark-lean"><span class="sr-only">leans on</span></span></td>
            </tr>
            <tr>
              <th scope="row">
                Retrieve
                <span class="vs-sub-gloss">exact, keyword, vector, diversity, rerank</span>
              </th>
              <td><span class="vs-mark vs-mark-lean"><span class="sr-only">leans on</span></span></td>
              <td><span class="vs-mark vs-mark-uses"><span class="sr-only">uses</span></span></td>
              <td><span class="vs-mark vs-mark-uses"><span class="sr-only">uses</span></span></td>
            </tr>
            <tr>
              <th scope="row">
                Serve and prove
                <span class="vs-sub-gloss">inference under a deadline, eval harnesses, cost governance</span>
              </th>
              <td><span class="vs-mark vs-mark-lean"><span class="sr-only">leans on</span></span></td>
              <td><span class="vs-mark vs-mark-lean"><span class="sr-only">leans on</span></span></td>
              <td><span class="vs-mark vs-mark-lean"><span class="sr-only">leans on</span></span></td>
            </tr>
          </tbody>
        </table>
      </div>

      <p class="vs-sub-note">
        <span class="vs-mark vs-mark-lean vs-mark-inline" aria-hidden="true"></span> leans on it ·
        <span class="vs-mark vs-mark-uses vs-mark-inline" aria-hidden="true"></span> uses it.<br />
        Same six layers, different weights. None of it is specific to music.
      </p>
    </aside>
  </div>
</section>

<style lang="scss">
  .vs {
    background: transparent;
    padding: var(--space-3xl) 0;
  }

  .vs-inner {
    margin: 0 auto;
    padding: 0 var(--space-l);
    max-width: 1200px;
  }

  .vs-head {
    margin-bottom: var(--space-2xl);
    max-width: 720px;
  }

  .vs-title {
    margin: var(--space-xs) 0 var(--space-s);
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    letter-spacing: -0.015em;
    line-height: 1.02;
  }

  .vs-lede {
    margin: 0;
    color: var(--ink-soft);
    font-size: 1.05rem;
    line-height: 1.65;
  }

  /* ── Stations ───────────────────────────────────────────────────────── */
  /* Grid children default to min-width:auto, so a long mono stat run refuses
     to shrink and pushes the page sideways at 320px. */
  .vs-station > * {
    min-width: 0;
  }

  .vs-stats {
    overflow-wrap: anywhere;
  }

  .vs-station {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    border-top: 1px solid var(--hairline-on-paper);
    padding: var(--space-2xl) 0;
  }

  .vs-eyebrow {
    margin: 0 0 var(--space-s);
  }

  .vs-eyebrow-stage {
    color: var(--crimson-text);
    font-weight: 500;
  }

  .vs-name a {
    color: inherit;
    text-decoration: none;

    &:hover {
      color: var(--crimson-text);
    }
  }

  .vs-name {
    margin: 0 0 var(--space-s);
    font-size: clamp(1.4rem, 2.4vw, 1.9rem);
    letter-spacing: -0.01em;
    line-height: 1.15;
  }

  .vs-desc {
    margin: 0 0 var(--space-m);
    color: var(--ink-soft);
    font-size: 0.98rem;
    line-height: 1.7;
  }

  .vs-stats {
    margin: 0 0 var(--space-m);
    color: var(--ink-soft);
  }

  .vs-stat-dot {
    color: var(--marigold);
  }

  .vs-ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-s);
    margin: 0;
  }


  .vs-cta-quiet {
    color: var(--crimson-text);
    font-size: 0.9rem;

    &:hover {
      color: var(--crimson);
    }
  }

  .vs-demo-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 var(--space-s);
  }

  /* ── Cue screenshots ────────────────────────────────────────────────── */
  .vs-shots {
    display: block;
    position: relative;
    transition: transform 0.22s var(--ease-out);
    padding-bottom: 14%;

    img {
      display: block;
      box-shadow: 0 24px 56px rgba(0, 0, 0, 0.5);
      border: 1px solid var(--hairline-on-paper);
      border-radius: 12px;
      width: 82%;
      height: auto;
    }

    .vs-shot-back {
      position: absolute;
      right: 0;
      bottom: 0;
      z-index: -1;
      width: 62%;
      opacity: 0.92;
    }

    &:hover {
      transform: translateY(-2px);
    }
  }

  /* ── Substrate matrix ───────────────────────────────────────────────── */
  .vs-sub {
    border-top: 1px solid var(--hairline-on-paper);
    padding-top: var(--space-l);
  }

  .vs-sub-title {
    margin: 0 0 var(--space-m);
  }

  /* Four columns will fit 320px, but only just; the wrapper is focusable so a
     keyboard user can reach the scroll if a long gloss forces one. */
  .vs-sub-scroll {
    overflow-x: auto;

    &:focus-visible {
      outline: 2px solid var(--crimson);
      outline-offset: 4px;
    }
  }

  /* The 1px gap on a hairline ground is the rule — the same trick as the
     frozen-result stats below, so there are no borders to keep in sync and no
     double lines where cells meet. */
  /* Capped and fixed. Left to itself the browser split 1128px four ways and
     gave each product a 280px column to hold a 10px dot — a spreadsheet with
     nothing in it. A fixed layout at 46rem makes it a dense object you read in
     one glance, which is the entire point of showing a matrix. */
  .vs-sub-table {
    border-spacing: 1px;
    background: var(--hairline-on-ink);
    width: 100%;
    min-width: 19rem;
    max-width: 46rem;
    border-collapse: separate;
    table-layout: fixed;
    text-align: left;

    /* Proportional, not fixed: 6.5rem columns held their width down to 390px
       and left 46px for the labels, which wrapped one word per line. A share
       of the table scales at both ends without a breakpoint. */
    thead th:not(:first-child) {
      width: 14%;
    }

    th,
    td {
      background: var(--void);
    }

    thead th {
      padding: 0.5rem 0.7rem;
      color: var(--paper-soft);
      font-weight: 500;
      font-size: 0.65rem;
      letter-spacing: 0.1em;
      font-family: var(--font-mono);
      text-transform: uppercase;
      text-align: center;
      white-space: nowrap;
    }

    tbody th {
      padding: 0.6rem 0.7rem;
      width: 99%;
      color: var(--paper);
      font-weight: 500;
      font-size: 0.88rem;
      line-height: 1.35;
    }

    td {
      padding: 0.6rem 0.7rem;
      text-align: center;
    }
  }

  .vs-sub-gloss {
    display: block;
    margin-top: 0.12rem;
    color: var(--paper-soft);
    font-weight: 400;
    font-size: 0.74rem;
    line-height: 1.4;
  }

  /* Weight, drawn twice over: filled versus outlined, and the signal gradient
     versus a neutral hairline. Two channels because one of them is colour, and
     colour alone is not a way to encode a value (WCAG 1.4.1). */
  .vs-mark {
    display: inline-block;
    border-radius: 50%;
    width: 10px;
    height: 10px;
  }

  .vs-mark-lean {
    background: var(--grad-signal);
  }

  .vs-mark-uses {
    box-shadow: inset 0 0 0 1.5px var(--paper-soft);
    opacity: 0.65;
  }

  .vs-mark-inline {
    transform: translateY(1px);
    margin: 0 0.15rem 0 0.6rem;

    &:first-child {
      margin-left: 0;
    }
  }

  .vs-sub-note {
    margin: 0.75rem 0 0;
    color: var(--paper-soft);
    font-size: 0.85rem;
    line-height: 1.6;
  }

  @media (max-width: 560px) {
    .vs-sub-table {
      tbody th {
        font-size: 0.82rem;
      }

      /* "CURATION" is eight characters in a column worth 47px at 390px, and
         nowrap let it run straight into "CUE". Tighter tracking, smaller type,
         a slightly wider share — and wrapping allowed as the backstop, so the
         worst case is a broken word rather than two words on top of each
         other. */
      thead th {
        letter-spacing: 0.02em;
        font-size: 0.52rem;
        white-space: normal;
      }

      thead th:not(:first-child) {
        width: 17%;
      }

      thead th,
      td {
        padding: 0.55rem 0.3rem;
      }
    }

    .vs-sub-gloss {
      font-size: 0.7rem;
    }
  }

  /* ── Responsive ─────────────────────────────────────────────────────── */
  @media (max-width: 1023px) {
    .vs-station {
      grid-template-columns: 1fr;
      gap: var(--space-l);
    }
  }

  @media (max-width: 479px) {
    .vs-inner {
      padding: 0 var(--space-m);
    }
  }

  /* ── Frozen Choon result ────────────────────────────────────────────────
     A real run from the eval harness, shown still. Badged `replay` because
     that is what it is — recorded output, not an invented one. */
  .vs-frozen {
    margin: 0;
    border: 1px solid var(--hairline-on-ink);
    border-radius: var(--radius-large);
    background: var(--card-background);
    overflow: hidden;
  }

  .vs-frozen-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--border-color-subtle);
    padding: 0.6rem 0.9rem;
  }

  .vs-frozen-badge {
    border-radius: var(--radius-pill);
    background: rgba(76, 168, 162, 0.16);
    padding: 0.12rem 0.5rem;
    color: var(--glacier-text);
  }

  .vs-frozen-input {
    color: var(--paper-soft);
    opacity: 0.8;
  }

  .vs-frozen-body {
    padding: var(--space-s) 0.9rem 0.9rem;
  }

  .vs-frozen-verdict {
    margin: 0;
    color: var(--glacier-text);
    font-weight: 500;
    font-size: 0.7rem;
    letter-spacing: var(--tracking-label);
    font-family: var(--font-mono);
    text-transform: uppercase;
  }

  .vs-frozen-track {
    margin: 0.2rem 0 var(--space-s);
    color: var(--paper);
    font-weight: 600;
    font-size: 1.15rem;
    font-family: var(--font-display);
    letter-spacing: -0.01em;
  }

  /* 1px gap on a hairline ground — the gap is the rule, so there are no
     borders to keep in sync. */
  .vs-frozen-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(90px, 1fr));
    gap: 1px;
    margin: 0 0 var(--space-s);
    border: 1px solid var(--hairline-on-ink);
    border-radius: var(--radius-small);
    background: var(--hairline-on-ink);
    overflow: hidden;

    > div {
      background: var(--ink);
      padding: 0.5rem 0.6rem;
    }

    dt {
      margin: 0;
      color: var(--paper-soft);
      font-size: 0.6rem;
      letter-spacing: 0.1em;
    }

    dd {
      margin: 0.15rem 0 0;
      color: var(--paper);
      font-weight: 600;
      font-size: 1.05rem;
      font-family: var(--font-display);
      font-variant-numeric: tabular-nums;
      letter-spacing: -0.02em;
    }
  }

  /* The failing condition. Marked in marigold rather than hidden — publishing
     it is the credibility, not a caveat (docs/design/DESIGN.md P9). */
  .vs-frozen-weak dd {
    color: var(--marigold);
  }

  .vs-frozen-note {
    margin: 0;
    color: var(--paper-soft);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .vs-frozen-cta {
    margin: var(--space-s) 0 0;
  }
</style>
