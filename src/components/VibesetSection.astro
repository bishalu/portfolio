---
/**
 * Vibeset — the lifecycle triptych (docs/design/DESIGN.md §5–6).
 * Three stations on the signal: FIND (Curation, live search demo),
 * FIT (Cue, the shipped app), PROVE (Choon, in-browser stress test).
 * Eyebrows encode the real music lifecycle — not decoration.
 */
import { getCollection } from 'astro:content'
import Substrate from '@components/Substrate.astro'
import { BENCH_HOME } from '@/data/choon-benchmark'
import VibeFinder from '@components/VibeFinder.tsx'
import CueSync from '@components/CueSync.tsx'
// Imported at build time, not fetched: the widget's claim is that it does no
// network work, and that should be literally true.
import cueSync from '../data/cue-sync.json'

const products = (await getCollection('products')).sort((a, b) => a.data.order - b.data.order)
const bySlug = Object.fromEntries(products.map((p) => [p.id.replace(/\.mdx$/, ''), p.data]))
const curation = bySlug['curation']
const cue = bySlug['cue']
const choon = bySlug['choon']
---

<section class="vs" id="vibeset">
  <div class="vs-inner">
    <header class="vs-head" data-reveal>
      <p class="label-mono">Vibeset</p>
      <h2 class="vs-title">Three systems, in production.</h2>
      <p class="vs-lede">
        I cofounded <a href="https://vibeset.ai" rel="noopener">Vibeset Technologies</a>. One product finds
        the right track from a rough description, one watches a video and picks music that fits, one knows a
        recording again after the internet has mangled it. Point the same three at support calls or security
        footage and nothing about the engineering changes.
      </p>
    </header>

    <!-- ── FIND · Curation ─────────────────────────────────────────────── -->
    <article class="vs-station" data-reveal="settle">
      <div class="vs-copy">
        <p class="vs-eyebrow label-mono"><span class="vs-eyebrow-stage">{curation.eyebrow}</span> · {curation.name}</p>
        <h3 class="vs-name"><a href="/vibeset/curation">{curation.tagline}</a></h3>
        <p class="vs-desc">{curation.description}</p>
        <p class="vs-stats label-mono">
          {curation.stats.map((s, i) => <span>{i > 0 && <span class="vs-stat-dot"> · </span>}{s.label} {s.value}</span>)}
        </p>
        <p class="vs-ctas">
          <a class="btn-pill" href={curation.liveUrl} rel="noopener">{curation.liveLabel} ↳</a>
        </p>
      </div>
      <div class="vs-demo">
        <p class="vs-demo-label label-mono">
          <!-- Bars rather than a dot: what is running here is an audio catalog,
               not a service healthcheck. A swap, not an addition — see MOTION.md §2. -->
          <span class="sig-eq" aria-hidden="true"><span></span><span></span><span></span></span>
          live
        </p>
        <VibeFinder client:visible />
      </div>
    </article>

    <!-- ── FIT · Cue ───────────────────────────────────────────────────── -->
    <article class="vs-station" data-reveal="settle">
      <div class="vs-copy">
        <p class="vs-eyebrow label-mono"><span class="vs-eyebrow-stage">{cue.eyebrow}</span> · {cue.name}</p>
        <h3 class="vs-name"><a href="/vibeset/cue">{cue.tagline}</a></h3>
        <p class="vs-desc">{cue.description}</p>
        <p class="vs-stats label-mono">
          {cue.stats.map((s, i) => <span>{i > 0 && <span class="vs-stat-dot"> · </span>}{s.label} {s.value}</span>)}
        </p>
        <p class="vs-ctas">
          <a class="btn-pill" href={cue.liveUrl} rel="noopener">{cue.liveLabel} ↳</a>
        </p>
      </div>
      <div class="vs-demo">
        <p class="vs-demo-label label-mono">
          <span class="sig-eq" aria-hidden="true"><span></span><span></span><span></span></span>
          live
        </p>
        <CueSync data={cueSync} client:visible />
      </div>
    </article>

    <!-- ── PROVE · Choon ───────────────────────────────────────────────── -->
    <article class="vs-station" data-reveal="settle">
      <div class="vs-copy">
        <p class="vs-eyebrow label-mono"><span class="vs-eyebrow-stage">{choon.eyebrow}</span> · {choon.name}</p>
        <h3 class="vs-name"><a href="/vibeset/choon">{choon.tagline}</a></h3>
        <p class="vs-desc">{choon.description}</p>
        <p class="vs-stats label-mono">
          {choon.stats.map((s, i) => <span>{i > 0 && <span class="vs-stat-dot"> · </span>}{s.label} {s.value}</span>)}
        </p>
        <p class="vs-ctas">
          <a class="btn-pill" href={choon.liveUrl} rel="noopener">{choon.liveLabel} ↳</a>
        </p>
      </div>
      <div class="vs-demo">
        <!-- Real eval numbers only. Both figures are published with their full
             protocol at /notes/choon; the weak row is the whole point of
             showing this rather than a staged identification. The workbench
             itself lives on /vibeset/choon — the landing page is an index
             (docs/design/DESIGN.md §2). -->
        <!-- The comparison, not the confession.
             This panel used to publish three internal numbers and the line
             "every matcher has a condition it fails. This one is ours." That
             candour is the site's whole posture and it stays — at /notes/choon,
             where the methodology sits beside it. What belongs here is the
             question a buyer actually asks: is this competitive. A published
             benchmark with someone else's conditions answers it better than a
             self-reported number can.

             Four rows, not nine. Three stat tiles could not show a comparison
             at all, and the full nine-row table does not fit a station on the
             landing page. Each row here answers a different question; the rest
             are one link away. -->
        <figure class="vs-bench">
          <figcaption class="vs-bench-head label-mono">
            <span class="vs-frozen-badge">benchmark</span>
            <span class="vs-frozen-input">Recall@1 · arXiv:2511.05399 · 5,000 refs</span>
          </figcaption>

          <table class="vs-bench-table">
            <caption class="sr-only">
              Recall@1 and parameter count for Choon's neural channel against three published models.
            </caption>
            <thead>
              <tr>
                <th scope="col">Model</th>
                <th scope="col">Size</th>
                <th scope="col">Recall@1</th>
                <th scope="col">Re-encoded</th>
              </tr>
            </thead>
            <tbody>
              {
                BENCH_HOME.map((r) => (
                  <tr class:list={[r.ours && 'vs-bench-ours']}>
                    <th scope="row">{r.ours ? 'Choon' : r.model.replace(', unfrozen', '')}</th>
                    <td>{r.paramsLabel}</td>
                    <td>{r.recall.toFixed(1)}</td>
                    <td>{r.encoded.toFixed(1)}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>

          <p class="vs-bench-note">
            The learned channel alone, at a tenth of the size of the model ahead of it. First on re-encoded
            audio, which is what every file meets passing through a platform.
          </p>
        </figure>
        <p class="vs-frozen-cta">
          <a class="vs-cta-quiet" href="/vibeset/choon">All nine models ↳</a>
          <a class="vs-cta-quiet" href="/notes/choon">Where it fails ↳</a>
        </p>
      </div>
    </article>

    <Substrate />
  </div>
</section>

<style lang="scss">
  .vs {
    background: transparent;
    padding: var(--space-3xl) 0;
  }

  .vs-inner {
    margin: 0 auto;
    padding: 0 var(--space-l);
    max-width: 1200px;
  }

  .vs-head {
    margin-bottom: var(--space-2xl);
    max-width: 720px;
  }

  .vs-title {
    margin: var(--space-xs) 0 var(--space-s);
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    letter-spacing: -0.015em;
    line-height: 1.02;
  }

  .vs-lede {
    margin: 0;
    color: var(--ink-soft);
    font-size: 1.05rem;
    line-height: 1.65;
  }

  /* ── Stations ───────────────────────────────────────────────────────── */
  /* Grid children default to min-width:auto, so a long mono stat run refuses
     to shrink and pushes the page sideways at 320px. */
  .vs-station > * {
    min-width: 0;
  }

  .vs-stats {
    overflow-wrap: anywhere;
  }

  .vs-station {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    border-top: 1px solid var(--hairline-on-paper);
    padding: var(--space-2xl) 0;
  }

  .vs-eyebrow {
    margin: 0 0 var(--space-s);
  }

  .vs-eyebrow-stage {
    color: var(--crimson-text);
    font-weight: 500;
  }

  .vs-name a {
    color: inherit;
    text-decoration: none;

    &:hover {
      color: var(--crimson-text);
    }
  }

  .vs-name {
    margin: 0 0 var(--space-s);
    font-size: clamp(1.4rem, 2.4vw, 1.9rem);
    letter-spacing: -0.01em;
    line-height: 1.15;
  }

  .vs-desc {
    margin: 0 0 var(--space-m);
    color: var(--ink-soft);
    font-size: 0.98rem;
    line-height: 1.7;
  }

  .vs-stats {
    margin: 0 0 var(--space-m);
    color: var(--ink-soft);
  }

  .vs-stat-dot {
    color: var(--marigold);
  }

  .vs-ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-s);
    margin: 0;
  }


  .vs-cta-quiet {
    color: var(--crimson-text);
    font-size: 0.9rem;

    &:hover {
      color: var(--crimson);
    }
  }

  .vs-demo-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 var(--space-s);
  }

  /* ── Cue screenshots ────────────────────────────────────────────────── */
  .vs-shots {
    display: block;
    position: relative;
    transition: transform 0.22s var(--ease-out);
    padding-bottom: 14%;

    img {
      display: block;
      box-shadow: 0 24px 56px rgba(0, 0, 0, 0.5);
      border: 1px solid var(--hairline-on-paper);
      border-radius: 12px;
      width: 82%;
      height: auto;
    }

    .vs-shot-back {
      position: absolute;
      right: 0;
      bottom: 0;
      z-index: -1;
      width: 62%;
      opacity: 0.92;
    }

    &:hover {
      transform: translateY(-2px);
    }
  }

  /* ── Responsive ─────────────────────────────────────────────────────── */
  @media (max-width: 1023px) {
    .vs-station {
      grid-template-columns: 1fr;
      gap: var(--space-l);
    }
  }

  @media (max-width: 479px) {
    .vs-inner {
      padding: 0 var(--space-m);
    }
  }

  /* ── Frozen Choon result ────────────────────────────────────────────────
     A real run from the eval harness, shown still. Badged `replay` because
     that is what it is — recorded output, not an invented one. */
  .vs-frozen {
    margin: 0;
    border: 1px solid var(--hairline-on-ink);
    border-radius: var(--radius-large);
    background: var(--card-background);
    overflow: hidden;
  }

  .vs-frozen-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--border-color-subtle);
    padding: 0.6rem 0.9rem;
  }

  .vs-frozen-badge {
    border-radius: var(--radius-pill);
    background: rgba(76, 168, 162, 0.16);
    padding: 0.12rem 0.5rem;
    color: var(--glacier-text);
  }

  .vs-frozen-input {
    color: var(--paper-soft);
    opacity: 0.8;
  }

  .vs-frozen-body {
    padding: var(--space-s) 0.9rem 0.9rem;
  }

  .vs-frozen-verdict {
    margin: 0;
    color: var(--glacier-text);
    font-weight: 500;
    font-size: 0.7rem;
    letter-spacing: var(--tracking-label);
    font-family: var(--font-mono);
    text-transform: uppercase;
  }

  .vs-frozen-track {
    margin: 0.2rem 0 var(--space-s);
    color: var(--paper);
    font-weight: 600;
    font-size: 1.15rem;
    font-family: var(--font-display);
    letter-spacing: -0.01em;
  }

  /* 1px gap on a hairline ground — the gap is the rule, so there are no
     borders to keep in sync. */
  .vs-frozen-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(90px, 1fr));
    gap: 1px;
    margin: 0 0 var(--space-s);
    border: 1px solid var(--hairline-on-ink);
    border-radius: var(--radius-small);
    background: var(--hairline-on-ink);
    overflow: hidden;

    > div {
      background: var(--ink);
      padding: 0.5rem 0.6rem;
    }

    dt {
      margin: 0;
      color: var(--paper-soft);
      font-size: 0.6rem;
      letter-spacing: 0.1em;
    }

    dd {
      margin: 0.15rem 0 0;
      color: var(--paper);
      font-weight: 600;
      font-size: 1.05rem;
      font-family: var(--font-display);
      font-variant-numeric: tabular-nums;
      letter-spacing: -0.02em;
    }
  }

  /* ── Landing-page benchmark ─────────────────────────────────────────── */
  .vs-bench {
    margin: 0;
    border: 1px solid var(--hairline-on-ink);
    border-radius: var(--radius-large);
    background: var(--card-background);
    overflow: hidden;
  }

  .vs-bench-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--border-color-subtle);
    padding: 0.6rem 0.9rem;
  }

  /* 1px gap on a hairline ground — the gap is the rule, so there is nothing to
     keep in sync. Same trick as the full table on the product page. */
  .vs-bench-table {
    border-spacing: 1px;
    background: var(--hairline-on-ink);
    width: 100%;
    border-collapse: separate;
    text-align: left;

    th,
    td {
      background: var(--card-background);
      padding: 0.45rem 0.7rem;
    }

    thead th {
      color: var(--paper-soft);
      font-weight: 500;
      font-size: 0.58rem;
      letter-spacing: 0.09em;
      font-family: var(--font-mono);
      text-transform: uppercase;
      white-space: nowrap;
    }

    tbody th {
      color: var(--paper-soft);
      font-weight: 400;
      font-size: 0.85rem;
      white-space: nowrap;
    }

    td {
      color: var(--paper-soft);
      font-size: 0.82rem;
      font-family: var(--font-mono);
      font-variant-numeric: tabular-nums;
      white-space: nowrap;
    }
  }

  .vs-bench-note {
    margin: 0;
    padding: 0.7rem 0.9rem 0.85rem;
    color: var(--paper-soft);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  /* Our row, and the only place this panel spends colour. The other three are
     the baseline it is measured against, so they stay neutral. */
  .vs-bench-ours {
    th,
    td {
      background: var(--ink-2);
      color: var(--paper);
      font-weight: 600;
    }

    th {
      position: relative;

      &::after {
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        background: var(--grad-signal);
        width: 2px;
        content: '';
      }
    }
  }

  .vs-frozen-note {
    margin: 0;
    color: var(--paper-soft);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .vs-frozen-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.2rem;
    margin: var(--space-s) 0 0;
  }
</style>
