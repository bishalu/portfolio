---
/**
 * The substrate, drawn.
 *
 * This replaces a capability × product table. The table was accurate but it
 * read as a spreadsheet, and worse, it flattened the one thing worth showing:
 * that these capabilities fan out unevenly. "Train and compress" reaches
 * exactly one product. "Retrieve" and "Serve and prove" reach all three.
 * A grid of dots gives every cell the same visual weight, so the fan-out —
 * the actual argument — is something you have to reconstruct by reading rows.
 * Edges show it without being read.
 *
 * The signature is that single thread from "Train and compress" to Choon,
 * sitting in the middle of a bundle that goes everywhere. One-to-one against
 * one-to-many, in the same picture, at a glance.
 *
 * Not a Sankey and not a force graph. Both are the template answer for
 * "relationships between two sets", both need a library, and a force layout
 * would move the nodes on every load — the shape here is fixed because the
 * shape is the content. Sixteen hand-placed beziers, no dependency.
 *
 * Colour: --grad-signal runs left to right, substrate into product, which is
 * the same direction the hero's oscilloscope reads and the same gradient the
 * spike-train rail uses. It is a stroke, never a fill (DESIGN.md P5).
 *
 * Motion: none ambient. MOTION.md P8 allows two loops per viewport and both
 * are spoken for. The only movement is a 180ms opacity change when a lens is
 * chosen, which is interaction, not atmosphere.
 *
 * The SVG is aria-hidden and a real table carries the same data to screen
 * readers. A diagram that cannot be read aloud is a diagram that excludes
 * people; duplicating it in markup costs nothing and the table is authored
 * from the same array, so the two cannot drift.
 */
import { CAPABILITIES, PRODUCTS, WEIGHT_LABEL } from '@/data/substrate'

// Fixed geometry. Six rows on the left, three on the right, in one viewBox so
// the whole thing scales as a unit rather than reflowing.
// Width is set by the content at both ends, not by taste. The longest gloss —
// "inference under a deadline, eval harnesses, cost governance" — is 58
// characters of mono, needing 365 units left of the node at 10.5px. The longest
// product name needs about 90 to the right. 1010 left 160 units of nothing on
// the right, which read as the whole composition sitting off-centre.
// The frame is cropped to the drawing, measured rather than guessed: getBBox
// across every text, node and edge puts the ink at 39.6 → 799.8, centre 419.7.
// A frame starting at zero centred at 431 and pulled the picture 11 units left
// of the header above it — invisible alone, obvious once the section is centred
// on one spine. 30 → 810 puts the frame centre on the ink centre exactly, with
// ~10 units of air at each end.
const VB = { x: 30, w: 780, h: 400 }
const CAP_X = 430
const PROD_X = 700
const capY = (i: number) => 34 + i * 66
const prodY = (i: number) => 100 + i * 99

const WIDTH = { lean: 2.2, use: 1.1, none: 0 }
const IDLE = { lean: 0.42, use: 0.2, none: 0 }

/**
 * Bundled, not direct.
 *
 * Sixteen independent curves across the same gap cross each other everywhere
 * and you cannot follow a single one — the idle state read as a scribble, and
 * "use the filter" is not an answer to a picture that is illegible before you
 * touch it. So every edge is routed through a waist: it leaves its capability,
 * converges toward the vertical middle with the others, and fans back out to
 * its product. Crossings collapse into one braid.
 *
 * The bundling is also true. These are not sixteen private wires; they are one
 * shared substrate that three products draw from, and a braid says that where
 * sixteen straight lines said the opposite.
 *
 * 0.6 is how hard each edge is pulled toward centre. Lower and the tangle comes
 * back; higher and every edge collapses onto the same line, which reads as one
 * thick rope and loses the count.
 */
const WAIST_X = 565
const CENTER_Y = 200
const PULL = 0.6

const edges = CAPABILITIES.flatMap((c, ci) =>
  c.w
    .map((weight, pi) => ({ weight, cap: c, ci, prod: PRODUCTS[pi], pi }))
    .filter((e) => e.weight !== 'none')
    .map((e) => {
      const a = capY(e.ci)
      const b = prodY(e.pi)
      const waist = (a + b) / 2 + (CENTER_Y - (a + b) / 2) * PULL
      return {
        ...e,
        d:
          `M${CAP_X} ${a} C${CAP_X + 70} ${a} ${WAIST_X - 55} ${waist} ${WAIST_X} ${waist}` +
          ` C${WAIST_X + 55} ${waist} ${PROD_X - 70} ${b} ${PROD_X} ${b}`,
      }
    }),
)
---

<section class="sb" aria-labelledby="sb-title">
  <header class="sb-head">
    <p class="label-mono sb-eyebrow">Underneath</p>
    <h2 class="sb-title" id="sb-title">Six capabilities, arranged three ways. None of them specific to music.</h2>
  </header>

  <div class="sb-stage" id="sb-stage" data-reveal>
    <!-- Not aria-hidden any more: the product nodes are real controls now, and
         a hidden subtree may not contain focusable children. The decorative
         parts — every edge, every capability label — carry aria-hidden
         individually, and the table below still reads the whole thing out. -->
    <svg class="sb-svg" viewBox={`${VB.x} 0 ${VB.w} ${VB.h}`}>
      <defs>
        <linearGradient id="sb-flow" x1={CAP_X} y1="0" x2={PROD_X} y2="0" gradientUnits="userSpaceOnUse">
          <stop offset="0" stop-color="#d64553"></stop>
          <stop offset="1" stop-color="#efa33b"></stop>
        </linearGradient>
      </defs>

      {
        edges.map((e) => (
          <path
            class:list={['sb-edge', `is-${e.cap.id}`, `to-${e.prod.id}`]}
            d={e.d}
            stroke-width={WIDTH[e.weight]}
            pathLength="1"
            aria-hidden="true"
            data-draw
            style={`--o:${IDLE[e.weight]};--reveal-delay:${e.ci * 55}ms`}
          />
        ))
      }

      <g class="sb-pulses" aria-hidden="true"></g>

      {
        CAPABILITIES.map((c, i) => (
          <g
            class:list={[
              'sb-cap',
              `is-${c.id}`,
              ...c.w.map((weight, pi) => weight !== 'none' && `has-${PRODUCTS[pi].id}`),
            ]}
            aria-hidden="true"
          >
            <text class="sb-cap-name" x={CAP_X - 22} y={capY(i) - 2} text-anchor="end">
              {c.name}
            </text>
            <text class="sb-cap-gloss" x={CAP_X - 22} y={capY(i) + 15} text-anchor="end">
              {c.gloss}
            </text>
            <circle class="sb-node" cx={CAP_X} cy={capY(i)} r="4.5" />
          </g>
        ))
      }

      {
        PRODUCTS.map((p, i) => (
          <g
            class:list={['sb-prod', `to-${p.id}`]}
            role="button"
            tabindex="0"
            aria-pressed="false"
            data-lens={p.id}
          >
            <title>{`Show what ${p.name} draws on`}</title>
            <rect class="sb-hit" x={PROD_X - 16} y={prodY(i) - 20} width="180" height="40" rx="8" />
            <circle class="sb-node sb-node-prod" cx={PROD_X} cy={prodY(i)} r="6" />
            <text class="sb-prod-name" x={PROD_X + 22} y={prodY(i) + 7}>
              {p.name}
            </text>
          </g>
        ))
      }
    </svg>
  </div>

  <!-- The control, and the mobile reading of the same data. Buttons rather
       than hover targets on the SVG: hover is not available on a phone and a
       <circle> is not focusable. -->
  <!-- Shown at every width. These were briefly narrow-screen-only, on the
       argument that the diagram already names the products and the nodes are
       clickable — which was tidy and wrong. A control nobody can find is not a
       control, and the nodes give no hint that they are pressable. The buttons
       are the affordance; the nodes are the shortcut for anyone who works it
       out. -->
  <div class="sb-lens" role="group" aria-label="Filter by product">
    {
      PRODUCTS.map((p) => (
        <button type="button" class="sb-lens-btn label-mono" data-lens={p.id} aria-pressed="false">
          {p.name}
        </button>
      ))
    }
  </div>

  <ul class="sb-compact">
    {
      CAPABILITIES.map((c) => (
        <li class:list={['sb-crow', `is-${c.id}`]}>
          <p class="sb-crow-name">{c.name}</p>
          <p class="sb-crow-gloss">{c.gloss}</p>
          <p class="sb-crow-marks">
            {c.w.map((weight, pi) => (
              <span class:list={['sb-mark', `w-${weight}`, `to-${PRODUCTS[pi].id}`]}>
                <span class="sb-mark-dot" aria-hidden="true" />
                {PRODUCTS[pi].name}
              </span>
            ))}
          </p>
        </li>
      ))
    }
  </ul>

  <!-- The wrapper carries .sr-only, not the table: a <table> ignores
       inline-size: 1px because its min-content width wins, so the hidden copy
       was 360px wide and pushed the page sideways by 40px at 320. A div shrinks
       and clips it. -->
  <div class="sr-only">
    <table>
      <caption>Which capabilities each product draws on</caption>
      <thead>
        <tr>
          <th scope="col">Capability</th>
          {PRODUCTS.map((p) => <th scope="col">{p.name}</th>)}
        </tr>
      </thead>
      <tbody>
        {
          CAPABILITIES.map((c) => (
            <tr>
              <th scope="row">
                {c.name} — {c.gloss}
              </th>
              {c.w.map((weight) => (
                <td>{WEIGHT_LABEL[weight]}</td>
              ))}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</section>

<style lang="scss">
  .sb {
    border-top: 1px solid var(--hairline-on-paper);
    padding-top: var(--space-l);
  }

  /* Centred, and this is the only section on the site that is.
     The diagram's own composition is symmetric — a label column resolving to a
     hard edge, a span of curves, three nodes — so a left-ragged header sitting
     over it made the two disagree about where the page's spine was. Aligning
     the type to the drawing rather than the drawing to the type is the smaller
     change and the better-looking one: it reads as an exhibit, which is what it
     is. Everything else on the page stays left. */
  .sb-head {
    margin: 0 auto var(--space-l);
    max-width: 46rem;
    text-align: center;
  }

  .sb-eyebrow {
    margin: 0 0 var(--space-xs);
    color: var(--paper-soft);
  }

  .sb-title {
    margin: 0;
    text-wrap: balance;
    font-size: clamp(1.4rem, 2.4vw, 1.9rem);
    line-height: 1.15;
    letter-spacing: -0.015em;
  }


  .sb-stage {
    margin: 0 auto;
    max-width: 58rem;
  }

  .sb-svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  /* Every edge is a stroke of the signal gradient, running substrate → product.
     Weight is stroke width; presence is opacity. There is no edge at all where
     a product does not use a capability, which is why "Train and compress" has
     one line leaving it and "Retrieve" has three. */
  .sb-edge {
    fill: none;
    stroke: url(#sb-flow);
    stroke-linecap: round;
    opacity: var(--o);
    /* Slower than the 180ms it was: a snap between states reads as a flicker
       when sixteen elements do it at once. */
    transition: opacity 0.34s var(--ease-out);
  }

  /* A 14% segment of the path, so what moves is a charge rather than the line
     being drawn. Sits above its edge and inherits nothing from it. */
  .sb-pulse {
    fill: none;
    stroke: var(--marigold);
    stroke-linecap: round;
    stroke-dasharray: 0.14 1;
    pointer-events: none;
  }

  .sb-node {
    fill: var(--paper-soft);
    opacity: 0.55;
    transition:
      fill 0.18s var(--ease-out),
      opacity 0.18s var(--ease-out);
  }

  .sb-node-prod {
    fill: var(--paper);
    opacity: 0.9;
  }

  /* The whole product row is the target, not the 12px dot — WCAG 2.2 AA 2.5.8
     wants 24px and a circle that small is a dare, not a control. */
  .sb-prod {
    cursor: pointer;

    .sb-hit {
      fill: transparent;
    }

    &:hover .sb-prod-name,
    &[aria-pressed='true'] .sb-prod-name {
      fill: var(--marigold);
    }

    &:focus-visible {
      outline: none;

      .sb-hit {
        stroke: var(--crimson);
        stroke-width: 2;
      }
    }
  }

  .sb-cap-name {
    fill: var(--paper);
    font-size: 15px;
    font-family: var(--font-body);
  }

  .sb-cap-gloss {
    fill: var(--paper-soft);
    font-size: 10.5px;
    letter-spacing: 0.02em;
    font-family: var(--font-mono);
  }

  .sb-prod-name {
    fill: var(--paper);
    font-weight: 600;
    font-size: 19px;
    letter-spacing: -0.01em;
    font-family: var(--font-display);
  }

  /* ── Lensing ─────────────────────────────────────────────────────────────
     Choosing a product drops everything that is not its own to a trace, so the
     shape of that one product's dependency is readable on its own. The dropped
     edges stay visible rather than disappearing — the comparison is the point,
     and an edge at 6% still says "there is more here". */
  .sb[data-lens] {
    .sb-edge {
      opacity: 0.06;
    }

    .sb-cap-name,
    .sb-prod-name {
      opacity: 0.28;
    }

    .sb-cap-gloss {
      opacity: 0.15;
    }

    .sb-node {
      opacity: 0.18;
    }
  }

  @each $p in curation, cue, choon {
    .sb[data-lens='#{$p}'] {
      .sb-edge.to-#{$p} {
        opacity: 1;
      }

      .sb-prod.to-#{$p} {
        .sb-prod-name,
        .sb-node {
          opacity: 1;
        }
      }

      /* The capabilities that product actually reaches come back up with it.
         Dimming the whole left column would hide the answer to the question the
         button just asked. */
      .sb-cap.has-#{$p} {
        .sb-cap-name,
        .sb-node {
          opacity: 1;
        }

        .sb-cap-gloss {
          opacity: 0.75;
        }
      }
    }
  }

  .sb-lens {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-top: var(--space-m);
  }

  .sb-lens-btn {
    transition:
      border-color 0.18s var(--ease-out),
      color 0.18s var(--ease-out),
      transform 0.18s var(--ease-out);
    border: 1px solid var(--hairline-on-paper);
    border-radius: var(--radius-pill);
    background: transparent;
    cursor: pointer;
    padding: 0.4rem 0.9rem;
    min-height: var(--target-size-min, 24px);
    color: var(--paper-soft);

    &:hover {
      transform: translateY(-1px);
      border-color: var(--paper-soft);
      color: var(--paper);
    }

    /* A border colour alone was not findable at a glance against two unpressed
       siblings. The filled ground is what makes the current state readable
       without hunting — the one place this section spends a fill. */
    &[aria-pressed='true'] {
      border-color: var(--marigold);
      background: rgba(239, 163, 59, 0.14);
      color: var(--paper);
    }
  }

  .sb-note {
    margin: var(--space-m) 0 0;
    max-width: 42rem;
    color: var(--paper-soft);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  /* ── The narrow reading ──────────────────────────────────────────────────
     Below 720px there is no room for two columns and a span of curves between
     them, and a diagram squeezed until its labels collide is worse than no
     diagram. The same data becomes six rows, each naming which products lean
     on it — which keeps the fan-out legible, because a row with one product
     under it looks different from a row with three. */
  .sb-compact {
    display: none;
    margin: var(--space-m) 0 0;
    padding: 0;
    list-style: none;
  }

  .sb-crow {
    border-top: 1px solid var(--hairline-on-ink);
    padding: 0.7rem 0;
  }

  .sb-crow-name {
    margin: 0;
    color: var(--paper);
    font-weight: 500;
    font-size: 0.92rem;
  }

  .sb-crow-gloss {
    margin: 0.1rem 0 0.45rem;
    color: var(--paper-soft);
    font-size: 0.74rem;
    line-height: 1.4;
  }

  .sb-crow-marks {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.8rem;
    margin: 0;
  }

  .sb-mark {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--paper-soft);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    font-family: var(--font-mono);
    text-transform: uppercase;
  }

  .sb-mark-dot {
    display: inline-block;
    border-radius: 50%;
    width: 8px;
    height: 8px;
  }

  .w-lean {
    color: var(--paper);

    .sb-mark-dot {
      background: var(--grad-signal);
    }
  }

  .w-use .sb-mark-dot {
    box-shadow: inset 0 0 0 1.5px var(--paper-soft);
    opacity: 0.7;
  }

  /* Not used, and said so rather than left out — an absence you can see is
     information, an absence you cannot is a gap in the table. */
  .w-none {
    opacity: 0.4;

    .sb-mark-dot {
      background: var(--paper-soft);
      width: 8px;
      height: 1.5px;
      opacity: 0.5;
    }
  }

  .sb[data-lens] .sb-mark {
    opacity: 0.22;
  }

  @each $p in curation, cue, choon {
    .sb[data-lens='#{$p}'] .sb-mark.to-#{$p} {
      opacity: 1;
    }
  }

  @media (max-width: 719px) {
    .sb-stage {
      display: none;
    }

    .sb-compact {
      display: block;
    }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const root = document.querySelector<HTMLElement>('.sb')
    if (!root) return
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('.sb-lens-btn')]

    // Clicking the active lens clears it. There is no "All" button because the
    // cleared state is the default, and a button for the state you start in is
    // a button that does nothing the first time anyone presses it.
    const rm = window.matchMedia('(prefers-reduced-motion: reduce)').matches

    /* A charge travels each line. It does not redraw it.
       
       The first version animated stroke-dashoffset from 1 to 0 on every
       matching edge, which redraws the whole line — sixteen full lines at once
       when the lens was cleared, in 520ms. That is a flash across the entire
       diagram, and MOTION.md already refuses `flash-shadow` on exactly this
       ground. Nobody should have to brace for a filter button.

       What runs now is one short segment travelling from capability to product
       along a copy of the path, while the line underneath stays put. Three
       things keep it calm:

         · only the edges that just lit animate — at most six, never sixteen
         · they fire in sequence, 130ms apart, so two or three are ever moving
         · clearing the lens animates nothing, because nothing is being
           revealed; the opacity transition alone carries it back

       Each pulse removes itself on finish, so the layer is empty at rest. */
    const layer = root.querySelector<SVGGElement>('.sb-pulses')

    const pulse = (lens: string | null) => {
      if (rm || !lens || !layer) return
      layer.replaceChildren()
      const lit = [...root.querySelectorAll<SVGPathElement>(`.sb-edge.to-${lens}`)]
      lit.forEach((edge, i) => {
        const trace = edge.cloneNode() as SVGPathElement
        trace.removeAttribute('style')
        trace.setAttribute('class', 'sb-pulse')
        // Same weight as the edge it rides, not heavier. A thicker bright bar
        // is a bigger luminance change over a bigger area, which is the thing
        // that actually makes motion uncomfortable.
        trace.setAttribute('stroke-width', edge.getAttribute('stroke-width') ?? '2')
        layer.appendChild(trace)
        const anim = trace.animate(
          [
            { strokeDashoffset: 1.14, opacity: 0 },
            { strokeDashoffset: 1.02, opacity: 0.9, offset: 0.12 },
            { strokeDashoffset: 0.12, opacity: 0.9, offset: 0.88 },
            { strokeDashoffset: 0, opacity: 0 },
          ],
          {
            // Constant speed, and it fades in and out at the ends. An eased
            // arrival snaps, and a segment that pops out of existence at the
            // node reads as a blink.
            // 280ms apart against a 1000ms flight means about four segments are
            // ever in motion, out of six. Tighter than that and they read as one
            // event again; looser and the sequence outstays the state change it
            // is decorating. The opacity swap lands in 340ms regardless, so the
            // filter answers immediately and the charges finish behind it.
            duration: 1000,
            delay: i * 280,
            easing: 'linear',
            fill: 'both',
          },
        )
        anim.onfinish = () => trace.remove()
      })
    }

    const apply = (lens: string | null) => {
      if (lens) root.dataset.lens = lens
      else delete root.dataset.lens
      const mark = (el: Element) => el.setAttribute('aria-pressed', String((el as HTMLElement).dataset.lens === lens))
      buttons.forEach(mark)
      root.querySelectorAll('.sb-prod').forEach(mark)
      pulse(lens)
    }

    buttons.forEach((b) =>
      b.addEventListener('click', () => apply(root.dataset.lens === b.dataset.lens ? null : b.dataset.lens!)),
    )

    // Product nodes are the desktop control. role="button" needs its keyboard
    // half written by hand — Enter and Space, the two keys a real button answers.
    root.querySelectorAll<SVGGElement>('.sb-prod').forEach((g) => {
      const pick = () => apply(root.dataset.lens === g.dataset.lens ? null : g.dataset.lens!)
      g.addEventListener('click', pick)
      g.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault()
          pick()
        }
      })
    })
  })
</script>
