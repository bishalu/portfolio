---
/**
 * Logo — always goes home.
 *
 * Was href="#hero", a bare fragment, so on every page other than the landing
 * one it resolved to /that-page#hero, found nothing, and did nothing. Now it
 * points at the site root; already there, it rides back to the top.
 */
---

<a href="/" class="logo-link" aria-label="bishal.ai — home">
  <span class="logo-text">bishal<span>.ai</span></span>
</a>

<script>
  document.addEventListener('astro:page-load', () => {
    const logo = document.querySelector<HTMLAnchorElement>('.logo-link')
    if (!logo) return
    logo.addEventListener('click', (e) => {
      if (window.location.pathname !== '/') return
      e.preventDefault()
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches
      window.scrollTo({ top: 0, behavior: reduced ? 'auto' : 'smooth' })
      history.pushState(null, '', '/')
    })
  })
</script>

<style>
  .logo-link {
    display: flex;
    align-items: center;
    /* WCAG 2.5.8: 24px minimum for a standalone target. */
    min-height: 24px;
    text-decoration: none;
    transition: transform 0.2s ease;

    &:hover {
      transform: scale(1.02);
      text-decoration: none;
    }
  }

  .logo-text {
    font-weight: 700;
    font-size: 1.5rem;
    font-family: var(--font-display);
    color: var(--paper);
    letter-spacing: -0.03em;
    line-height: 1;
    display: flex;
    align-items: baseline;
    text-transform: none;

    span {
      color: var(--marigold);
    }
  }

  // Mobile optimization
  @media (max-width: 768px) {
    .logo-text {
      font-size: 1.25rem;
    }
  }
</style>
