---
/**
 * RangeStrip — proof of breadth, deliberately quiet (docs/design/DESIGN.md §2).
 *
 * One line, not three cards. By this point in the page range has already been
 * proven twice (products shipped, papers published); a third proof in a weaker
 * format was the sag, and three bordered cards straight after three bordered
 * stations made it the page's third consecutive triad.
 *
 * Everything named here has source you can read. The old "production
 * discipline" card had no link, which broke the section's own premise — those
 * keywords live on /about instead.
 */
const sources = [
  { label: 'Golo', href: 'https://github.com/bishalu/veer' },
  { label: 'KTM Capital', href: 'https://github.com/bishalu/ktm_capital' },
]
---

<section class="rs" aria-labelledby="rs-title">
  <div class="rs-inner">
    <h2 class="rs-title label-mono" id="rs-title" data-reveal>Beyond music</h2>

    <p class="rs-line" data-reveal>
      <strong>Golo</strong> turns two minutes of speech into a structured profile. <strong>KTM
      Capital</strong> trades on news sentiment inside hard risk limits — the guardrails are the
      interesting part, not the returns.
    </p>

    <p class="rs-sources label-mono" data-reveal>
      {
        sources.map((s, i) => (
          <>
            {i > 0 && <span class="rs-sep" aria-hidden="true"> · </span>}
            <a href={s.href} target="_blank" rel="noopener noreferrer">
              {s.label} ↳
            </a>
          </>
        ))
      }
    </p>
  </div>
</section>

<style lang="scss">
  .rs {
    background: transparent;
    padding: 0 0 var(--space-3xl);
  }

  .rs-inner {
    margin: 0 auto;
    border-top: 1px solid var(--hairline-on-ink);
    padding: var(--space-2xl) var(--space-l) 0;
    max-width: 780px;
  }

  .rs-title {
    margin: 0 0 var(--space-s);
    color: var(--crimson-text);
  }

  .rs-line {
    margin: 0 0 var(--space-s);
    color: var(--paper-soft);
    font-size: 1.02rem;
    line-height: 1.7;

    strong {
      color: var(--paper);
      font-weight: 600;
    }
  }

  .rs-sources {
    margin: 0;

    a {
      color: var(--paper-soft);

      &:hover {
        color: var(--marigold);
      }
    }
  }

  .rs-sep {
    color: var(--paper-soft);
    opacity: 0.5;
  }

  @media (max-width: 479px) {
    .rs-inner {
      padding-inline: var(--space-m);
    }
  }
</style>
