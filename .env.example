# Copy this file to .env and fill in your real values.
# DO NOT commit .env — it is gitignored, keep it that way.
#
# The site builds and runs with none of these set. Each one lights up an
# optional surface; when it's missing, that surface degrades honestly rather
# than breaking (replay fixtures, server-rendered fallbacks, skipped warm-ups).

# ── Balgo (the hero chat console) ──────────────────────────────────────────
# AWS Bedrock. Custom-prefixed because Lambda strips inbound AWS_* env vars.
# Unset → POST /api/chat returns an error and the console says so.
BALGO_AWS_KEY_ID=
BALGO_AWS_SECRET=
BALGO_AWS_REGION=us-east-2
BALGO_MODEL_ID=openai.gpt-oss-120b-1:0

# ── Vibeset demo proxy (the "Find the vibe" widget) ────────────────────────
# Base URL of the Vibeset search API. Deliberately NOT committed: this repo is
# public. Unset → /api/vibeset-demo serves replay fixtures and badges them.
VIBESET_API_BASE=

# ── Choon matcher (the stress test on /vibeset/choon) ──────────────────────
# The public Choon gateway. It runs inside GCP and authenticates to the private
# matcher with the metadata server, so no credential is needed here — and none
# is possible: service-account keys are disabled org-wide.
# Deliberately not committed; this repo is public.
# Unset → /api/choon-identify serves recorded results badged REPLAY.
CHOON_API_BASE=

# ── LMArena watcher (the live-signals ticker) ──────────────────────────────
# Netlify Blobs store for leaderboard state. Unset → /api/live-signals returns
# nulls and the strip keeps its server-rendered fallback text.
NETLIFY_BLOBS_SITE_ID=
NETLIFY_BLOBS_TOKEN=
# Slack alerts when the #1 model changes. Unset → no notifications.
SLACK_WEBHOOK_URL=
# Set to any value to exercise the watcher's simulated-change path locally.
SIMULATE_KEY=

# ── /naam moderation ───────────────────────────────────────────────────────
# HMAC key for the one-click approve link in the suggestion notification.
# The link is HMAC-SHA256(record id, this secret), so a leaked link approves
# exactly one record. Unset → /api/naam-submit sends no approve link and
# /api/naam-approve refuses every request, so the wall simply stays as it is:
# suggestions still arrive by email and are still written to Blobs, they just
# cannot be published until this is set.
#
# GENERATE IT, DO NOT CHOOSE IT:  openssl rand -hex 32
# Approve links travel by email in cleartext and are also stored in Netlify's
# form-submission dashboard, so one leaked link hands an attacker a known
# (id, token) pair. Against a guessable secret that pair is an offline oracle,
# and recovering the secret makes every record approvable. Against 256 bits it
# is nothing. Tokens do not expire, which is why the entropy has to carry it.
NAAM_ADMIN_SECRET=

# ── /naam notifications ────────────────────────────────────────────────────
# Where a new suggestion goes. Both are optional and both can be on; email is
# preferred and Slack stays as the fallback so there is never a silent gap.
#
# NOT Netlify Forms. Forms intercepts POSTs at the edge, but this site is
# output:'server' and the adapter claims path '/*' with preferStatic — and
# preferStatic only covers GET, because Netlify's static handler does not answer
# POST. So every form POST lands in the SSR function and Forms never sees it.
# Verified against production on four paths; the site has zero submissions on
# record since launch, which is the same bug eating the contact form.
#
# Unset both → the suggestion is still stored in Blobs and still approvable, you
# just are not told it arrived.
RESEND_API_KEY=
NAAM_NOTIFY_EMAIL=
# Optional. Defaults to Resend's shared sender, which reaches your own account
# address without domain verification. Set once a domain is verified.
NAAM_MAIL_FROM=

# ── /naam origin ───────────────────────────────────────────────────────────
# Where the endpoints fetch the dataset from and what the approve link points
# at. Never derived from the request: the Host header would otherwise decide
# what "the document" is and where the approve token gets posted.
# Resolution order is NAAM_ORIGIN → Netlify's own URL → astro.config.mjs `site`,
# so this only needs setting under plain `astro dev`, where it should point at
# the dev server so the page uses the dataset you just built.
#   NAAM_ORIGIN=http://localhost:4321
NAAM_ORIGIN=
